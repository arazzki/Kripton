import { Theme, ShelfView } from "../theme.slint";
import {
    IconPrev,
    IconNext,
    IconFolderLarge,
    IconFileLarge,
    IconClose,
} from "../icons.slint";

component ShelfNavArrow inherits Rectangle {
    in property <bool> enabled: false;
    in property <bool> is-next: false;
    callback clicked();

    width: 20px;
    background: transparent;

    private property <length> btn-h: nav-touch.pressed && root.enabled ? 24px : 26px;

    Rectangle {
        width: 20px;
        height: root.btn-h;
        y: (parent.height - self.height) / 2;
        border-radius: 10px;
        background: root.enabled
            ? (nav-touch.pressed ? Theme.glass-pill-press : (nav-touch.has-hover ? Theme.glass-pill-hover : Theme.glass-pill))
            : Theme.glass-card;
        border-width: 1px;
        border-color: (root.enabled && nav-touch.has-hover) ? Theme.glass-rim : Theme.glass-rim-subtle;
        opacity: root.enabled ? 1.0 : 0.30;

        animate height, y, background, border-color, opacity {
            duration: 160ms;
            easing: ease-out;
        }

        if !root.is-next: IconPrev {
            width: 11px;
            height: 11px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: root.enabled ? (nav-touch.has-hover ? Theme.ink : Theme.ink-2) : Theme.ink-dim;
        }

        if root.is-next: IconNext {
            width: 11px;
            height: 11px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: root.enabled ? (nav-touch.has-hover ? Theme.ink : Theme.ink-2) : Theme.ink-dim;
        }
    }

    nav-touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component ShelfPage inherits Rectangle {
    in property <[ShelfView]> shelf-items: [];
    in property <int> shelf-start: 0;
    in property <int> shelf-total: 0;
    in property <bool> shelf-can-prev: false;
    in property <bool> shelf-can-next: false;
    in property <bool> shelf-drag-active: false;
    in property <float> shelf-fade: 1.0;
    in property <string> shelf-summary: "No items yet";

    callback shelf-nav(int);
    callback shelf-clear();
    callback shelf-open(int);
    callback shelf-remove(int);

    preferred-width: 452px;
    preferred-height: 104px;
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;

        // Top header (18px): plain muted summary text + Clear white glass pill
        HorizontalLayout {
            height: 18px;
            padding-left: 4px;
            padding-right: 4px;
            spacing: 8px;

            Text {
                text: root.shelf-summary;
                color: #FFFFFF80;
                font-size: 10.5px;
                font-weight: 500;
                vertical-alignment: center;
                overflow: TextOverflow.elide;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            Rectangle {
                width: 44px;
                height: 18px;
                border-radius: 9px;
                background: (clear-touch.pressed && root.shelf-total > 0)
                    ? Theme.danger.with-alpha(0.32)
                    : ((clear-touch.has-hover && root.shelf-total > 0) ? Theme.danger-soft : Theme.glass-pill);
                border-width: 1px;
                border-color: (clear-touch.has-hover && root.shelf-total > 0)
                    ? Theme.danger.with-alpha(0.55)
                    : Theme.glass-rim-subtle;
                opacity: root.shelf-total > 0 ? 1.0 : 0.36;

                animate background, border-color, opacity {
                    duration: 160ms;
                    easing: ease-out;
                }

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Clear";
                    color: (clear-touch.has-hover && root.shelf-total > 0) ? Theme.danger : Theme.ink-2;
                    font-size: 9.5px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;

                    animate color {
                        duration: 160ms;
                        easing: ease-out;
                    }
                }

                clear-touch := TouchArea {
                    mouse-cursor: root.shelf-total > 0 ? pointer : default;
                    clicked => {
                        if (root.shelf-total > 0) {
                            root.shelf-clear();
                        }
                    }
                }
            }
        }

        // Body (74px): Empty dropzone OR Populated horizontal shelf
        Rectangle {
            height: 74px;
            background: transparent;

            // Empty state: frosted white glass dropzone
            if root.shelf-total == 0: Rectangle {
                x: 2px;
                y: 0px;
                width: parent.width - 4px;
                height: parent.height;
                border-radius: 12px;
                background: root.shelf-drag-active ? #FFFFFF1E : #FFFFFF0A;
                border-width: root.shelf-drag-active ? 1.5px : 1px;
                border-color: root.shelf-drag-active ? #FFFFFF52 : #FFFFFF22;

                animate background, border-color {
                    duration: 180ms;
                    easing: ease-out;
                }

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    spacing: 2px;

                    IconFolderLarge {
                        width: 24px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        tint: root.shelf-drag-active ? #FFFFFF : Theme.ink-3;
                    }

                    Text {
                        text: root.shelf-drag-active ? "Release to add to Shelf" : "Drag files or folders here";
                        color: root.shelf-drag-active ? #FFFFFF : Theme.ink;
                        font-size: 11.5px;
                        font-weight: 600;
                        horizontal-alignment: center;

                        animate color {
                            duration: 160ms;
                            easing: ease-out;
                        }
                    }

                    Text {
                        text: "Click to open · Hover to remove";
                        color: Theme.ink-3;
                        font-size: 9.5px;
                        horizontal-alignment: center;
                    }
                }
            }

            // Populated state: 20px < / > arrows flanking 390px stage with up to 5 74x72 cards
            if root.shelf-total > 0: HorizontalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 3px;

                ShelfNavArrow {
                    enabled: root.shelf-can-prev;
                    is-next: false;
                    clicked => {
                        root.shelf-nav(-1);
                    }
                }

                // 390px card stage (5 * 74 + 4 * 4 = 386px <= 390px)
                Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;
                    border-radius: 12px;
                    background: root.shelf-drag-active ? #FFFFFF14 : transparent;
                    border-width: root.shelf-drag-active ? 1.5px : 0px;
                    border-color: root.shelf-drag-active ? #FFFFFF52 : transparent;

                    animate background, border-color {
                        duration: 180ms;
                        easing: ease-out;
                    }

                    HorizontalLayout {
                        width: parent.width;
                        height: 72px;
                        y: (parent.height - self.height) / 2;
                        alignment: center;
                        spacing: 4px;

                        for item in root.shelf-items: card-slot := Rectangle {
                            width: 74px;
                            height: 72px;
                            background: transparent;

                            private property <bool> hovered: item-touch.has-hover || rm-touch.has-hover;

                            // Visual frosted white card (subtle -1px lift on hover)
                            Rectangle {
                                x: 0px;
                                y: card-slot.hovered ? -1px : 0px;
                                width: parent.width;
                                height: parent.height;
                                border-radius: 10px;
                                background: item-touch.pressed
                                    ? Theme.glass-pill-press
                                    : (card-slot.hovered ? Theme.glass-card-hover : Theme.glass-card);
                                border-width: 1px;
                                border-color: card-slot.hovered ? Theme.glass-rim : Theme.glass-rim-subtle;
                                opacity: (item.missing ? 0.45 : 1.0) * root.shelf-fade;

                                animate y, background, border-color, opacity {
                                    duration: 160ms;
                                    easing: ease-out;
                                }

                                // 36x36 rounded thumbnail / icon stage
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    x: (parent.width - self.width) / 2;
                                    y: 6px;
                                    border-radius: 8px;
                                    background: Theme.glass-pill;
                                    border-width: 1px;
                                    border-color: card-slot.hovered ? Theme.glass-rim : Theme.glass-rim-subtle;
                                    clip: true;

                                    animate border-color {
                                        duration: 160ms;
                                        easing: ease-out;
                                    }

                                    if item.has-thumbnail && item.is-image: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: item.thumbnail;
                                        image-fit: cover;
                                    }

                                    if item.has-thumbnail && !item.is-image: Image {
                                        width: 26px;
                                        height: 26px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: item.thumbnail;
                                        image-fit: contain;
                                    }

                                    if !item.has-thumbnail && item.is-directory: IconFolderLarge {
                                        width: 22px;
                                        height: 18px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: #FFFFFFE6;
                                    }

                                    if !item.has-thumbnail && !item.is-directory: IconFileLarge {
                                        width: 17px;
                                        height: 21px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: Theme.ink-2;
                                    }
                                }

                                // Filename (9.5px)
                                Text {
                                    x: 4px;
                                    y: 43px;
                                    width: parent.width - 8px;
                                    height: 13px;
                                    text: item.name;
                                    color: Theme.ink;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: TextOverflow.elide;
                                }

                                // Size / folder / missing text (8.5px)
                                Text {
                                    x: 4px;
                                    y: 57px;
                                    width: parent.width - 8px;
                                    height: 12px;
                                    text: item.size-text;
                                    color: item.missing ? Theme.danger : Theme.ink-3;
                                    font-size: 8.5px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: TextOverflow.elide;
                                }

                                item-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.shelf-open(item.index);
                                    }
                                }

                                // Subtle frosted 15x15 remove pill
                                Rectangle {
                                    x: parent.width - 18px;
                                    y: 3px;
                                    width: 15px;
                                    height: 15px;
                                    border-radius: 7.5px;
                                    background: rm-touch.pressed
                                        ? Theme.danger
                                        : (rm-touch.has-hover ? Theme.danger.with-alpha(0.42) : #0A0A0CD0);
                                    border-width: 1px;
                                    border-color: rm-touch.pressed
                                        ? Theme.danger
                                        : (rm-touch.has-hover ? Theme.danger.with-alpha(0.75) : Theme.glass-rim);
                                    opacity: (item-touch.has-hover || rm-touch.has-hover) ? 1.0 : 0.0;

                                    animate opacity, background, border-color {
                                        duration: 160ms;
                                        easing: ease-out;
                                    }

                                    IconClose {
                                        width: 7px;
                                        height: 7px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: rm-touch.pressed
                                            ? Theme.on-accent
                                            : (rm-touch.has-hover ? Theme.ink : Theme.ink-2);
                                    }

                                    rm-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.shelf-remove(item.index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                ShelfNavArrow {
                    enabled: root.shelf-can-next;
                    is-next: true;
                    clicked => {
                        root.shelf-nav(1);
                    }
                }
            }
        }
    }
}
