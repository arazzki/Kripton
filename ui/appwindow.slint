// Kripton — Native Windows living notch shell.
// Monochrome White Transparent Glassmorphism shell integrating continuous
// concave-ear geometry, geometry-coupled crossfades, compact/HUD views, and 5 feature pages.

import { Theme, ShelfView, TodoView } from "theme.slint";
import {
    IconMusic,
    IconFocus,
    IconWater,
    IconShelf,
    IconTodo,
    IconChevron,
} from "icons.slint";
import { BatteryRing, AudioWave, PlasmaOrb } from "components.slint";
import { CompactView } from "compact.slint";
import { HardwareHudView } from "hud.slint";
import { MusicPage } from "pages/music.slint";
import { FocusPage } from "pages/focus.slint";
import { WaterPage } from "pages/water.slint";
import { ShelfPage } from "pages/shelf.slint";
import { TodoPage } from "pages/todo.slint";

export { ShelfView, TodoView }

export component AppWindow inherits Window {
    title: "Kripton";
    width: 540px;
    height: 204px;
    background: transparent;
    no-frame: true;

    default-font-family: "Segoe UI Variable Display";
    default-font-size: 12px;

    // --- Driven by Rust -----------------------------------------------------
    in property <length> notch-width: 128px;
    in property <length> notch-height: 4px;
    in property <bool> expanded: false;
    in property <bool> closed: false;
    in property <bool> stealth: true;
    in property <int> active-page: 0;
    in property <float> page-fade: 1.0;
    in property <int> page-direction: 1;
    in property <string> page-title: "Music";
    in property <string> page-subtitle: "";
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> build-label: "v1.0.0";
    in property <bool> lyrics-enabled: false;

    // Lyrics mode
    in property <string> lyrics-line-prev: "";
    in property <string> lyrics-line-curr: "Play a track to see lyrics";
    in property <string> lyrics-line-next: "";
    in property <bool> lyrics-available: false;
    in property <bool> lyrics-loading: false;
    in property <float> lyrics-line-fade: 1.0;
    in property <int> lyrics-revision: 0;
    in property <color> lyrics-glow-color: #1E3A8A;

    // Living mascot
    in property <image> mascot: @image-url("../assets/plasma_core.png");
    in property <image> corona: @image-url("../assets/plasma_corona.png");
    in property <image> aura: @image-url("../assets/plasma_aura.png");
    in property <float> orb-scale: 1.0;
    in property <float> orb-glow: 0.48;
    in property <length> orb-offset-x: 0px;
    in property <length> orb-offset-y: 0px;
    in property <float> aura-scale: 1.0;
    in property <float> aura-opacity: 0.48;
    in property <angle> corona-angle: 0deg;

    // Battery & audio spectrum
    in property <bool> battery-present: true;
    in property <bool> battery-on-ac: true;
    in property <float> battery-percent: 100.0;
    in property <bool> battery-charging: false;
    in property <float> battery-arc-x: 9.0;
    in property <float> battery-arc-y: 1.25;
    in property <bool> battery-arc-large: false;
    in property <bool> battery-arc-visible: false;
    in property <bool> battery-full: true;
    in property <float> wave-0: 0.0;
    in property <float> wave-1: 0.0;
    in property <float> wave-2: 0.0;
    in property <float> wave-3: 0.0;
    in property <float> wave-4: 0.0;

    // Music page
    in property <bool> media-available: false;
    in property <bool> media-playing: false;
    in property <string> track-title: "Nothing playing";
    in property <string> track-subtitle: "Start a track in any app";
    in property <string> media-source: "";
    in property <string> elapsed-text: "00:00";
    in property <string> remaining-text: "-00:00";
    in property <bool> has-album-art: false;
    in property <image> album-art: @image-url("../assets/plasma_core.png");
    in property <bool> seek-enabled: false;
    in property <bool> can-skip-previous: false;
    in property <bool> can-skip-next: false;
    in-out property <float> seek-fraction: 0.0;
    in-out property <bool> seek-dragging: false;

    // Shelf page
    in property <[ShelfView]> shelf-items: [];
    in property <int> shelf-start: 0;
    in property <int> shelf-total: 0;
    in property <bool> shelf-can-prev: false;
    in property <bool> shelf-can-next: false;
    in property <bool> shelf-drag-active: false;
    in property <float> shelf-fade: 1.0;
    in property <string> shelf-summary: "No items yet";

    // Focus page
    in property <int> focus-minutes: 25;
    in property <string> focus-remaining: "25:00";
    in property <float> focus-progress: 0.0;
    in property <bool> focus-running: false;
    in property <bool> focus-active: false;
    in property <bool> focus-celebrate: false;
    in property <string> focus-session: "Focus session #1";
    in property <int> focus-completed: 0;

    // Water page
    in property <int> water-current: 0;
    in property <int> water-goal: 2000;
    in property <float> water-progress: 0.0;
    in property <float> water-phase: 0.0;
    in property <string> water-summary: "0 / 2,000 ml";
    in property <string> water-percent: "0%";
    in property <bool> water-can-undo: false;
    in property <bool> water-nudge: false;

    // To-do page
    in property <[TodoView]> todo-items: [];
    in property <int> todo-total: 0;
    in property <int> todo-done: 0;
    in property <string> todo-summary: "No tasks yet";
    in-out property <string> todo-draft: "";
    in-out property <bool> todo-edit-active: false;

    // Hardware HUDs
    in property <bool> hud-visible: false;
    in property <bool> hud-device: true;
    in property <string> hud-title: "";
    in property <string> hud-status: "Connected";
    in property <bool> hud-connected: true;
    in property <bool> hud-charging: false;
    in property <string> hud-percent-text: "100%";

    callback toggle-expand();
    callback page-selected(int);
    callback quit();
    callback media-play-pause();
    callback media-previous();
    callback media-next();
    callback media-open-source();
    callback media-seek-start();
    callback media-seek-preview(float);
    callback media-seek-commit(float);
    callback lyrics-toggle();
    callback shelf-nav(int);
    callback shelf-clear();
    callback shelf-open(int);
    callback shelf-remove(int);
    callback focus-toggle();
    callback focus-reset();
    callback focus-preset(int);
    callback focus-adjust(int);
    callback water-add(int);
    callback water-undo();
    callback todo-add(string);
    callback todo-toggle(int);
    callback todo-remove(int);
    callback todo-clear-done();
    callback todo-reorder(int, float);
    callback todo-edit(bool);

    // --- Continuous geometry & crossfade derivations ------------------------
    private property <float> wake-t: clamp((notch.height - 4px) / 20px, 0.0, 1.0);
    private property <float> expand-t: clamp((notch.height - 36px) / 96px, 0.0, 1.0);
    private property <length> ear-radius: 0.5px + 7.5px * root.wake-t + 4px * root.expand-t;
    private property <length> bottom-radius: min(
        1.8px + 12.2px * root.wake-t + 4px * root.expand-t,
        max(0.5px, (notch.height - root.ear-radius) * 0.94)
    );

    private property <float> hud-flag-fade: root.hud-visible ? 1.0 : 0.0;
    private property <float> compact-hud-suppress: root.hud-visible ? 0.0 : 1.0;
    private property <float> expanded-flag-fade: root.expanded ? 1.0 : 0.0;

    animate hud-flag-fade { duration: 140ms; easing: ease-out; }
    animate compact-hud-suppress { duration: 120ms; easing: ease-out; }
    animate expanded-flag-fade { duration: 120ms; easing: ease-out; }

    private property <float> stealth-alpha:
        clamp(1.0 - (notch.height - 4px) / 8px, 0.0, 1.0)
        * clamp(1.0 - (notch.width - 134px) / 40px, 0.0, 1.0);

    private property <float> compact-alpha: root.compact-hud-suppress
        * clamp((notch.height - 10px) / 14px, 0.0, 1.0)
        * clamp((notch.width - 200px) / 50px, 0.0, 1.0)
        * clamp(1.0 - (notch.width - 284px) / 56px, 0.0, 1.0)
        * clamp(1.0 - (notch.height - 32px) / 14px, 0.0, 1.0);

    private property <float> hud-alpha: root.hud-flag-fade
        * clamp((notch.height - 26px) / 18px, 0.0, 1.0)
        * clamp((notch.width - 190px) / 48px, 0.0, 1.0)
        * clamp(1.0 - (notch.width - 296px) / 64px, 0.0, 1.0)
        * clamp(1.0 - (notch.height - 70px) / 48px, 0.0, 1.0);

    private property <float> expanded-alpha: root.expanded-flag-fade
        * clamp((notch.width - 320px) / 110px, 0.0, 1.0)
        * clamp((notch.height - 72px) / 76px, 0.0, 1.0);

    private property <int> page-count: 5;
    private property <[string]> page-labels: ["Music", "Focus", "Water", "Shelf", "To-do"];
    private property <bool> header-audio-active: root.media-playing
        || root.wave-0 > 0.02
        || root.wave-1 > 0.02
        || root.wave-2 > 0.02
        || root.wave-3 > 0.02
        || root.wave-4 > 0.02;

    // 1. Continuous height-clamped neutral smoked glass silhouette
    Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: max(notch.height + 1px, 4px);
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        fill: @linear-gradient(180deg,
            Theme.glass-stealth.mix(Theme.glass-top, root.wake-t) 0%,
            Theme.glass-stealth.mix(Theme.glass-bottom, root.wake-t) 100%);
        stroke: transparent;

        MoveTo { x: (notch.x - root.ear-radius) / 1px; y: 0; }
        ArcTo {
            radius-x: root.ear-radius / 1px;
            radius-y: root.ear-radius / 1px;
            sweep: true;
            x: notch.x / 1px;
            y: root.ear-radius / 1px;
        }
        LineTo {
            x: notch.x / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: false;
            x: (notch.x + root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        LineTo {
            x: (notch.x + notch.width - root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: false;
            x: (notch.x + notch.width) / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        LineTo {
            x: (notch.x + notch.width) / 1px;
            y: root.ear-radius / 1px;
        }
        ArcTo {
            radius-x: root.ear-radius / 1px;
            radius-y: root.ear-radius / 1px;
            sweep: true;
            x: (notch.x + notch.width + root.ear-radius) / 1px;
            y: 0;
        }
        LineTo { x: (notch.x - root.ear-radius) / 1px; y: 0; }
        Close {}
    }

    // Crisp 1px white specular glass rim along the free perimeter
    Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: max(notch.height + 2px, 6px);
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        fill: transparent;
        stroke: Theme.glass-rim;
        stroke-width: 1px;
        stroke-line-cap: round;

        MoveTo { x: (notch.x - root.ear-radius) / 1px; y: 0; }
        ArcTo {
            radius-x: root.ear-radius / 1px;
            radius-y: root.ear-radius / 1px;
            sweep: true;
            x: notch.x / 1px;
            y: root.ear-radius / 1px;
        }
        LineTo {
            x: notch.x / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: false;
            x: (notch.x + root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        LineTo {
            x: (notch.x + notch.width - root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: false;
            x: (notch.x + notch.width) / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        LineTo {
            x: (notch.x + notch.width) / 1px;
            y: root.ear-radius / 1px;
        }
        ArcTo {
            radius-x: root.ear-radius / 1px;
            radius-y: root.ear-radius / 1px;
            sweep: true;
            x: (notch.x + notch.width + root.ear-radius) / 1px;
            y: 0;
        }
    }

    // 2. Clipped glass interior, subtle top white sheen & active views
    notch := Rectangle {
        x: (root.width - self.width) / 2;
        y: 0px;
        width: max(root.notch-width, 16px);
        height: max(root.notch-height, 2px);
        background: transparent;
        clip: true;

        // Subtle top white glass sheen
        Rectangle {
            x: 2px;
            y: 0px;
            width: max(0px, parent.width - 4px);
            height: min(parent.height * 0.35, 30px);
            background: @linear-gradient(180deg, #FFFFFF12 0%, transparent 100%);
            opacity: root.wake-t;
        }

        // Whole-notch interaction layer for collapsed/HUD modes
        TouchArea {
            enabled: !root.expanded;
            mouse-cursor: root.expanded ? default : pointer;
            clicked => {
                if (!root.expanded) {
                    root.toggle-expand();
                }
            }
            pointer-event(e) => {
                if (!root.expanded && e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    root.quit();
                }
            }
        }

        // --- Stealth filament & Compact / Closed pill view ------------------
        if root.stealth-alpha > 0.005 || root.compact-alpha > 0.005: CompactView {
            x: 0px;
            y: 0px;
            notch-width: notch.width;
            notch-height: notch.height;
            stealth-alpha: root.stealth-alpha;
            compact-alpha: root.compact-alpha;
            media-playing: root.media-playing;
            focus-active: root.focus-active;
            focus-remaining: root.focus-remaining;
            clock-text: root.clock-text;
            water-nudge: root.water-nudge;
            mascot: root.mascot;
            corona: root.corona;
            aura: root.aura;
            orb-scale: root.orb-scale;
            orb-glow: root.orb-glow;
            aura-scale: root.aura-scale;
            aura-opacity: root.aura-opacity;
            corona-angle: root.corona-angle;
            orb-offset-x: root.orb-offset-x;
            orb-offset-y: root.orb-offset-y;
            battery-present: root.battery-present;
            battery-on-ac: root.battery-on-ac;
            battery-percent: root.battery-percent;
            battery-charging: root.battery-charging;
            battery-arc-x: root.battery-arc-x;
            battery-arc-y: root.battery-arc-y;
            battery-arc-large: root.battery-arc-large;
            battery-arc-visible: root.battery-arc-visible;
            battery-full: root.battery-full;
            wave-0: root.wave-0;
            wave-1: root.wave-1;
            wave-2: root.wave-2;
            wave-3: root.wave-3;
            wave-4: root.wave-4;
        }

        // --- Transient Hardware HUD view ------------------------------------
        if root.hud-visible || root.hud-alpha > 0.005: HardwareHudView {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            hud-visible: root.hud-visible;
            hud-alpha: root.hud-alpha;
            hud-device: root.hud-device;
            hud-title: root.hud-title;
            hud-status: root.hud-status;
            hud-connected: root.hud-connected;
            hud-charging: root.hud-charging;
            hud-percent-text: root.hud-percent-text;
            battery-present: root.battery-present;
            battery-on-ac: root.battery-on-ac;
            battery-percent: root.battery-percent;
            battery-charging: root.battery-charging;
            battery-arc-x: root.battery-arc-x;
            battery-arc-y: root.battery-arc-y;
            battery-arc-large: root.battery-arc-large;
            battery-arc-visible: root.battery-arc-visible;
            battery-full: root.battery-full;
            wave-0: root.wave-0;
            wave-1: root.wave-1;
            wave-2: root.wave-2;
            wave-3: root.wave-3;
            wave-4: root.wave-4;
            orb-glow: root.orb-glow;
        }

        // --- Unified Expanded Shell (476 x 172 px) --------------------------
        if root.expanded || root.expanded-alpha > 0.005: Rectangle {
            width: 476px;
            height: 172px;
            x: (parent.width - self.width) / 2;
            y: 0px;
            background: transparent;
            opacity: root.expanded-alpha;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                // --- Top Bar (24px height) ----------------------------------
                Rectangle {
                    height: 24px;
                    background: transparent;

                    header-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-expand();
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                root.quit();
                            }
                        }
                        scroll-event(event) => {
                            if (event.delta-y < 0px || event.delta-x < 0px) {
                                root.page-selected(min(root.active-page + 1, root.page-count - 1));
                                return EventResult.accept;
                            }
                            if (event.delta-y > 0px || event.delta-x > 0px) {
                                root.page-selected(max(root.active-page - 1, 0));
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                    }

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 6px;

                        Rectangle {
                            width: 16px;
                            height: parent.height;
                            background: transparent;

                            PlasmaOrb {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                orb-size: 16px;
                                mascot: root.mascot;
                                corona: root.corona;
                                aura: root.aura;
                                orb-scale: root.orb-scale;
                                orb-glow: root.orb-glow;
                                aura-scale: root.aura-scale;
                                aura-opacity: root.aura-opacity;
                                corona-angle: root.corona-angle;
                                orb-offset-x: root.orb-offset-x;
                                orb-offset-y: root.orb-offset-y;
                                water-nudge: root.water-nudge;
                            }
                        }

                        Text {
                            text: root.page-title;
                            color: Theme.ink;
                            font-size: 12.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        if root.date-text != "": Text {
                            text: root.date-text;
                            color: Theme.ink-3;
                            font-size: 10px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        Rectangle {
                            width: 13px;
                            height: parent.height;
                            background: transparent;

                            BatteryRing {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                ring-size: 13px;
                                percent: root.battery-percent;
                                charging: root.battery-charging;
                                present: root.battery-present;
                                on-ac: root.battery-on-ac;
                                arc-x: root.battery-arc-x;
                                arc-y: root.battery-arc-y;
                                arc-large: root.battery-arc-large;
                                arc-visible: root.battery-arc-visible;
                                full: root.battery-full;
                                show-bolt: true;
                            }
                        }

                        if root.battery-present: Text {
                            text: "\{Math.round(root.battery-percent)}%";
                            color: root.battery-charging
                                ? Theme.success
                                : (root.battery-percent <= 20.0 ? Theme.warn : Theme.ink-3);
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.clock-text;
                            color: Theme.ink;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: header-wave.width;
                            height: parent.height;
                            background: transparent;

                            header-wave := AudioWave {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                wave-0: root.wave-0;
                                wave-1: root.wave-1;
                                wave-2: root.wave-2;
                                wave-3: root.wave-3;
                                wave-4: root.wave-4;
                                bar-width: 2px;
                                bar-gap: 1.5px;
                                max-height: 10px;
                                min-height: 2.5px;
                                bar-color: root.header-audio-active ? Theme.accent : Theme.ink-dim;
                                active: root.header-audio-active;
                                inactive-opacity: 0.72;
                            }
                        }

                        // Hover-animated Collapse button (20 x 20 px)
                        Rectangle {
                            width: 20px;
                            height: parent.height;
                            background: transparent;

                            Rectangle {
                                width: 20px;
                                height: 20px;
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 10px;
                                background: collapse-touch.pressed
                                    ? Theme.glass-pill-press
                                    : (collapse-touch.has-hover
                                        ? Theme.glass-pill-hover
                                        : (header-touch.has-hover ? Theme.glass-pill : Theme.glass-card));
                                border-width: 1px;
                                border-color: collapse-touch.has-hover
                                    ? Theme.glass-specular
                                    : (header-touch.has-hover ? Theme.glass-rim : Theme.glass-rim-subtle);
                                opacity: (collapse-touch.has-hover || header-touch.has-hover) ? 1.0 : 0.72;

                                animate background, border-color, opacity {
                                    duration: 160ms;
                                    easing: ease-out;
                                }

                                IconChevron {
                                    width: 8px;
                                    height: 5px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2 - (collapse-touch.has-hover ? 1px : 0px);
                                    tint: (collapse-touch.has-hover || header-touch.has-hover) ? Theme.ink : Theme.ink-3;

                                    animate y {
                                        duration: 160ms;
                                        easing: ease-out;
                                    }
                                }

                                collapse-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.toggle-expand();
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Content Stage (452 x 104 px directly on glass canvas) --
                Rectangle {
                    width: 452px;
                    height: 104px;
                    clip: true;
                    background: transparent;

                    Rectangle {
                        x: (1.0 - root.page-fade) * root.page-direction * 18px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        opacity: root.page-fade;
                        background: transparent;

                        animate opacity, x {
                            duration: root.page-fade > 0.5 ? 200ms : 0ms;
                            easing: ease-out;
                        }

                        if root.active-page == 0: MusicPage {
                            width: parent.width;
                            height: parent.height;
                            media-available: root.media-available;
                            media-playing: root.media-playing;
                            track-title: root.track-title;
                            track-subtitle: root.track-subtitle;
                            media-source: root.media-source;
                            elapsed-text: root.elapsed-text;
                            remaining-text: root.remaining-text;
                            has-album-art: root.has-album-art;
                            album-art: root.album-art;
                            seek-enabled: root.seek-enabled;
                            can-skip-previous: root.can-skip-previous;
                            can-skip-next: root.can-skip-next;
                            seek-fraction <=> root.seek-fraction;
                            seek-dragging <=> root.seek-dragging;
                            lyrics-enabled: root.lyrics-enabled;
                            lyrics-available: root.lyrics-available;
                            lyrics-loading: root.lyrics-loading;
                            lyrics-line-prev: root.lyrics-line-prev;
                            lyrics-line-curr: root.lyrics-line-curr;
                            lyrics-line-next: root.lyrics-line-next;
                            lyrics-revision: root.lyrics-revision;
                            lyrics-glow-color: root.lyrics-glow-color;
                            wave-0: root.wave-0;
                            wave-1: root.wave-1;
                            wave-2: root.wave-2;
                            wave-3: root.wave-3;
                            wave-4: root.wave-4;
                            media-play-pause => { root.media-play-pause(); }
                            media-previous => { root.media-previous(); }
                            media-next => { root.media-next(); }
                            media-open-source => { root.media-open-source(); }
                            media-seek-start => { root.media-seek-start(); }
                            media-seek-preview(f) => { root.media-seek-preview(f); }
                            media-seek-commit(f) => { root.media-seek-commit(f); }
                            lyrics-toggle => { root.lyrics-toggle(); }
                        }

                        if root.active-page == 1: FocusPage {
                            width: parent.width;
                            height: parent.height;
                            focus-minutes: root.focus-minutes;
                            focus-remaining: root.focus-remaining;
                            focus-progress: root.focus-progress;
                            focus-running: root.focus-running;
                            focus-active: root.focus-active;
                            focus-celebrate: root.focus-celebrate;
                            focus-session: root.focus-session;
                            focus-completed: root.focus-completed;
                            focus-toggle => { root.focus-toggle(); }
                            focus-reset => { root.focus-reset(); }
                            focus-preset(m) => { root.focus-preset(m); }
                            focus-adjust(d) => { root.focus-adjust(d); }
                        }

                        if root.active-page == 2: WaterPage {
                            width: parent.width;
                            height: parent.height;
                            water-current: root.water-current;
                            water-goal: root.water-goal;
                            water-progress: root.water-progress;
                            water-phase: root.water-phase;
                            water-summary: root.water-summary;
                            water-percent: root.water-percent;
                            water-can-undo: root.water-can-undo;
                            water-nudge: root.water-nudge;
                            water-add(ml) => { root.water-add(ml); }
                            water-undo => { root.water-undo(); }
                        }

                        if root.active-page == 3: ShelfPage {
                            width: parent.width;
                            height: parent.height;
                            shelf-items: root.shelf-items;
                            shelf-start: root.shelf-start;
                            shelf-total: root.shelf-total;
                            shelf-can-prev: root.shelf-can-prev;
                            shelf-can-next: root.shelf-can-next;
                            shelf-drag-active: root.shelf-drag-active;
                            shelf-fade: root.shelf-fade;
                            shelf-summary: root.shelf-summary;
                            shelf-nav(d) => { root.shelf-nav(d); }
                            shelf-clear => { root.shelf-clear(); }
                            shelf-open(idx) => { root.shelf-open(idx); }
                            shelf-remove(idx) => { root.shelf-remove(idx); }
                        }

                        if root.active-page == 4: TodoPage {
                            width: parent.width;
                            height: parent.height;
                            todo-items: root.todo-items;
                            todo-total: root.todo-total;
                            todo-done: root.todo-done;
                            todo-summary: root.todo-summary;
                            todo-draft <=> root.todo-draft;
                            todo-edit-active <=> root.todo-edit-active;
                            todo-add(text) => { root.todo-add(text); }
                            todo-toggle(id) => { root.todo-toggle(id); }
                            todo-remove(id) => { root.todo-remove(id); }
                            todo-clear-done => { root.todo-clear-done(); }
                            todo-reorder(idx, dy) => { root.todo-reorder(idx, dy); }
                            todo-edit(active) => { root.todo-edit(active); }
                        }
                    }
                }

                // --- Bottom Integrated Expanding Tab Dock (24px height) -----
                Rectangle {
                    height: 24px;
                    background: transparent;

                    TouchArea {
                        scroll-event(event) => {
                            if (event.delta-y < 0px || event.delta-x < 0px) {
                                root.page-selected(min(root.active-page + 1, root.page-count - 1));
                                return EventResult.accept;
                            }
                            if (event.delta-y > 0px || event.delta-x > 0px) {
                                root.page-selected(max(root.active-page - 1, 0));
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                    }

                    dock := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 242px;
                        height: 24px;
                        border-radius: 12px;
                        background: Theme.glass-card;
                        border-width: 1px;
                        border-color: Theme.glass-rim-subtle;

                        // Gliding white frosted active highlight pill
                        Rectangle {
                            x: 3px + root.active-page * 38px;
                            y: 3px;
                            width: 84px;
                            height: 18px;
                            border-radius: 9px;
                            background: Theme.accent-soft;
                            border-width: 1px;
                            border-color: Theme.accent-rim;

                            animate x {
                                duration: 220ms;
                                easing: ease-out;
                            }
                        }

                        HorizontalLayout {
                            x: 3px;
                            y: 3px;
                            width: parent.width - 6px;
                            height: 18px;
                            spacing: 2px;

                            for label[page] in root.page-labels: Rectangle {
                                width: root.active-page == page ? 84px : 36px;
                                height: 18px;
                                border-radius: 9px;
                                clip: true;
                                background: root.active-page == page
                                    ? (tab-touch.pressed ? Theme.accent.with-alpha(0.14) : transparent)
                                    : (tab-touch.pressed
                                        ? Theme.glass-pill-press
                                        : (tab-touch.has-hover ? Theme.glass-pill : transparent));

                                animate width {
                                    duration: 220ms;
                                    easing: ease-out;
                                }
                                animate background {
                                    duration: 160ms;
                                    easing: ease-out;
                                }

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    alignment: center;
                                    spacing: root.active-page == page ? 4px : 0px;

                                    Rectangle {
                                        width: 12px;
                                        height: parent.height;
                                        background: transparent;

                                        if page == 0: IconMusic {
                                            width: 12px;
                                            height: 12px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            tint: root.active-page == page
                                                ? Theme.ink
                                                : (tab-touch.has-hover ? Theme.ink : Theme.ink-3);
                                        }
                                        if page == 1: IconFocus {
                                            width: 12px;
                                            height: 12px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            tint: root.active-page == page
                                                ? Theme.ink
                                                : (tab-touch.has-hover ? Theme.ink : Theme.ink-3);
                                        }
                                        if page == 2: IconWater {
                                            width: 12px;
                                            height: 12px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            tint: root.active-page == page
                                                ? Theme.ink
                                                : (tab-touch.has-hover ? Theme.ink : Theme.ink-3);
                                        }
                                        if page == 3: IconShelf {
                                            width: 12px;
                                            height: 12px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            tint: root.active-page == page
                                                ? Theme.ink
                                                : (tab-touch.has-hover ? Theme.ink : Theme.ink-3);
                                        }
                                        if page == 4: IconTodo {
                                            width: 12px;
                                            height: 12px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            tint: root.active-page == page
                                                ? Theme.ink
                                                : (tab-touch.has-hover ? Theme.ink : Theme.ink-3);
                                        }
                                    }

                                    if root.active-page == page: Text {
                                        text: label;
                                        color: Theme.ink;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                tab-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.page-selected(page);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
