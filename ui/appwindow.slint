// Kripton — Native Windows living notch
// UI shell for PRD v2.0. The Rust runtime drives the spring geometry, the
// plasma layers, the battery arc and the audio bars through these properties.

export component AppWindow inherits Window {
    title: "Kripton";
    width: 600px;
    height: 220px;
    background: transparent;
    no-frame: true;

    default-font-family: "Segoe UI Variable Display";
    default-font-size: 12px;

    // --- Driven by Rust -----------------------------------------------------
    in property <length> notch-width: 190px;
    in property <length> notch-height: 38px;
    in property <bool> expanded: false;
    in property <bool> closed: false;
    in property <int> active-page: 0;
    in property <string> page-title: "Music";
    in property <string> page-subtitle: "";
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> build-label: "v1.0.0";
    in property <bool> lyrics-enabled: false;

    // Living mascot (Sprint 1).
    in property <image> mascot: @image-url("../assets/plasma_core.png");
    in property <image> corona: @image-url("../assets/plasma_corona.png");
    in property <image> aura: @image-url("../assets/plasma_aura.png");
    in property <float> orb-scale: 1.0;
    in property <float> orb-glow: 0.48;
    in property <length> orb-offset-x: 0px;
    in property <length> orb-offset-y: 0px;
    in property <float> aura-scale: 1.0;
    in property <float> aura-opacity: 0.48;
    in property <angle> corona-angle: 0deg;

    // Closed compact mode (Sprint 1).
    in property <bool> battery-present: true;
    in property <bool> battery-on-ac: true;
    in property <float> battery-percent: 100.0;
    in property <bool> battery-charging: false;
    in property <float> battery-arc-x: 9.0;
    in property <float> battery-arc-y: 1.25;
    in property <bool> battery-arc-large: false;
    in property <bool> battery-arc-visible: false;
    in property <bool> battery-full: true;
    in property <float> wave-0: 0.0;
    in property <float> wave-1: 0.0;
    in property <float> wave-2: 0.0;
    in property <float> wave-3: 0.0;
    in property <float> wave-4: 0.0;

    // Music page (Sprint 2).
    in property <bool> media-available: false;
    in property <bool> media-playing: false;
    in property <string> track-title: "Nothing playing";
    in property <string> track-subtitle: "Start a track in any media app";
    in property <string> elapsed-text: "00:00";
    in property <string> remaining-text: "-00:00";
    in property <bool> has-album-art: false;
    in property <image> album-art: @image-url("../assets/plasma_core.png");
    in property <bool> seek-enabled: false;
    in property <bool> can-skip-previous: false;
    in property <bool> can-skip-next: false;
    in-out property <float> seek-fraction: 0.0;
    in-out property <bool> seek-dragging: false;

    callback toggle-expand();
    callback page-selected(int);
    callback quit();
    callback media-play-pause();
    callback media-previous();
    callback media-next();
    callback media-open-source();
    callback media-seek-start();
    callback media-seek-preview(float);
    callback media-seek-commit(float);
    callback lyrics-toggle();

    // --- Design tokens ------------------------------------------------------
    private property <length> ear-radius: 12px;
    private property <length> bottom-radius: 18px;
    private property <int> page-count: 5;
    private property <length> ring-size: 18px;
    private property <length> wave-bar-width: 2.5px;

    // 1. Silhouette: top-attached notch with inverse concave ear fillets and
    //    G1-smooth bottom corners. Coordinates follow the animated notch rect,
    //    so the outline never lags behind the content during a morph.
    Path {
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        fill: #000000;

        MoveTo {
            x: (notch.x - root.ear-radius) / 1px;
            y: 0;
        }
        LineTo {
            x: (notch.x + notch.width + root.ear-radius) / 1px;
            y: 0;
        }
        ArcTo {
            radius-x: root.ear-radius / 1px;
            radius-y: root.ear-radius / 1px;
            sweep: true;
            x: (notch.x + notch.width) / 1px;
            y: root.ear-radius / 1px;
        }
        LineTo {
            x: (notch.x + notch.width) / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: true;
            x: (notch.x + notch.width - root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        LineTo {
            x: (notch.x + root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: true;
            x: notch.x / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        LineTo {
            x: notch.x / 1px;
            y: root.ear-radius / 1px;
        }
        ArcTo {
            radius-x: root.ear-radius / 1px;
            radius-y: root.ear-radius / 1px;
            sweep: true;
            x: (notch.x - root.ear-radius) / 1px;
            y: 0;
        }
        Close {}
    }

    // 2. Notch surface and content.
    notch := Rectangle {
        x: (root.width - self.width) / 2;
        y: 0;
        width: root.notch-width;
        height: root.notch-height;
        background: transparent;
        clip: true;

        // Bottom ambient ionized glow. The gradient lives in a taller box than
        // it paints so the top edge fades inside the box instead of clipping
        // against a hard seam. Inset from the bottom corners because Slint
        // clips rectangularly.
        Rectangle {
            x: 10px;
            y: parent.height - 30px;
            width: parent.width - 20px;
            height: 30px;
            background: @radial-gradient(circle, #4F46E5B8 0%, #7C3AED44 48%, transparent 82%);
            opacity: root.expanded ? 0.55 : root.orb-glow;
        }
        Rectangle {
            x: parent.width * 0.28;
            y: parent.height - 20px;
            width: parent.width * 0.44;
            height: 18px;
            background: @radial-gradient(circle, #00F0FF44 0%, transparent 84%);
            opacity: root.expanded ? 0.6 : root.orb-glow * 0.9;
        }

        // Whole-notch interaction layer. It sits below the content so the
        // pagination dots and future feature controls receive clicks first.
        TouchArea {
            clicked => {
                root.toggle-expand();
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    root.quit();
                }
            }
        }

        // --- Idle: the Ionized Plasma Core ---------------------------------
        if !root.expanded: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;
            opacity: root.closed ? 0.0 : 1.0;
            animate opacity {
                duration: 140ms;
                easing: ease-out;
            }

            Image {
                source: root.aura;
                width: 104px * root.aura-scale;
                height: self.width;
                x: (parent.width - self.width) / 2 + root.orb-offset-x * 0.55;
                y: (parent.height - self.height) / 2 + 2px + root.orb-offset-y * 0.55;
                opacity: root.aura-opacity;
                image-fit: contain;
            }

            Image {
                source: root.corona;
                width: 64px;
                height: 64px;
                x: (parent.width - self.width) / 2 + root.orb-offset-x * 0.85;
                y: (parent.height - self.height) / 2 + 1px + root.orb-offset-y * 0.85;
                transform-rotation: root.corona-angle;
                opacity: 0.88;
                image-fit: contain;
            }

            Image {
                source: root.mascot;
                width: 44px * root.orb-scale;
                height: self.width;
                x: (parent.width - self.width) / 2 + root.orb-offset-x;
                y: (parent.height - self.height) / 2 + 1px + root.orb-offset-y;
                image-fit: contain;
            }
        }

        // --- Closed: battery ring, clock and live wave ----------------------
        if !root.expanded: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;
            opacity: root.closed ? 1.0 : 0.0;
            animate opacity {
                duration: 140ms;
                easing: ease-out;
            }

            // Left: 18 px battery ring over a dark emerald track.
            Rectangle {
                x: 13px;
                y: (parent.height - root.ring-size) / 2;
                width: root.ring-size;
                height: root.ring-size;
                background: transparent;

                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 18;
                    viewbox-height: 18;
                    fill: transparent;
                    stroke: #064E3B;
                    stroke-width: 2.5px;
                    stroke-line-cap: round;
                    MoveTo {
                        x: 9;
                        y: 1.25;
                    }
                    ArcTo {
                        radius-x: 7.75;
                        radius-y: 7.75;
                        large-arc: false;
                        sweep: true;
                        x: 9;
                        y: 16.75;
                    }
                    ArcTo {
                        radius-x: 7.75;
                        radius-y: 7.75;
                        large-arc: false;
                        sweep: true;
                        x: 9;
                        y: 1.25;
                    }
                }

                if root.battery-full: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 18;
                    viewbox-height: 18;
                    fill: transparent;
                    stroke: root.battery-charging ? #34D399 : #22C55E;
                    stroke-width: 2.5px;
                    stroke-line-cap: round;
                    MoveTo {
                        x: 9;
                        y: 1.25;
                    }
                    ArcTo {
                        radius-x: 7.75;
                        radius-y: 7.75;
                        large-arc: false;
                        sweep: true;
                        x: 9;
                        y: 16.75;
                    }
                    ArcTo {
                        radius-x: 7.75;
                        radius-y: 7.75;
                        large-arc: false;
                        sweep: true;
                        x: 9;
                        y: 1.25;
                    }
                }

                if root.battery-arc-visible && !root.battery-full: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 18;
                    viewbox-height: 18;
                    fill: transparent;
                    stroke: root.battery-charging ? #34D399 : #22C55E;
                    stroke-width: 2.5px;
                    stroke-line-cap: round;
                    MoveTo {
                        x: 9;
                        y: 1.25;
                    }
                    ArcTo {
                        radius-x: 7.75;
                        radius-y: 7.75;
                        large-arc: root.battery-arc-large;
                        sweep: true;
                        x: root.battery-arc-x;
                        y: root.battery-arc-y;
                    }
                }

                // Charging bolt, or an AC bolt on desktops without a battery.
                if root.battery-charging || (!root.battery-present && root.battery-on-ac): Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 18;
                    viewbox-height: 18;
                    fill: root.battery-present ? #34D399 : #00F0FF;
                    stroke: transparent;
                    MoveTo {
                        x: 10.1;
                        y: 4.4;
                    }
                    LineTo {
                        x: 6.7;
                        y: 9.7;
                    }
                    LineTo {
                        x: 8.9;
                        y: 9.7;
                    }
                    LineTo {
                        x: 7.9;
                        y: 13.6;
                    }
                    LineTo {
                        x: 11.4;
                        y: 8.2;
                    }
                    LineTo {
                        x: 9.2;
                        y: 8.2;
                    }
                    Close {}
                }
            }

            // Centre: 24-hour digital clock.
            Text {
                width: parent.width;
                height: parent.height;
                text: root.clock-text;
                color: #FFFFFF;
                font-size: 15px;
                font-weight: 700;
                letter-spacing: 0.3px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Right: five pill bars driven by the live audio peak.
            Rectangle {
                x: parent.width - 40px;
                y: 0;
                width: 24px;
                height: parent.height;
                background: transparent;

                Rectangle {
                    x: 0px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-0 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 5px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-1 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 10px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-2 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 15px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-3 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 20px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-4 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
            }
        }

        // --- Expanded shell ------------------------------------------------
        // Fixed 460 px layout clipped by the springing notch. Keeping the
        // layout at its final size avoids text reflow during the morph.
        if root.expanded: Rectangle {
            width: 460px;
            height: 175px;
            x: (parent.width - self.width) / 2;
            y: 0;
            background: transparent;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 4px;
                spacing: 3px;

                // --- Status header: mascot, page, battery, clock, live wave ---
                HorizontalLayout {
                    height: 26px;
                    spacing: 8px;

                    Image {
                        width: 26px;
                        height: 26px;
                        source: root.mascot;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;

                        Text {
                            text: root.page-title;
                            color: #FFFFFF;
                            font-size: 13.5px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.page-subtitle;
                            color: #9CA3AF;
                            font-size: 8.5px;
                            font-weight: 400;
                            overflow: TextOverflow.elide;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    // 16 px battery ring, vertically centred in the header.
                    Rectangle {
                        width: 16px;
                        height: 26px;
                        background: transparent;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;

                        Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: transparent;
                            stroke: #064E3B;
                            stroke-width: 2.6px;
                            stroke-line-cap: round;
                            MoveTo { x: 9; y: 1.25; }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: false;
                                sweep: true;
                                x: 9;
                                y: 16.75;
                            }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: false;
                                sweep: true;
                                x: 9;
                                y: 1.25;
                            }
                        }

                        if root.battery-full: Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: transparent;
                            stroke: root.battery-charging ? #34D399 : #22C55E;
                            stroke-width: 2.6px;
                            stroke-line-cap: round;
                            MoveTo { x: 9; y: 1.25; }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: false;
                                sweep: true;
                                x: 9;
                                y: 16.75;
                            }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: false;
                                sweep: true;
                                x: 9;
                                y: 1.25;
                            }
                        }

                        if root.battery-arc-visible && !root.battery-full: Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: transparent;
                            stroke: root.battery-charging ? #34D399 : #22C55E;
                            stroke-width: 2.6px;
                            stroke-line-cap: round;
                            MoveTo { x: 9; y: 1.25; }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: root.battery-arc-large;
                                sweep: true;
                                x: root.battery-arc-x;
                                y: root.battery-arc-y;
                            }
                        }

                        if root.battery-charging || (!root.battery-present && root.battery-on-ac): Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: root.battery-present ? #34D399 : #00F0FF;
                            stroke: transparent;
                            MoveTo { x: 10.1; y: 4.4; }
                            LineTo { x: 6.7; y: 9.7; }
                            LineTo { x: 8.9; y: 9.7; }
                            LineTo { x: 7.9; y: 13.6; }
                            LineTo { x: 11.4; y: 8.2; }
                            LineTo { x: 9.2; y: 8.2; }
                            Close {}
                        }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;

                        Text {
                            text: root.date-text;
                            color: #9CA3AF;
                            font-size: 8.5px;
                            horizontal-alignment: right;
                        }
                        Text {
                            text: root.clock-text;
                            color: #FFFFFF;
                            font-size: 14.5px;
                            font-weight: 700;
                            horizontal-alignment: right;
                        }
                    }

                    // Live 5-band wave, top right.
                    Rectangle {
                        width: 23px;
                        height: 26px;
                        background: transparent;

                        Rectangle {
                            x: 0px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-0 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                        Rectangle {
                            x: 5px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-1 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                        Rectangle {
                            x: 10px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-2 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                        Rectangle {
                            x: 15px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-3 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                        Rectangle {
                            x: 20px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-4 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                    }
                }

                // --- Page card -------------------------------------------------
                Rectangle {
                    vertical-stretch: 1;
                    background: @linear-gradient(145deg, #101014 0%, #08080B 100%);
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #FFFFFF12;
                    clip: true;

                    Image {
                        width: 132px;
                        height: 132px;
                        x: parent.width - 96px;
                        y: -40px;
                        source: root.mascot;
                        image-fit: contain;
                        opacity: root.active-page == 0 ? 0.10 : 0.22;
                    }

                    // --- Music page -------------------------------------------
                    if root.active-page == 0: VerticalLayout {
                        alignment: center;
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 5px;
                        padding-bottom: 4px;
                        spacing: 3px;

                        // Album art, track identity and open-source button.
                        HorizontalLayout {
                            height: 64px;
                            spacing: 10px;

                            Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: 14px;
                                clip: true;
                                background: @linear-gradient(135deg, #1F2937 0%, #0B0B0E 100%);

                                if root.has-album-art: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.album-art;
                                    image-fit: cover;
                                }
                                if !root.has-album-art: Image {
                                    width: 38px;
                                    height: 38px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: root.mascot;
                                    image-fit: contain;
                                    opacity: 0.35;
                                }
                            }

                            VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 1px;

                                Text {
                                    text: root.track-title;
                                    color: #FFFFFF;
                                    font-size: 16px;
                                    font-weight: 700;
                                    overflow: TextOverflow.elide;
                                }
                                Text {
                                    text: root.track-subtitle;
                                    color: #9CA3AF;
                                    font-size: 12px;
                                    font-weight: 400;
                                    overflow: TextOverflow.elide;
                                }
                            }

                            Rectangle {
                                width: 26px;
                                height: 64px;
                                background: transparent;

                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 13px;
                                    background: root.media-available ? #262626 : #1A1A1E;

                                    Path {
                                        width: 8px;
                                        height: 12px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 8;
                                        viewbox-height: 12;
                                        fill: transparent;
                                        stroke: root.media-available ? #E5E7EB : #4B5563;
                                        stroke-width: 1.6px;
                                        stroke-line-cap: round;
                                        MoveTo { x: 2; y: 1; }
                                        LineTo { x: 6; y: 6; }
                                        LineTo { x: 2; y: 11; }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.media-open-source();
                                        }
                                    }
                                }
                            }
                        }

                        // Timeline: elapsed, seek bar, remaining.
                        HorizontalLayout {
                            height: 14px;
                            spacing: 7px;

                            Text {
                                text: root.elapsed-text;
                                color: #E5E7EB;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                Rectangle {
                                    x: 0;
                                    y: (parent.height - 4px) / 2;
                                    width: parent.width;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: #374151;

                                    Rectangle {
                                        width: parent.width * root.seek-fraction;
                                        height: 4px;
                                        border-radius: 2px;
                                        background: #FFFFFF;
                                    }

                                    if root.seek-enabled: Rectangle {
                                        x: parent.width * root.seek-fraction - 5px;
                                        y: -3px;
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: #FFFFFF;
                                        border-width: 2px;
                                        border-color: #0B0B0E;
                                    }
                                }

                                seek-touch := TouchArea {
                                    pointer-event(e) => {
                                        if (root.seek-enabled) {
                                            if (e.kind == PointerEventKind.down) {
                                                root.seek-dragging = true;
                                                root.media-seek-start();
                                                root.media-seek-preview((seek-touch.mouse-x / 1px) / (seek-touch.width / 1px));
                                            }
                                            if (e.kind == PointerEventKind.move && root.seek-dragging) {
                                                root.media-seek-preview((seek-touch.mouse-x / 1px) / (seek-touch.width / 1px));
                                            }
                                            if (e.kind == PointerEventKind.up && root.seek-dragging) {
                                                root.seek-dragging = false;
                                                root.media-seek-commit((seek-touch.mouse-x / 1px) / (seek-touch.width / 1px));
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.remaining-text;
                                color: #E5E7EB;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }

                        // Controls: lyrics toggle, previous, play/pause, next.
                        HorizontalLayout {
                            height: 26px;
                            spacing: 0px;

                            Rectangle {
                                width: 32px;
                                background: transparent;

                                Rectangle {
                                    x: 0;
                                    y: (parent.height - 18px) / 2;
                                    width: 22px;
                                    height: 18px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.lyrics-enabled ? transparent : #4B5563;
                                    background: root.lyrics-enabled ? #FFFFFF : #161619;

                                    for dot in 3: Rectangle {
                                        width: 2px;
                                        height: 2px;
                                        border-radius: 1px;
                                        x: 5px + dot * 4px;
                                        y: 8px;
                                        background: root.lyrics-enabled ? #0B0B0E : #D1D5DB;
                                    }

                                    Path {
                                        x: 4px;
                                        y: 15px;
                                        width: 5px;
                                        height: 4px;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 5;
                                        viewbox-height: 4;
                                        fill: root.lyrics-enabled ? #FFFFFF : #161619;
                                        stroke: root.lyrics-enabled ? #FFFFFF : #4B5563;
                                        stroke-width: 1px;
                                        MoveTo { x: 0; y: 0; }
                                        LineTo { x: 5; y: 0; }
                                        LineTo { x: 0; y: 4; }
                                        Close {}
                                    }
                                }

                                TouchArea {
                                    clicked => {
                                        root.lyrics-toggle();
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                HorizontalLayout {
                                    width: parent.width;
                                    height: 18px;
                                    y: (parent.height - 18px) / 2;
                                    spacing: 18px;
                                    alignment: center;

                                    // Previous.
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: transparent;

                                        Path {
                                            width: parent.width;
                                            height: parent.height;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 18;
                                            viewbox-height: 18;
                                            fill: root.can-skip-previous ? #FFFFFF : #4B5563;
                                            stroke: transparent;
                                            MoveTo { x: 4; y: 3; }
                                            LineTo { x: 6.2; y: 3; }
                                            LineTo { x: 6.2; y: 15; }
                                            LineTo { x: 4; y: 15; }
                                            Close {}
                                            MoveTo { x: 14.5; y: 3.5; }
                                            LineTo { x: 7.2; y: 9; }
                                            LineTo { x: 14.5; y: 14.5; }
                                            Close {}
                                        }

                                        TouchArea {
                                            clicked => {
                                                if (root.can-skip-previous) {
                                                    root.media-previous();
                                                }
                                            }
                                        }
                                    }

                                    // Play / pause.
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: transparent;

                                        if root.media-playing: Rectangle {
                                            x: 3px;
                                            y: 2px;
                                            width: 4px;
                                            height: 14px;
                                            border-radius: 1.5px;
                                            background: #FFFFFF;
                                        }
                                        if root.media-playing: Rectangle {
                                            x: 11px;
                                            y: 2px;
                                            width: 4px;
                                            height: 14px;
                                            border-radius: 1.5px;
                                            background: #FFFFFF;
                                        }

                                        if !root.media-playing: Path {
                                            width: 18px;
                                            height: 18px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 18;
                                            viewbox-height: 18;
                                            fill: #FFFFFF;
                                            stroke: transparent;
                                            MoveTo { x: 5; y: 2.5; }
                                            LineTo { x: 15; y: 9; }
                                            LineTo { x: 5; y: 15.5; }
                                            Close {}
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.media-play-pause();
                                            }
                                        }
                                    }

                                    // Next.
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: transparent;

                                        Path {
                                            width: parent.width;
                                            height: parent.height;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 18;
                                            viewbox-height: 18;
                                            fill: root.can-skip-next ? #FFFFFF : #4B5563;
                                            stroke: transparent;
                                            MoveTo { x: 11.8; y: 3; }
                                            LineTo { x: 14; y: 3; }
                                            LineTo { x: 14; y: 15; }
                                            LineTo { x: 11.8; y: 15; }
                                            Close {}
                                            MoveTo { x: 3.5; y: 3.5; }
                                            LineTo { x: 10.8; y: 9; }
                                            LineTo { x: 3.5; y: 14.5; }
                                            Close {}
                                        }

                                        TouchArea {
                                            clicked => {
                                                if (root.can-skip-next) {
                                                    root.media-next();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                width: 32px;
                                background: transparent;
                            }
                        }
                    }

                    // --- Placeholder for later sprints -------------------------
                    if root.active-page != 0: VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 3px;
                        alignment: center;

                        Text {
                            text: "SPRINT 2 · MUSIC & LIVE WAVE";
                            color: #6B7280;
                            font-size: 8.5px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                        }
                        Text {
                            text: root.page-subtitle;
                            color: #F9FAFB;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: TextOverflow.elide;
                            max-width: parent.width;
                        }
                        Text {
                            text: root.build-label;
                            color: #4B5563;
                            font-size: 9px;
                            overflow: TextOverflow.elide;
                            max-width: parent.width;
                        }
                    }
                }

                // Pagination: active capsule + four dim dots.
                HorizontalLayout {
                    height: 10px;
                    alignment: center;
                    spacing: 2px;

                    for page in root.page-count: Rectangle {
                        width: 20px;
                        height: 10px;
                        background: transparent;

                        Rectangle {
                            width: root.active-page == page ? 22px : 4px;
                            height: 4px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - 4px) / 2;
                            border-radius: 2px;
                            background: root.active-page == page ? #FFFFFF : #4B5563;
                            animate width {
                                duration: 180ms;
                                easing: ease-out;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.page-selected(page);
                            }
                        }
                    }
                }
            }
        }
    }
}
