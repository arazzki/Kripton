// Kripton — Native Windows living notch
// UI shell for PRD v2.0. The Rust runtime drives the spring geometry, the
// plasma layers, the battery arc and the audio bars through these properties.

export struct ShelfView {
    name: string,
    size-text: string,
    is-directory: bool,
    has-thumbnail: bool,
    missing: bool,
    thumbnail: image,
    index: int,
}

export struct TodoView {
    id: int,
    text: string,
    completed: bool,
}

export component AppWindow inherits Window {
    title: "Kripton";
    width: 680px;
    height: 260px;
    background: transparent;
    no-frame: true;

    default-font-family: "Segoe UI Variable Display";
    default-font-size: 12px;

    // --- Driven by Rust -----------------------------------------------------
    in property <length> notch-width: 184px;
    in property <length> notch-height: 5px;
    in property <bool> expanded: false;
    in property <bool> closed: false;
    in property <bool> stealth: true;
    in property <int> active-page: 0;
    in property <float> page-fade: 1.0;
    in property <string> page-title: "Music";
    in property <string> page-subtitle: "";
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> build-label: "v1.0.0";
    in property <bool> lyrics-enabled: false;

    // Lyrics mode (Sprint 3).

    in property <string> lyrics-line-prev: "";

    in property <string> lyrics-line-curr: "Play a track to see lyrics";

    in property <string> lyrics-line-next: "";

    in property <bool> lyrics-available: false;

    in property <bool> lyrics-loading: false;

    in property <color> lyrics-glow-color: #1E3A8A;

    // Living mascot (Sprint 1).
    in property <image> mascot: @image-url("../assets/plasma_core.png");
    in property <image> corona: @image-url("../assets/plasma_corona.png");
    in property <image> aura: @image-url("../assets/plasma_aura.png");
    in property <float> orb-scale: 1.0;
    in property <float> orb-glow: 0.48;
    in property <length> orb-offset-x: 0px;
    in property <length> orb-offset-y: 0px;
    in property <float> aura-scale: 1.0;
    in property <float> aura-opacity: 0.48;
    in property <angle> corona-angle: 0deg;

    // Closed compact mode (Sprint 1).
    in property <bool> battery-present: true;
    in property <bool> battery-on-ac: true;
    in property <float> battery-percent: 100.0;
    in property <bool> battery-charging: false;
    in property <float> battery-arc-x: 9.0;
    in property <float> battery-arc-y: 1.25;
    in property <bool> battery-arc-large: false;
    in property <bool> battery-arc-visible: false;
    in property <bool> battery-full: true;
    in property <float> wave-0: 0.0;
    in property <float> wave-1: 0.0;
    in property <float> wave-2: 0.0;
    in property <float> wave-3: 0.0;
    in property <float> wave-4: 0.0;

    // Music page (Sprint 2).
    in property <bool> media-available: false;
    in property <bool> media-playing: false;
    in property <string> track-title: "Nothing playing";
    in property <string> track-subtitle: "Start a track in any media app";
    in property <string> elapsed-text: "00:00";
    in property <string> remaining-text: "-00:00";
    in property <bool> has-album-art: false;
    in property <image> album-art: @image-url("../assets/plasma_core.png");
    in property <bool> seek-enabled: false;
    in property <bool> can-skip-previous: false;
    in property <bool> can-skip-next: false;
    in-out property <float> seek-fraction: 0.0;
    in-out property <bool> seek-dragging: false;

    // Shelf page (Sprint 4). The model only contains the visible carousel
    // window (max 5); `index` keeps the global shelf position.
    in property <[ShelfView]> shelf-items: [];
    in property <int> shelf-start: 0;
    in property <int> shelf-total: 0;
    in property <bool> shelf-can-prev: false;
    in property <bool> shelf-can-next: false;
    in property <bool> shelf-drag-active: false;
    in property <float> shelf-fade: 1.0;
    in property <string> shelf-summary: "Shelf is empty";

    // Focus page (Sprint 5).
    in property <int> focus-minutes: 25;
    in property <string> focus-remaining: "25:00";
    in property <float> focus-progress: 0.0;
    in property <bool> focus-running: false;
    in property <bool> focus-active: false;
    in property <bool> focus-celebrate: false;
    in property <string> focus-session: "Focus Session #1";
    in property <int> focus-completed: 0;

    // Water page (Sprint 5).
    in property <int> water-current: 0;
    in property <int> water-goal: 2000;
    in property <float> water-progress: 0.0;
    in property <float> water-phase: 0.0;
    in property <string> water-summary: "0 / 2,000 ml";
    in property <string> water-percent: "0%";
    in property <bool> water-can-undo: false;
    in property <bool> water-nudge: false;

    // To-do page (Sprint 5).
    in property <[TodoView]> todo-items: [];
    in property <int> todo-total: 0;
    in property <int> todo-done: 0;
    in property <string> todo-summary: "No tasks yet";
    in-out property <string> todo-draft: "";
    in-out property <bool> todo-edit-active: false;

    // Hardware HUDs (Sprint 6).
    in property <bool> hud-visible: false;
    in property <bool> hud-device: true;
    in property <string> hud-title: "";
    in property <string> hud-status: "Connected";
    in property <bool> hud-connected: true;
    in property <bool> hud-charging: false;
    in property <string> hud-percent-text: "100%";

    callback toggle-expand();
    callback page-selected(int);
    callback quit();
    callback media-play-pause();
    callback media-previous();
    callback media-next();
    callback media-open-source();
    callback media-seek-start();
    callback media-seek-preview(float);
    callback media-seek-commit(float);
    callback lyrics-toggle();
    callback shelf-nav(int);
    callback shelf-clear();
    callback shelf-open(int);
    callback shelf-remove(int);
    callback focus-toggle();
    callback focus-reset();
    callback focus-preset(int);
    callback focus-adjust(int);
    callback water-add(int);
    callback water-undo();
    callback todo-add(string);
    callback todo-toggle(int);
    callback todo-remove(int);
    callback todo-clear-done();
    callback todo-reorder(int, float);
    callback todo-edit(bool);

    // --- Design tokens ------------------------------------------------------
    private property <length> bottom-radius: root.stealth ? 2.5px : 18px;
    private property <int> page-count: 5;
    private property <[string]> page-labels: ["Music", "Focus", "Water", "Shelf", "To-do"];
    private property <[int]> focus-presets: [15, 25, 45, 60];
    private property <[int]> water-presets: [150, 250, 500];
    private property <length> ring-size: 18px;
    private property <length> wave-bar-width: 2.5px;

    // 1. Silhouette: clean top-attached notch with smooth bottom rounded corners.
    //    Coordinates follow the animated notch rect directly, eliminating the
    //    protruding "ears" (double curves) for a sleek, modern outline.
    Path {
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        fill: #000000;

        MoveTo {
            x: notch.x / 1px;
            y: 0;
        }
        LineTo {
            x: (notch.x + notch.width) / 1px;
            y: 0;
        }
        LineTo {
            x: (notch.x + notch.width) / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: true;
            x: (notch.x + notch.width - root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        LineTo {
            x: (notch.x + root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: true;
            x: notch.x / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        LineTo {
            x: notch.x / 1px;
            y: 0;
        }
        Close {}
    }

    // 2. Notch surface and content.
    notch := Rectangle {
        x: (root.width - self.width) / 2;
        y: 0;
        width: root.notch-width;
        height: root.notch-height;
        background: transparent;
        clip: true;

        if root.lyrics-enabled && root.active-page == 0 && root.expanded: Rectangle {

            x: 8px;

            y: parent.height - 35px;

            width: parent.width - 16px;

            height: 35px;

            background: @radial-gradient(circle, root.lyrics-glow-color.transparentize(50%) 0%, root.lyrics-glow-color.transparentize(85%) 55%, transparent 85%);

            opacity: 0.85;

        }

        // Bottom ambient ionized glow.
        Rectangle {
            x: 10px;
            y: parent.height - 30px;
            width: parent.width - 20px;
            height: 30px;
            background: @radial-gradient(circle, #4F46E5B8 0%, #7C3AED44 48%, transparent 82%);
            opacity: root.stealth ? 0.0 : (root.expanded ? 0.55 : root.orb-glow);
            animate opacity {
                duration: 200ms;
                easing: ease-out;
            }
        }
        Rectangle {
            x: parent.width * 0.28;
            y: parent.height - 20px;
            width: parent.width * 0.44;
            height: 18px;
            background: @radial-gradient(circle, #00F0FF44 0%, transparent 84%);
            opacity: root.expanded ? 0.6 : root.orb-glow * 0.9;
        }

        // Whole-notch interaction layer for collapsed/stealth modes.
        // When expanded, clicks inside the card will not accidentally collapse the notch.
        TouchArea {
            mouse-cursor: root.expanded ? default : pointer;
            clicked => {
                if (!root.expanded) {
                    root.toggle-expand();
                }
            }
            pointer-event(e) => {
                if (!root.expanded && e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    root.quit();
                }
            }
        }

        // --- Collapsed Notch Content (Stealth & Compact Pill) ---------------
        if !root.expanded && !root.hud-visible: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            // 1. Morphing Plasma Streak Line:
            // In Stealth: centered 120px line.
            // On Wake to Compact: gracefully glides to left (x: 10px), condenses and blossoms into enlarged 30px mascot orb!
            Rectangle {
                width: root.stealth ? 120px : 30px;
                height: root.stealth ? 2.5px : 30px;
                x: root.stealth ? (parent.width - self.width) / 2 : 10px;
                y: root.stealth ? (parent.height - self.height) / 2 : (parent.height - 30px) / 2;
                border-radius: root.stealth ? 1.25px : 15px;
                opacity: root.stealth ? 1.0 : 0.0;
                background: @linear-gradient(90deg, transparent 0%, #7C3AED 18%, #00F0FF 50%, #10B981 82%, transparent 100%);
                animate x {
                    duration: 380ms;
                    easing: ease-in-out;
                }
                animate width {
                    duration: 380ms;
                    easing: ease-in-out;
                }
                animate height {
                    duration: 350ms;
                    easing: ease-in-out;
                }
                animate border-radius {
                    duration: 350ms;
                    easing: ease-in-out;
                }
                animate opacity {
                    duration: 320ms;
                    easing: ease-in-out;
                }

                // Bright center bead that concentrates energy into the core
                Rectangle {
                    width: root.stealth ? 36px : 9px;
                    height: root.stealth ? 1.5px : 9px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: root.stealth ? 0.75px : 4.5px;
                    background: #FFFFFF;
                    opacity: root.stealth ? 0.95 : 0.0;
                    animate width {
                        duration: 340ms;
                        easing: ease-in-out;
                    }
                    animate height {
                        duration: 320ms;
                        easing: ease-in-out;
                    }
                    animate opacity {
                        duration: 300ms;
                        easing: ease-in-out;
                    }
                }
            }

            // 2. Compact Pill: Left Mascot (reconstituted from the streak line, bold 30px size)
            Rectangle {
                x: 10px;
                y: (parent.height - self.height) / 2;
                width: root.stealth ? 10px : 30px;
                height: self.width;
                background: transparent;
                opacity: root.stealth ? 0.0 : 1.0;
                animate width {
                    duration: 380ms;
                    easing: ease-out;
                }
                animate opacity {
                    duration: 350ms;
                    easing: ease-in-out;
                }

                // Ambient glow around the mascot
                Rectangle {
                    width: 44px;
                    height: 44px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 22px;
                    background: @radial-gradient(circle, #00F0FF55 0%, #7C3AED2B 52%, transparent 80%);
                    opacity: root.aura-opacity;
                }

                // Hydration nudge: the mascot glows water-blue after 90 idle minutes.
                Rectangle {
                    width: 44px;
                    height: 44px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 22px;
                    background: @radial-gradient(circle, #38BDF8AA 0%, #0EA5E940 52%, transparent 80%);
                    opacity: root.water-nudge ? 0.9 : 0.0;
                    animate opacity {
                        duration: 600ms;
                        easing: ease-in-out;
                    }
                }

                // Rotating plasma corona core
                Image {
                    source: root.corona;
                    width: parent.width;
                    height: parent.height;
                    x: 0;
                    y: 0;
                    transform-rotation: root.corona-angle;
                    opacity: 0.92;
                    image-fit: contain;
                }

                // Mascot face avatar with gentle cursor ferrofluid pull
                Image {
                    source: root.mascot;
                    width: parent.width * 0.86;
                    height: self.width;
                    x: (parent.width - self.width) / 2 + root.orb-offset-x * 0.25;
                    y: (parent.height - self.height) / 2 + root.orb-offset-y * 0.25;
                    opacity: 1.0;
                    image-fit: contain;
                }
            }

            // 2b. Compact Pill: remaining focus time while a session is active.
            Rectangle {
                x: 46px;
                y: (parent.height - self.height) / 2;
                width: 66px;
                height: 20px;
                border-radius: 10px;
                background: #00F0FF1A;
                border-width: 1px;
                border-color: #00F0FF33;
                opacity: (root.focus-active && !root.stealth) ? 1.0 : 0.0;
                animate opacity {
                    duration: 220ms;
                    easing: ease-out;
                }

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.focus-remaining;
                    color: #00F0FF;
                    font-size: 10.5px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 3. Compact Pill: Centre 24-hour digital clock
            Text {
                width: parent.width;
                height: parent.height;
                text: root.clock-text;
                color: #FFFFFF;
                font-size: 15px;
                font-weight: 700;
                letter-spacing: 0.3px;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: root.stealth ? 0.0 : 1.0;
                animate opacity {
                    duration: 350ms;
                    easing: ease-in-out;
                }
            }

            // 4. Compact Pill: Right 5 pill bars driven by live audio spectrum
            Rectangle {
                x: parent.width - 40px;
                y: 0;
                width: 24px;
                height: parent.height;
                background: transparent;
                opacity: root.stealth ? 0.0 : 1.0;
                animate opacity {
                    duration: 350ms;
                    easing: ease-in-out;
                }

                Rectangle {
                    x: 0px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-0 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 5px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-1 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 10px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-2 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 15px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-3 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 20px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-4 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
            }
        }

        // --- Expanded shell ------------------------------------------------
        // Fixed 580 x 224 px layout clipped by the springing notch.
        if root.expanded: Rectangle {
            width: 580px;
            height: 224px;
            x: (parent.width - self.width) / 2;
            y: 0;
            background: transparent;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 5px;

                // --- Status header: mascot, page, collapse pill, battery, clock, live wave ---
                Rectangle {
                    height: 26px;
                    background: transparent;

                    header-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-expand();
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                root.quit();
                            }
                        }
                        scroll-event(event) => {
                            if (event.delta-y < 0px || event.delta-x < 0px) {
                                root.page-selected(min(root.active-page + 1, root.page-count - 1));
                                return EventResult.accept;
                            }
                            if (event.delta-y > 0px || event.delta-x > 0px) {
                                root.page-selected(max(root.active-page - 1, 0));
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                    }

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 8px;

                        Image {
                            width: 24px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            source: root.mascot;
                            image-fit: contain;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;

                            Text {
                                text: root.page-title;
                                color: #FFFFFF;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.page-subtitle;
                                color: #9CA3AF;
                                font-size: 8.5px;
                                font-weight: 400;
                                overflow: TextOverflow.elide;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        // Subtle collapse chevron indicator on header hover
                        Rectangle {
                            width: 24px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 9px;
                            background: header-touch.has-hover ? #FFFFFF14 : #FFFFFF06;
                            border-width: 1px;
                            border-color: header-touch.has-hover ? #FFFFFF28 : transparent;
                            animate background {
                                duration: 150ms;
                                easing: ease-out;
                            }

                            Path {
                                width: 10px;
                                height: 6px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: 10;
                                viewbox-height: 6;
                                fill: transparent;
                                stroke: header-touch.has-hover ? #FFFFFF : #6B7280;
                                stroke-width: 1.6px;
                                stroke-line-cap: round;
                                MoveTo { x: 1.5; y: 4.5; }
                                LineTo { x: 5; y: 1.2; }
                                LineTo { x: 8.5; y: 4.5; }
                            }
                        }

                        // 16 px battery ring, vertically centred in the header.
                        Rectangle {
                            width: 16px;
                            height: 26px;
                            background: transparent;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;

                                Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 18;
                                    viewbox-height: 18;
                                    fill: transparent;
                                    stroke: #064E3B;
                                    stroke-width: 2.6px;
                                    stroke-line-cap: round;
                                    MoveTo { x: 9; y: 1.25; }
                                    ArcTo {
                                        radius-x: 7.75;
                                        radius-y: 7.75;
                                        large-arc: false;
                                        sweep: true;
                                        x: 9;
                                        y: 16.75;
                                    }
                                    ArcTo {
                                        radius-x: 7.75;
                                        radius-y: 7.75;
                                        large-arc: false;
                                        sweep: true;
                                        x: 9;
                                        y: 1.25;
                                    }
                                }

                                if root.battery-full: Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 18;
                                    viewbox-height: 18;
                                    fill: transparent;
                                    stroke: root.battery-charging ? #34D399 : #22C55E;
                                    stroke-width: 2.6px;
                                    stroke-line-cap: round;
                                    MoveTo { x: 9; y: 1.25; }
                                    ArcTo {
                                        radius-x: 7.75;
                                        radius-y: 7.75;
                                        large-arc: false;
                                        sweep: true;
                                        x: 9;
                                        y: 16.75;
                                    }
                                    ArcTo {
                                        radius-x: 7.75;
                                        radius-y: 7.75;
                                        large-arc: false;
                                        sweep: true;
                                        x: 9;
                                        y: 1.25;
                                    }
                                }

                                if root.battery-arc-visible && !root.battery-full: Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 18;
                                    viewbox-height: 18;
                                    fill: transparent;
                                    stroke: root.battery-charging ? #34D399 : #22C55E;
                                    stroke-width: 2.6px;
                                    stroke-line-cap: round;
                                    MoveTo { x: 9; y: 1.25; }
                                    ArcTo {
                                        radius-x: 7.75;
                                        radius-y: 7.75;
                                        large-arc: root.battery-arc-large;
                                        sweep: true;
                                        x: root.battery-arc-x;
                                        y: root.battery-arc-y;
                                    }
                                }

                                if root.battery-charging || (!root.battery-present && root.battery-on-ac): Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 18;
                                    viewbox-height: 18;
                                    fill: root.battery-present ? #34D399 : #00F0FF;
                                    stroke: transparent;
                                    MoveTo { x: 10.1; y: 4.4; }
                                    LineTo { x: 6.7; y: 9.7; }
                                    LineTo { x: 8.9; y: 9.7; }
                                    LineTo { x: 7.9; y: 13.6; }
                                    LineTo { x: 11.4; y: 8.2; }
                                    LineTo { x: 9.2; y: 8.2; }
                                    Close {}
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;

                            Text {
                                text: root.date-text;
                                color: #9CA3AF;
                                font-size: 8.5px;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: root.clock-text;
                                color: #FFFFFF;
                                font-size: 14px;
                                font-weight: 700;
                                horizontal-alignment: right;
                            }
                        }

                        // Live 5-band wave, top right.
                        Rectangle {
                            width: 23px;
                            height: 26px;
                            background: transparent;

                            Rectangle {
                                x: 0px;
                                width: root.wave-bar-width;
                                height: 3px + root.wave-0 * 12px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 1.25px;
                                background: #FFFFFF;
                            }
                            Rectangle {
                                x: 5px;
                                width: root.wave-bar-width;
                                height: 3px + root.wave-1 * 12px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 1.25px;
                                background: #FFFFFF;
                            }
                            Rectangle {
                                x: 10px;
                                width: root.wave-bar-width;
                                height: 3px + root.wave-2 * 12px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 1.25px;
                                background: #FFFFFF;
                            }
                            Rectangle {
                                x: 15px;
                                width: root.wave-bar-width;
                                height: 3px + root.wave-3 * 12px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 1.25px;
                                background: #FFFFFF;
                            }
                            Rectangle {
                                x: 20px;
                                width: root.wave-bar-width;
                                height: 3px + root.wave-4 * 12px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 1.25px;
                                background: #FFFFFF;
                            }
                        }
                    }
                }

                // --- Page card -------------------------------------------------
                Rectangle {
                    vertical-stretch: 1;
                    background: @linear-gradient(145deg, #111116 0%, #09090D 100%);
                    border-radius: 13px;
                    border-width: 1px;
                    border-color: #FFFFFF14;
                    clip: true;

                    // Subtle ambient watermark that never obscures action buttons
                    Image {
                        width: 140px;
                        height: 140px;
                        x: parent.width - 86px;
                        y: -44px;
                        source: root.mascot;
                        image-fit: contain;
                        opacity: 0.06;
                    }

                    // Animated stage container for smooth crossfade + upward glide on page switch
                    Rectangle {
                        x: 0px;
                        y: (1.0 - root.page-fade) * 5px;
                        width: parent.width;
                        height: parent.height;
                        opacity: root.page-fade;
                        background: transparent;
                        animate opacity {
                            duration: root.page-fade > 0.5 ? 170ms : 0ms;
                            easing: ease-out;
                        }
                        animate y {
                            duration: root.page-fade > 0.5 ? 170ms : 0ms;
                            easing: ease-out;
                        }

                        // --- Music page (Standard View) ---------------------------
                        if root.active-page == 0 && !root.lyrics-enabled: VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            alignment: space-between;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 9px;
                            padding-bottom: 8px;
                            spacing: 4px;

                            // Album art, track identity and open-source button.
                            HorizontalLayout {
                                height: 64px;
                                spacing: 12px;

                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    border-radius: 13px;
                                    border-width: 1px;
                                    border-color: #FFFFFF14;
                                    clip: true;
                                    background: @linear-gradient(135deg, #1F2937 0%, #0B0B0E 100%);

                                    if root.has-album-art: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.album-art;
                                        image-fit: cover;
                                    }
                                    if !root.has-album-art: Image {
                                        width: 38px;
                                        height: 38px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: root.mascot;
                                        image-fit: contain;
                                        opacity: 0.35;
                                    }
                                }

                                VerticalLayout {
                                    vertical-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: root.track-title;
                                        color: #FFFFFF;
                                        font-size: 15.5px;
                                        font-weight: 700;
                                        overflow: TextOverflow.elide;
                                    }
                                    Text {
                                        text: root.track-subtitle;
                                        color: #9CA3AF;
                                        font-size: 11.5px;
                                        font-weight: 400;
                                        overflow: TextOverflow.elide;
                                    }
                                }

                                Rectangle {
                                    width: 30px;
                                    height: 64px;
                                    background: transparent;

                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 14px;
                                        background: open-source-touch.has-hover ? #32323A : (root.media-available ? #232329 : #18181C);
                                        border-width: 1px;
                                        border-color: open-source-touch.has-hover ? #FFFFFF28 : #FFFFFF10;
                                        animate background {
                                            duration: 140ms;
                                            easing: ease-out;
                                        }

                                        Path {
                                            width: 8px;
                                            height: 12px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 8;
                                            viewbox-height: 12;
                                            fill: transparent;
                                            stroke: root.media-available ? #F3F4F6 : #4B5563;
                                            stroke-width: 1.6px;
                                            stroke-line-cap: round;
                                            MoveTo { x: 2; y: 1; }
                                            LineTo { x: 6; y: 6; }
                                            LineTo { x: 2; y: 11; }
                                        }

                                        open-source-touch := TouchArea {
                                            mouse-cursor: root.media-available ? pointer : default;
                                            clicked => {
                                                root.media-open-source();
                                            }
                                        }
                                    }
                                }
                            }

                            // Timeline: elapsed, seek bar, remaining.
                            HorizontalLayout {
                                height: 16px;
                                spacing: 8px;

                                Text {
                                    text: root.elapsed-text;
                                    color: #D1D5DB;
                                    font-size: 10.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        height: (seek-touch.has-hover || root.seek-dragging) ? 6px : 4px;
                                        border-radius: self.height / 2;
                                        background: #272730;
                                        animate height {
                                            duration: 120ms;
                                            easing: ease-out;
                                        }

                                        Rectangle {
                                            width: parent.width * root.seek-fraction;
                                            height: parent.height;
                                            border-radius: parent.border-radius;
                                            background: @linear-gradient(90deg, #00F0FF 0%, #FFFFFF 100%);
                                        }

                                        if root.seek-enabled: Rectangle {
                                            x: clamp(parent.width * root.seek-fraction - 5px, 0px, parent.width - 10px);
                                            y: (parent.height - 10px) / 2;
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: #FFFFFF;
                                            border-width: 2px;
                                            border-color: #09090D;
                                        }
                                    }

                                    seek-touch := TouchArea {
                                        mouse-cursor: root.seek-enabled ? pointer : default;
                                        pointer-event(e) => {
                                            if (root.seek-enabled) {
                                                if (e.kind == PointerEventKind.down) {
                                                    root.seek-dragging = true;
                                                    root.media-seek-start();
                                                    root.media-seek-preview((seek-touch.mouse-x / 1px) / (seek-touch.width / 1px));
                                                }
                                                if (e.kind == PointerEventKind.move && root.seek-dragging) {
                                                    root.media-seek-preview((seek-touch.mouse-x / 1px) / (seek-touch.width / 1px));
                                                }
                                                if (e.kind == PointerEventKind.up && root.seek-dragging) {
                                                    root.seek-dragging = false;
                                                    root.media-seek-commit((seek-touch.mouse-x / 1px) / (seek-touch.width / 1px));
                                                }
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.remaining-text;
                                    color: #9CA3AF;
                                    font-size: 10.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }

                            // Controls: lyrics toggle pill, previous, play/pause, next, status pill.
                            HorizontalLayout {
                                height: 30px;
                                spacing: 0px;

                                // Clear Lyrics pill button
                                Rectangle {
                                    width: 72px;
                                    height: 26px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 13px;
                                    border-width: 1px;
                                    border-color: root.lyrics-enabled ? #00F0FF88 : (lyrics-btn-touch.has-hover ? #FFFFFF33 : #FFFFFF18);
                                    background: root.lyrics-enabled ? #00F0FF22 : (lyrics-btn-touch.has-hover ? #FFFFFF12 : #16161C);
                                    animate background {
                                        duration: 140ms;
                                        easing: ease-out;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;

                                        Rectangle {
                                            width: 14px;
                                            height: 12px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: root.lyrics-enabled ? #00F0FF : #D1D5DB;
                                            background: transparent;

                                            for dot in 3: Rectangle {
                                                width: 1.5px;
                                                height: 1.5px;
                                                border-radius: 0.75px;
                                                x: 3px + dot * 3px;
                                                y: 5px;
                                                background: root.lyrics-enabled ? #00F0FF : #D1D5DB;
                                            }
                                        }

                                        Text {
                                            text: "Lyrics";
                                            color: root.lyrics-enabled ? #00F0FF : #E5E7EB;
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    lyrics-btn-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.lyrics-toggle();
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: 30px;
                                        spacing: 14px;
                                        alignment: center;

                                        // Previous.
                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 14px;
                                            background: prev-touch.has-hover && root.can-skip-previous ? #FFFFFF14 : transparent;

                                            Path {
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 18;
                                                viewbox-height: 18;
                                                fill: root.can-skip-previous ? #FFFFFF : #4B5563;
                                                stroke: transparent;
                                                MoveTo { x: 4; y: 3; }
                                                LineTo { x: 6.2; y: 3; }
                                                LineTo { x: 6.2; y: 15; }
                                                LineTo { x: 4; y: 15; }
                                                Close {}
                                                MoveTo { x: 14.5; y: 3.5; }
                                                LineTo { x: 7.2; y: 9; }
                                                LineTo { x: 14.5; y: 14.5; }
                                                Close {}
                                            }

                                            prev-touch := TouchArea {
                                                mouse-cursor: root.can-skip-previous ? pointer : default;
                                                clicked => {
                                                    if (root.can-skip-previous) {
                                                        root.media-previous();
                                                    }
                                                }
                                            }
                                        }

                                        // Play / pause circular primary button.
                                        Rectangle {
                                            width: 30px;
                                            height: 30px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 15px;
                                            background: play-touch.has-hover ? #00F0FF : #FFFFFF;
                                            animate background {
                                                duration: 140ms;
                                                easing: ease-out;
                                            }

                                            if root.media-playing: Rectangle {
                                                x: 9px;
                                                y: 8px;
                                                width: 3.5px;
                                                height: 14px;
                                                border-radius: 1.5px;
                                                background: #09090D;
                                            }
                                            if root.media-playing: Rectangle {
                                                x: 17.5px;
                                                y: 8px;
                                                width: 3.5px;
                                                height: 14px;
                                                border-radius: 1.5px;
                                                background: #09090D;
                                            }

                                            if !root.media-playing: Path {
                                                width: 14px;
                                                height: 14px;
                                                x: 9px;
                                                y: 8px;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 18;
                                                viewbox-height: 18;
                                                fill: #09090D;
                                                stroke: transparent;
                                                MoveTo { x: 5; y: 2.5; }
                                                LineTo { x: 15; y: 9; }
                                                LineTo { x: 5; y: 15.5; }
                                                Close {}
                                            }

                                            play-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.media-play-pause();
                                                }
                                            }
                                        }

                                        // Next.
                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 14px;
                                            background: next-touch.has-hover && root.can-skip-next ? #FFFFFF14 : transparent;

                                            Path {
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 18;
                                                viewbox-height: 18;
                                                fill: root.can-skip-next ? #FFFFFF : #4B5563;
                                                stroke: transparent;
                                                MoveTo { x: 11.8; y: 3; }
                                                LineTo { x: 14; y: 3; }
                                                LineTo { x: 14; y: 15; }
                                                LineTo { x: 11.8; y: 15; }
                                                Close {}
                                                MoveTo { x: 3.5; y: 3.5; }
                                                LineTo { x: 10.8; y: 9; }
                                                LineTo { x: 3.5; y: 14.5; }
                                                Close {}
                                            }

                                            next-touch := TouchArea {
                                                mouse-cursor: root.can-skip-next ? pointer : default;
                                                clicked => {
                                                    if (root.can-skip-next) {
                                                        root.media-next();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Right balance: playback status pill
                                Rectangle {
                                    width: 72px;
                                    height: 22px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 11px;
                                    background: root.media-playing ? #10B98118 : #FFFFFF08;
                                    border-width: 1px;
                                    border-color: root.media-playing ? #10B98144 : #FFFFFF10;

                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: root.media-playing ? "● Live" : (root.media-available ? "Paused" : "Idle");
                                        color: root.media-playing ? #34D399 : #6B7280;
                                        font-size: 9px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // --- Music page (Widened Synced Lyrics View) ----
                        if root.active-page == 0 && root.lyrics-enabled: HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 9px;
                            padding-bottom: 8px;
                            spacing: 12px;

                            // Left Column: Compact Player (224px)
                            VerticalLayout {
                                width: 224px;
                                alignment: space-between;
                                spacing: 4px;

                                // Mini track info (54px)
                                HorizontalLayout {
                                    height: 54px;
                                    spacing: 9px;

                                    Rectangle {
                                        width: 54px;
                                        height: 54px;
                                        border-radius: 11px;
                                        border-width: 1px;
                                        border-color: #FFFFFF14;
                                        clip: true;
                                        background: @linear-gradient(135deg, #1F2937 0%, #0B0B0E 100%);

                                        if root.has-album-art: Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: root.album-art;
                                            image-fit: cover;
                                        }

                                        if !root.has-album-art: Image {
                                            width: 30px;
                                            height: 30px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: root.mascot;
                                            image-fit: contain;
                                            opacity: 0.35;
                                        }
                                    }

                                    VerticalLayout {
                                        vertical-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: root.track-title;
                                            color: #FFFFFF;
                                            font-size: 13.5px;
                                            font-weight: 700;
                                            overflow: TextOverflow.elide;
                                        }

                                        Text {
                                            text: root.track-subtitle;
                                            color: #9CA3AF;
                                            font-size: 10.5px;
                                            font-weight: 400;
                                            overflow: TextOverflow.elide;
                                        }
                                    }
                                }

                                // Interactive Compact timeline
                                HorizontalLayout {
                                    height: 14px;
                                    spacing: 6px;

                                    Text {
                                        text: root.elapsed-text;
                                        color: #D1D5DB;
                                        font-size: 9.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: transparent;

                                        Rectangle {
                                            x: 0;
                                            y: (parent.height - self.height) / 2;
                                            width: parent.width;
                                            height: (lyrics-seek-touch.has-hover || root.seek-dragging) ? 5px : 3.5px;
                                            border-radius: self.height / 2;
                                            background: #272730;

                                            Rectangle {
                                                width: parent.width * root.seek-fraction;
                                                height: parent.height;
                                                border-radius: parent.border-radius;
                                                background: @linear-gradient(90deg, #00F0FF 0%, #FFFFFF 100%);
                                            }
                                        }

                                        lyrics-seek-touch := TouchArea {
                                            mouse-cursor: root.seek-enabled ? pointer : default;
                                            pointer-event(e) => {
                                                if (root.seek-enabled) {
                                                    if (e.kind == PointerEventKind.down) {
                                                        root.seek-dragging = true;
                                                        root.media-seek-start();
                                                        root.media-seek-preview((lyrics-seek-touch.mouse-x / 1px) / (lyrics-seek-touch.width / 1px));
                                                    }
                                                    if (e.kind == PointerEventKind.move && root.seek-dragging) {
                                                        root.media-seek-preview((lyrics-seek-touch.mouse-x / 1px) / (lyrics-seek-touch.width / 1px));
                                                    }
                                                    if (e.kind == PointerEventKind.up && root.seek-dragging) {
                                                        root.seek-dragging = false;
                                                        root.media-seek-commit((lyrics-seek-touch.mouse-x / 1px) / (lyrics-seek-touch.width / 1px));
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.remaining-text;
                                        color: #9CA3AF;
                                        font-size: 9.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                }

                                // Compact controls: lyrics toggle (active), prev, play/pause, next
                                HorizontalLayout {
                                    height: 26px;
                                    alignment: space-between;

                                    // Lyrics toggle (active pill)
                                    Rectangle {
                                        width: 62px;
                                        height: 24px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 12px;
                                        background: #00F0FF22;
                                        border-width: 1px;
                                        border-color: #00F0FF88;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "● Lyrics";
                                            color: #00F0FF;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.lyrics-toggle();
                                            }
                                        }
                                    }

                                    // Playback controls
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: center;

                                        // Prev
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 12px;
                                            background: lyr-prev-touch.has-hover && root.can-skip-previous ? #FFFFFF14 : transparent;
                                            y: (parent.height - self.height) / 2;

                                            Path {
                                                width: 14px;
                                                height: 14px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 18;
                                                viewbox-height: 18;
                                                fill: root.can-skip-previous ? #FFFFFF : #4B5563;
                                                MoveTo { x: 3; y: 3; }
                                                LineTo { x: 5; y: 3; }
                                                LineTo { x: 5; y: 15; }
                                                LineTo { x: 3; y: 15; }
                                                Close {}
                                                MoveTo { x: 15; y: 3; }
                                                LineTo { x: 6; y: 9; }
                                                LineTo { x: 15; y: 15; }
                                                Close {}
                                            }

                                            lyr-prev-touch := TouchArea {
                                                mouse-cursor: root.can-skip-previous ? pointer : default;
                                                clicked => {
                                                    if (root.can-skip-previous) {
                                                        root.media-previous();
                                                    }
                                                }
                                            }
                                        }

                                        // Play/Pause
                                        Rectangle {
                                            width: 26px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: lyr-play-touch.has-hover ? #00F0FF : (root.media-available ? #FFFFFF : #374151);

                                            if root.media-playing: Path {
                                                width: 10px;
                                                height: 10px;
                                                x: 8px;
                                                y: 8px;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 10;
                                                viewbox-height: 10;
                                                fill: #0B0B0E;
                                                MoveTo { x: 1; y: 0; }
                                                LineTo { x: 4; y: 0; }
                                                LineTo { x: 4; y: 10; }
                                                LineTo { x: 1; y: 10; }
                                                Close {}
                                                MoveTo { x: 6; y: 0; }
                                                LineTo { x: 9; y: 0; }
                                                LineTo { x: 9; y: 10; }
                                                LineTo { x: 6; y: 10; }
                                                Close {}
                                            }

                                            if !root.media-playing: Path {
                                                width: 10px;
                                                height: 10px;
                                                x: 9px;
                                                y: 8px;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 10;
                                                viewbox-height: 10;
                                                fill: #0B0B0E;
                                                MoveTo { x: 1; y: 0; }
                                                LineTo { x: 9; y: 5; }
                                                LineTo { x: 1; y: 10; }
                                                Close {}
                                            }

                                            lyr-play-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if (root.media-available) {
                                                        root.media-play-pause();
                                                    }
                                                }
                                            }
                                        }

                                        // Next
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 12px;
                                            background: lyr-next-touch.has-hover && root.can-skip-next ? #FFFFFF14 : transparent;
                                            y: (parent.height - self.height) / 2;

                                            Path {
                                                width: 14px;
                                                height: 14px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 18;
                                                viewbox-height: 18;
                                                fill: root.can-skip-next ? #FFFFFF : #4B5563;
                                                MoveTo { x: 3; y: 3; }
                                                LineTo { x: 12; y: 9; }
                                                LineTo { x: 3; y: 15; }
                                                Close {}
                                                MoveTo { x: 13; y: 3; }
                                                LineTo { x: 15; y: 3; }
                                                LineTo { x: 15; y: 15; }
                                                LineTo { x: 13; y: 15; }
                                                Close {}
                                            }

                                            lyr-next-touch := TouchArea {
                                                mouse-cursor: root.can-skip-next ? pointer : default;
                                                clicked => {
                                                    if (root.can-skip-next) {
                                                        root.media-next();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Divider (1px vertical line)
                            Rectangle {
                                width: 1px;
                                height: parent.height - 8px;
                                y: 4px;
                                background: #FFFFFF1A;
                            }

                            // Right Column: Live Synced Lyrics Viewport
                            lyrics-viewport := Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                                clip: true;

                                VerticalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    alignment: center;
                                    spacing: 6px;
                                    padding-left: 6px;
                                    padding-right: 6px;

                                    if root.lyrics-available: VerticalLayout {
                                        spacing: 5px;
                                        alignment: center;

                                        Text {
                                            text: root.lyrics-line-prev;
                                            color: #64748B;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            overflow: TextOverflow.elide;
                                            horizontal-alignment: left;
                                        }

                                        Rectangle {
                                            height: 28px;
                                            border-radius: 8px;
                                            background: #FFFFFF0A;
                                            border-width: 1px;
                                            border-color: #FFFFFF12;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 7px;
                                                alignment: start;

                                                Rectangle {
                                                    width: 3px;
                                                    height: 14px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 1.5px;
                                                    background: #00F0FF;
                                                }

                                                Text {
                                                    text: root.lyrics-line-curr;
                                                    color: #FFFFFF;
                                                    font-size: 14.5px;
                                                    font-weight: 700;
                                                    overflow: TextOverflow.elide;
                                                    horizontal-alignment: left;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.lyrics-line-next;
                                            color: #64748B;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            overflow: TextOverflow.elide;
                                            horizontal-alignment: left;
                                        }
                                    }

                                    if !root.lyrics-available: VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Text {
                                            text: root.lyrics-line-curr;
                                            color: #64748B;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // --- Focus page (Sprint 5) --------------------------------
                        if root.active-page == 1: HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 16px;

                            // Left: Countdown ring (108 x 108 centered vertically)
                            Rectangle {
                                width: 108px;
                                height: parent.height;
                                background: transparent;

                                Rectangle {
                                    width: 108px;
                                    height: 108px;
                                    y: (parent.height - self.height) / 2;
                                    background: transparent;

                                    Path {
                                        width: parent.width;
                                        height: parent.height;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 88;
                                        viewbox-height: 88;
                                        fill: transparent;
                                        stroke: #1F2937;
                                        stroke-width: 6px;
                                        MoveTo { x: 44; y: 7; }
                                        ArcTo {
                                            radius-x: 37;
                                            radius-y: 37;
                                            large-arc: false;
                                            sweep: true;
                                            x: 44;
                                            y: 81;
                                        }
                                        ArcTo {
                                            radius-x: 37;
                                            radius-y: 37;
                                            large-arc: false;
                                            sweep: true;
                                            x: 44;
                                            y: 7;
                                        }
                                    }

                                    if root.focus-progress > 0.002 && root.focus-progress < 0.999: progress-arc := Path {
                                        private property <float> arc-deg: root.focus-progress * 360;
                                        private property <angle> arc-angle: (self.arc-deg - 90) * 1deg;
                                        private property <float> arc-x: 44 + 37 * Math.cos(self.arc-angle);
                                        private property <float> arc-y: 44 + 37 * Math.sin(self.arc-angle);
                                        width: parent.width;
                                        height: parent.height;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 88;
                                        viewbox-height: 88;
                                        fill: transparent;
                                        stroke: root.focus-celebrate ? #10B981 : #00F0FF;
                                        stroke-width: 6px;
                                        stroke-line-cap: round;
                                        MoveTo { x: 44; y: 7; }
                                        ArcTo {
                                            radius-x: 37;
                                            radius-y: 37;
                                            large-arc: progress-arc.arc-deg > 180;
                                            sweep: true;
                                            x: progress-arc.arc-x;
                                            y: progress-arc.arc-y;
                                        }
                                    }

                                    if root.focus-progress >= 0.999: Path {
                                        width: parent.width;
                                        height: parent.height;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 88;
                                        viewbox-height: 88;
                                        fill: transparent;
                                        stroke: #00F0FF;
                                        stroke-width: 6px;
                                        MoveTo { x: 44; y: 7; }
                                        ArcTo {
                                            radius-x: 37;
                                            radius-y: 37;
                                            large-arc: false;
                                            sweep: true;
                                            x: 44;
                                            y: 81;
                                        }
                                        ArcTo {
                                            radius-x: 37;
                                            radius-y: 37;
                                            large-arc: false;
                                            sweep: true;
                                            x: 44;
                                            y: 7;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;

                                        Text {
                                            text: root.focus-remaining;
                                            color: #FFFFFF;
                                            font-size: 21px;
                                            font-weight: 700;
                                            letter-spacing: 0.5px;
                                            horizontal-alignment: center;
                                        }

                                        Text {
                                            text: root.focus-running ? "ACTIVE" : "READY";
                                            color: root.focus-running ? #00F0FF : #6B7280;
                                            font-size: 7.5px;
                                            font-weight: 700;
                                            letter-spacing: 1px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Right: Session status, transport buttons, and evenly-spaced presets
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: space-between;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 8px;

                                // Row 1: Session label + completed counter badge
                                HorizontalLayout {
                                    height: 20px;
                                    spacing: 8px;

                                    Text {
                                        text: root.focus-session;
                                        color: root.focus-celebrate ? #00F0FF : #F3F4F6;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        animate color {
                                            duration: 220ms;
                                            easing: ease-out;
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: transparent;
                                    }

                                    Rectangle {
                                        width: 96px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: #FFFFFF08;
                                        border-width: 1px;
                                        border-color: #FFFFFF12;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "✓ \{root.focus-completed} done today";
                                            color: #9CA3AF;
                                            font-size: 8.5px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Row 2: Start/Pause (stretch), Reset, -5m, +5m
                                HorizontalLayout {
                                    height: 34px;
                                    spacing: 8px;

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        border-radius: 10px;
                                        background: root.focus-running ? (focus-start-touch.has-hover ? #283548 : #1F2937) : (focus-start-touch.has-hover ? #38F6FF : #00F0FF);
                                        border-width: 1px;
                                        border-color: root.focus-running ? #00F0FF55 : transparent;
                                        animate background {
                                            duration: 140ms;
                                            easing: ease-out;
                                        }

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: root.focus-running ? "Pause Session" : "Start Focus";
                                            color: root.focus-running ? #00F0FF : #041014;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        focus-start-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.focus-toggle();
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 68px;
                                        height: 34px;
                                        border-radius: 10px;
                                        background: focus-reset-touch.has-hover ? #283140 : #1B222D;
                                        border-width: 1px;
                                        border-color: focus-reset-touch.has-hover ? #FFFFFF28 : #FFFFFF12;
                                        animate background {
                                            duration: 140ms;
                                            easing: ease-out;
                                        }

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "Reset";
                                            color: focus-reset-touch.has-hover ? #FFFFFF : #D1D5DB;
                                            font-size: 10px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        focus-reset-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.focus-reset();
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 36px;
                                        height: 34px;
                                        border-radius: 10px;
                                        background: focus-minus-touch.has-hover ? #FFFFFF14 : #16161C;
                                        border-width: 1px;
                                        border-color: focus-minus-touch.has-hover ? #FFFFFF28 : #FFFFFF12;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "-5m";
                                            color: focus-minus-touch.has-hover ? #FFFFFF : #9CA3AF;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        focus-minus-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.focus-adjust(-5);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 36px;
                                        height: 34px;
                                        border-radius: 10px;
                                        background: focus-plus-touch.has-hover ? #FFFFFF14 : #16161C;
                                        border-width: 1px;
                                        border-color: focus-plus-touch.has-hover ? #FFFFFF28 : #FFFFFF12;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "+5m";
                                            color: focus-plus-touch.has-hover ? #FFFFFF : #9CA3AF;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        focus-plus-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.focus-adjust(5);
                                            }
                                        }
                                    }
                                }

                                // Row 3: 4 evenly-stretched preset pills
                                HorizontalLayout {
                                    height: 26px;
                                    spacing: 8px;

                                    for preset in root.focus-presets: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 26px;
                                        border-radius: 9px;
                                        background: root.focus-minutes == preset ? #00F0FF22 : (preset-touch.has-hover ? #FFFFFF12 : #FFFFFF07);
                                        border-width: 1px;
                                        border-color: root.focus-minutes == preset ? #00F0FF88 : (preset-touch.has-hover ? #FFFFFF24 : #FFFFFF12);
                                        animate background {
                                            duration: 140ms;
                                            easing: ease-out;
                                        }

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "\{preset} min";
                                            color: root.focus-minutes == preset ? #00F0FF : (preset-touch.has-hover ? #FFFFFF : #9CA3AF);
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        preset-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.focus-preset(preset);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // --- Water page (Sprint 5) --------------------------------
                        if root.active-page == 2: HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 16px;

                            // Left: Liquid tank with animated wave surface + summary inside
                            Rectangle {
                                width: 196px;
                                height: parent.height;
                                border-radius: 12px;
                                clip: true;
                                background: @linear-gradient(180deg, #0B1220 0%, #060B12 100%);
                                border-width: 1px;
                                border-color: #00F0FF2E;

                                Rectangle {
                                    width: parent.width;
                                    height: root.water-progress * parent.height;
                                    y: parent.height - self.height;
                                    background: @linear-gradient(180deg, #00F0FF44 0%, #0284C766 55%, #0E7490AA 100%);
                                    animate height {
                                        duration: 320ms;
                                        easing: ease-out;
                                    }
                                }

                                // Moving surface wave crest
                                Rectangle {
                                    width: parent.width;
                                    height: root.water-progress * parent.height;
                                    y: parent.height - self.height;
                                    clip: true;
                                    background: transparent;

                                    Path {
                                        x: -root.water-phase * 98px;
                                        y: 0px;
                                        width: parent.width + 98px;
                                        height: 14px;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 188;
                                        viewbox-height: 14;
                                        fill: #00F0FF66;
                                        MoveTo { x: 0; y: 7; }
                                        CubicTo {
                                            control-1-x: 12;
                                            control-1-y: 0;
                                            control-2-x: 35;
                                            control-2-y: 14;
                                            x: 47;
                                            y: 7;
                                        }
                                        CubicTo {
                                            control-1-x: 59;
                                            control-1-y: 0;
                                            control-2-x: 82;
                                            control-2-y: 14;
                                            x: 94;
                                            y: 7;
                                        }
                                        CubicTo {
                                            control-1-x: 106;
                                            control-1-y: 0;
                                            control-2-x: 129;
                                            control-2-y: 14;
                                            x: 141;
                                            y: 7;
                                        }
                                        CubicTo {
                                            control-1-x: 153;
                                            control-1-y: 0;
                                            control-2-x: 176;
                                            control-2-y: 14;
                                            x: 188;
                                            y: 7;
                                        }
                                        LineTo { x: 188; y: 14; }
                                        LineTo { x: 0; y: 14; }
                                        Close {}
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: root.water-percent;
                                        color: #FFFFFF;
                                        font-size: 24px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: root.water-summary;
                                        color: #BAE6FD;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // Right: Hydration controls stretched across available width
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: space-between;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 8px;

                                // Top status row
                                HorizontalLayout {
                                    height: 20px;
                                    spacing: 8px;

                                    Text {
                                        text: root.water-nudge ? "Time for a glass of water!" : "Quick Add Intake";
                                        color: root.water-nudge ? #38BDF8 : #F3F4F6;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: transparent;
                                    }

                                    Rectangle {
                                        width: 104px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: root.water-nudge ? #0EA5E924 : #FFFFFF08;
                                        border-width: 1px;
                                        border-color: root.water-nudge ? #38BDF866 : #FFFFFF12;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "Goal: \{root.water-goal} ml";
                                            color: root.water-nudge ? #7DD3FC : #9CA3AF;
                                            font-size: 8.5px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Middle: 3 evenly stretched intake buttons
                                HorizontalLayout {
                                    height: 38px;
                                    spacing: 8px;

                                    for amount in root.water-presets: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 38px;
                                        border-radius: 10px;
                                        background: water-btn-touch.has-hover ? #0EA5E938 : #0EA5E91F;
                                        border-width: 1px;
                                        border-color: water-btn-touch.has-hover ? #00F0FF88 : #00F0FF38;
                                        animate background {
                                            duration: 140ms;
                                            easing: ease-out;
                                        }

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "+\{amount} ml";
                                            color: water-btn-touch.has-hover ? #FFFFFF : #7DD3FC;
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        water-btn-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.water-add(amount);
                                            }
                                        }
                                    }
                                }

                                // Bottom: Full-width Undo button
                                Rectangle {
                                    height: 28px;
                                    border-radius: 9px;
                                    background: (undo-touch.has-hover && root.water-can-undo) ? #FFFFFF14 : #FFFFFF08;
                                    border-width: 1px;
                                    border-color: (undo-touch.has-hover && root.water-can-undo) ? #FFFFFF28 : #FFFFFF12;
                                    opacity: root.water-can-undo ? 1.0 : 0.38;
                                    animate background {
                                        duration: 140ms;
                                        easing: ease-out;
                                    }

                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "↶ Undo last glass";
                                        color: root.water-can-undo ? #D1D5DB : #6B7280;
                                        font-size: 9.5px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    undo-touch := TouchArea {
                                        mouse-cursor: root.water-can-undo ? pointer : default;
                                        clicked => {
                                            if (root.water-can-undo) {
                                                root.water-undo();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // --- Shelf page (Sprint 4) --------------------------------
                        if root.active-page == 3: VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            // Toolbar: item count + Clear capsule.
                            HorizontalLayout {
                                height: 20px;
                                spacing: 8px;

                                Text {
                                    text: root.shelf-summary;
                                    color: #9CA3AF;
                                    font-size: 9.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: TextOverflow.elide;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                Rectangle {
                                    width: 58px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: (shelf-clear-touch.has-hover && root.shelf-total > 0) ? #EF444428 : #1F2937;
                                    border-width: 1px;
                                    border-color: (shelf-clear-touch.has-hover && root.shelf-total > 0) ? #F8717166 : #FFFFFF12;
                                    opacity: root.shelf-total > 0 ? 1.0 : 0.35;

                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "Clear";
                                        color: (shelf-clear-touch.has-hover && root.shelf-total > 0) ? #FCA5A5 : #D1D5DB;
                                        font-size: 8.5px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    shelf-clear-touch := TouchArea {
                                        mouse-cursor: root.shelf-total > 0 ? pointer : default;
                                        clicked => {
                                            if (root.shelf-total > 0) {
                                                root.shelf-clear();
                                            }
                                        }
                                    }
                                }
                            }

                            // Carousel: < [items] >.
                            HorizontalLayout {
                                vertical-stretch: 1;
                                spacing: 6px;

                                // Previous page.
                                Rectangle {
                                    width: 28px;
                                    background: transparent;

                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 14px;
                                        background: (shelf-prev-touch.has-hover && root.shelf-can-prev) ? #374151 : #222228;
                                        border-width: 1px;
                                        border-color: #FFFFFF14;
                                        opacity: root.shelf-can-prev ? 1.0 : 0.35;

                                        Path {
                                            width: 7px;
                                            height: 11px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 7;
                                            viewbox-height: 11;
                                            fill: transparent;
                                            stroke: root.shelf-can-prev ? #E5E7EB : #4B5563;
                                            stroke-width: 1.6px;
                                            stroke-line-cap: round;
                                            MoveTo { x: 5.5; y: 1; }
                                            LineTo { x: 1.5; y: 5.5; }
                                            LineTo { x: 5.5; y: 10; }
                                        }

                                        shelf-prev-touch := TouchArea {
                                            mouse-cursor: root.shelf-can-prev ? pointer : default;
                                            clicked => {
                                                if (root.shelf-can-prev) {
                                                    root.shelf-nav(-1);
                                                }
                                            }
                                        }
                                    }
                                }

                                // Viewport: empty state or the visible carousel slice.
                                Rectangle {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    background: transparent;

                                    if root.shelf-total == 0: Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 10px;
                                        background: root.shelf-drag-active ? #00F0FF14 : #FFFFFF06;
                                        border-width: 1px;
                                        border-color: root.shelf-drag-active ? #00F0FF88 : #FFFFFF14;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;

                                            Rectangle {
                                                height: 27px;
                                                background: transparent;

                                                Path {
                                                    width: 34px;
                                                    height: 27px;
                                                    x: (parent.width - self.width) / 2;
                                                    viewbox-x: 0;
                                                    viewbox-y: 0;
                                                    viewbox-width: 34;
                                                    viewbox-height: 27;
                                                    fill: transparent;
                                                    stroke: root.shelf-drag-active ? #00F0FF : #6B7280;
                                                    stroke-width: 1.6px;
                                                    stroke-line-cap: round;
                                                    MoveTo { x: 2; y: 6; }
                                                    LineTo { x: 11; y: 6; }
                                                    LineTo { x: 14; y: 9; }
                                                    LineTo { x: 32; y: 9; }
                                                    LineTo { x: 32; y: 25; }
                                                    LineTo { x: 2; y: 25; }
                                                    Close {}
                                                }
                                            }

                                            Text {
                                                text: root.shelf-drag-active ? "Release to add to Shelf" : "Drag files or folders here";
                                                color: root.shelf-drag-active ? #00F0FF : #D1D5DB;
                                                font-size: 11px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                            }

                                            Text {
                                                text: "Drop from Explorer · click item to open";
                                                color: #6B7280;
                                                font-size: 8.5px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    if root.shelf-total > 0: HorizontalLayout {
                                        width: parent.width;
                                        height: 92px;
                                        y: (parent.height - self.height) / 2;
                                        alignment: center;
                                        spacing: 6px;

                                        for item in root.shelf-items: Rectangle {
                                            width: 88px;
                                            height: 92px;
                                            border-radius: 10px;
                                            background: item-touch.has-hover ? #FFFFFF0C : transparent;
                                            border-width: 1px;
                                            border-color: item-touch.has-hover ? #FFFFFF1F : transparent;
                                            opacity: (item.missing ? 0.45 : 1.0) * root.shelf-fade;
                                            animate opacity {
                                                duration: 160ms;
                                                easing: ease-out;
                                            }

                                            // 54 px preview: real thumbnail, folder or file icon.
                                            Rectangle {
                                                width: 54px;
                                                height: 54px;
                                                x: (parent.width - self.width) / 2;
                                                y: 4px;
                                                border-radius: 11px;
                                                clip: true;
                                                background: @linear-gradient(135deg, #1F2937 0%, #0B0B0E 100%);

                                                if item.has-thumbnail: Image {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    source: item.thumbnail;
                                                    image-fit: cover;
                                                }

                                                if !item.has-thumbnail && item.is-directory: Path {
                                                    width: 32px;
                                                    height: 26px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    viewbox-x: 0;
                                                    viewbox-y: 0;
                                                    viewbox-width: 32;
                                                    viewbox-height: 26;
                                                    fill: #FBBF24;
                                                    stroke: transparent;
                                                    MoveTo { x: 1; y: 5; }
                                                    LineTo { x: 11; y: 5; }
                                                    LineTo { x: 14; y: 8; }
                                                    LineTo { x: 31; y: 8; }
                                                    LineTo { x: 31; y: 25; }
                                                    LineTo { x: 1; y: 25; }
                                                    Close {}
                                                }

                                                if !item.has-thumbnail && !item.is-directory: Path {
                                                    width: 24px;
                                                    height: 30px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    viewbox-x: 0;
                                                    viewbox-y: 0;
                                                    viewbox-width: 24;
                                                    viewbox-height: 30;
                                                    fill: #60A5FA;
                                                    stroke: transparent;
                                                    MoveTo { x: 2; y: 1; }
                                                    LineTo { x: 15; y: 1; }
                                                    LineTo { x: 22; y: 8; }
                                                    LineTo { x: 22; y: 29; }
                                                    LineTo { x: 2; y: 29; }
                                                    Close {}
                                                }

                                                if !item.has-thumbnail && !item.is-directory: Path {
                                                    width: 7px;
                                                    height: 7px;
                                                    x: (parent.width + 4px) / 2;
                                                    y: (parent.height - 24px) / 2;
                                                    viewbox-x: 0;
                                                    viewbox-y: 0;
                                                    viewbox-width: 7;
                                                    viewbox-height: 7;
                                                    fill: #93C5FD;
                                                    stroke: transparent;
                                                    MoveTo { x: 0; y: 0; }
                                                    LineTo { x: 7; y: 7; }
                                                    LineTo { x: 0; y: 7; }
                                                    Close {}
                                                }
                                            }

                                            Text {
                                                y: 62px;
                                                height: 13px;
                                                width: parent.width - 8px;
                                                x: 4px;
                                                text: item.name;
                                                color: #F9FAFB;
                                                font-size: 9.5px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: TextOverflow.elide;
                                            }

                                            Text {
                                                y: 75px;
                                                height: 12px;
                                                width: parent.width;
                                                text: item.size-text;
                                                color: item.missing ? #F87171 : #9CA3AF;
                                                font-size: 8px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            item-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.shelf-open(item.index);
                                                }
                                            }

                                            // Remove badge.
                                            Rectangle {
                                                x: parent.width - 19px;
                                                y: 3px;
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 8px;
                                                background: shelf-rm-touch.has-hover ? #EF4444 : #0B0B0EE6;
                                                border-width: 1px;
                                                border-color: shelf-rm-touch.has-hover ? #FCA5A5 : #FFFFFF2E;
                                                opacity: (item-touch.has-hover || shelf-rm-touch.has-hover) ? 1.0 : 0.65;
                                                animate opacity {
                                                    duration: 120ms;
                                                    easing: ease-out;
                                                }

                                                Text {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text: "×";
                                                    color: #FFFFFF;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                shelf-rm-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.shelf-remove(item.index);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Next page.
                                Rectangle {
                                    width: 28px;
                                    background: transparent;

                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 14px;
                                        background: (shelf-next-touch.has-hover && root.shelf-can-next) ? #374151 : #222228;
                                        border-width: 1px;
                                        border-color: #FFFFFF14;
                                        opacity: root.shelf-can-next ? 1.0 : 0.35;

                                        Path {
                                            width: 7px;
                                            height: 11px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 7;
                                            viewbox-height: 11;
                                            fill: transparent;
                                            stroke: root.shelf-can-next ? #E5E7EB : #4B5563;
                                            stroke-width: 1.6px;
                                            stroke-line-cap: round;
                                            MoveTo { x: 1.5; y: 1; }
                                            LineTo { x: 5.5; y: 5.5; }
                                            LineTo { x: 1.5; y: 10; }
                                        }

                                        shelf-next-touch := TouchArea {
                                            mouse-cursor: root.shelf-can-next ? pointer : default;
                                            clicked => {
                                                if (root.shelf-can-next) {
                                                    root.shelf-nav(1);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // --- To-do page (Sprint 5) --------------------------------
                        if root.active-page == 4: VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 5px;

                            // Row 1: Counter + Clear done button (18px)
                            HorizontalLayout {
                                height: 18px;
                                spacing: 8px;

                                Text {
                                    text: root.todo-total == 0 ? "0 tasks — add your first task below" : root.todo-summary;
                                    color: #D1D5DB;
                                    font-size: 9.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                }

                                Rectangle {
                                    width: 68px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: (todo-clear-touch.has-hover && root.todo-done > 0) ? #EF444428 : #1F2937;
                                    border-width: 1px;
                                    border-color: (todo-clear-touch.has-hover && root.todo-done > 0) ? #F8717166 : #FFFFFF12;
                                    opacity: root.todo-done > 0 ? 1.0 : 0.35;

                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "Clear done";
                                        color: (todo-clear-touch.has-hover && root.todo-done > 0) ? #FCA5A5 : #D1D5DB;
                                        font-size: 8.5px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    todo-clear-touch := TouchArea {
                                        mouse-cursor: root.todo-done > 0 ? pointer : default;
                                        clicked => {
                                            if (root.todo-done > 0) {
                                                root.todo-clear-done();
                                            }
                                        }
                                    }
                                }
                            }

                            // Row 2: Flexible checklist viewport (never clips the bottom input bar!)
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                background: transparent;

                                if root.todo-total == 0: Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 10px;
                                    background: #FFFFFF05;
                                    border-width: 1px;
                                    border-color: #FFFFFF10;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 10px;

                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 12px;
                                            background: #10B98114;
                                            border-width: 1px;
                                            border-color: #10B98144;

                                            Path {
                                                width: 10px;
                                                height: 8px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 10;
                                                viewbox-height: 8;
                                                fill: transparent;
                                                stroke: #34D399;
                                                stroke-width: 1.6px;
                                                stroke-line-cap: round;
                                                MoveTo { x: 1.5; y: 4.2; }
                                                LineTo { x: 4; y: 6.5; }
                                                LineTo { x: 8.5; y: 1.5; }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 1px;

                                            Text {
                                                text: "All caught up!";
                                                color: #E5E7EB;
                                                font-size: 10.5px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "Type a task below and press Enter or Add";
                                                color: #6B7280;
                                                font-size: 8.5px;
                                            }
                                        }
                                    }
                                }

                                todo-flick := Flickable {
                                    visible: root.todo-total > 0;
                                    width: parent.width;
                                    height: parent.height;
                                    content-width: parent.width;
                                    content-height: root.todo-total * 26px;
                                    interactive: true;

                                    VerticalLayout {
                                        width: parent.width - (root.todo-total > 3 ? 8px : 0px);
                                        height: root.todo-total * 26px;
                                        spacing: 0px;

                                        for item[i] in root.todo-items: Rectangle {
                                            width: parent.width;
                                            height: 26px;
                                            border-radius: 7px;
                                            background: drag.pressed ? #00F0FF14 : (row-toggle.has-hover ? #FFFFFF08 : transparent);

                                            // Left drag grip handle (⋮⋮) for reordering
                                            Rectangle {
                                                x: 2px;
                                                y: (parent.height - 16px) / 2;
                                                width: 14px;
                                                height: 16px;
                                                background: transparent;

                                                for dot-row in 3: Rectangle {
                                                    y: 3px + dot-row * 4px;
                                                    x: 4px;
                                                    width: 2px;
                                                    height: 2px;
                                                    border-radius: 1px;
                                                    background: drag.has-hover ? #9CA3AF : #4B5563;
                                                }
                                                for dot-row in 3: Rectangle {
                                                    y: 3px + dot-row * 4px;
                                                    x: 8px;
                                                    width: 2px;
                                                    height: 2px;
                                                    border-radius: 1px;
                                                    background: drag.has-hover ? #9CA3AF : #4B5563;
                                                }

                                                drag := TouchArea {
                                                    mouse-cursor: ns-resize;
                                                    pointer-event(event) => {
                                                        if (event.kind == PointerEventKind.up) {
                                                            root.todo-reorder(i, (self.mouse-y - self.pressed-y) / 1px);
                                                            return EventResult.accept;
                                                        }
                                                        return EventResult.reject;
                                                    }
                                                }
                                            }

                                            // Circular checkbox
                                            Rectangle {
                                                x: 20px;
                                                y: (parent.height - self.height) / 2;
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 8px;
                                                border-width: 1.5px;
                                                border-color: item.completed ? #10B981 : (row-toggle.has-hover ? #00F0FF : #6B7280);
                                                background: item.completed ? #10B981 : transparent;

                                                if item.completed: Path {
                                                    width: 8px;
                                                    height: 6px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    viewbox-x: 0;
                                                    viewbox-y: 0;
                                                    viewbox-width: 8;
                                                    viewbox-height: 6;
                                                    fill: transparent;
                                                    stroke: #041014;
                                                    stroke-width: 1.6px;
                                                    stroke-line-cap: round;
                                                    MoveTo { x: 1; y: 3; }
                                                    LineTo { x: 3; y: 5; }
                                                    LineTo { x: 7; y: 1; }
                                                }
                                            }

                                            name := Text {
                                                x: 44px;
                                                width: parent.width - 72px;
                                                height: parent.height;
                                                text: item.text;
                                                color: item.completed ? #6B7280 : #F3F4F6;
                                                font-size: 10.5px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                                overflow: TextOverflow.elide;

                                                animate color {
                                                    duration: 180ms;
                                                    easing: ease-out;
                                                }
                                            }

                                            if item.completed: Rectangle {
                                                x: 44px;
                                                y: (parent.height - self.height) / 2;
                                                width: min(name.preferred-width, name.width);
                                                height: 1px;
                                                background: #6B7280;
                                            }

                                            // Click anywhere on checkbox or text to toggle completion
                                            row-toggle := TouchArea {
                                                x: 18px;
                                                width: parent.width - 44px;
                                                height: parent.height;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.todo-toggle(item.id);
                                                }
                                            }

                                            // Delete task button
                                            Rectangle {
                                                x: parent.width - 22px;
                                                y: (parent.height - self.height) / 2;
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: del-touch.has-hover ? #EF444428 : #FFFFFF08;
                                                border-width: 1px;
                                                border-color: del-touch.has-hover ? #F8717155 : transparent;

                                                Text {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text: "×";
                                                    color: del-touch.has-hover ? #FCA5A5 : #9CA3AF;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                del-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.todo-remove(item.id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Sleek right-side scrollbar indicator when more than 3 tasks exist
                                if root.todo-total > 3: Rectangle {
                                    x: parent.width - 4px;
                                    y: 2px;
                                    width: 3px;
                                    height: parent.height - 4px;
                                    border-radius: 1.5px;
                                    background: #FFFFFF10;

                                    Rectangle {
                                        private property <float> scroll-den: max(1.0, (root.todo-total * 26.0) - (todo-flick.height / 1px));
                                        private property <float> scroll-ratio: clamp((-todo-flick.viewport-y / 1px) / self.scroll-den, 0.0, 1.0);
                                        width: 3px;
                                        height: max(18px, parent.height * (parent.height / (root.todo-total * 26px)));
                                        y: (parent.height - self.height) * self.scroll-ratio;
                                        border-radius: 1.5px;
                                        background: #00F0FF88;
                                    }
                                }
                            }

                            // Row 3: Inline quick-add input bar (28px, fits cleanly inside padded VerticalLayout!)
                            Rectangle {
                                height: 28px;
                                border-radius: 10px;
                                background: root.todo-edit-active ? #00F0FF12 : #16161D;
                                border-width: 1px;
                                border-color: root.todo-edit-active ? #00F0FF66 : #FFFFFF1A;

                                animate border-color {
                                    duration: 160ms;
                                    easing: ease-out;
                                }

                                Text {
                                    x: 11px;
                                    width: 12px;
                                    height: parent.height;
                                    text: "+";
                                    color: #00F0FF;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                todo-input := TextInput {
                                    x: 27px;
                                    width: parent.width - 84px;
                                    height: parent.height;
                                    text <=> root.todo-draft;
                                    single-line: true;
                                    font-size: 10.5px;
                                    color: #FFFFFF;
                                    vertical-alignment: center;
                                    changed has-focus => {
                                        root.todo-edit(todo-input.has-focus);
                                    }
                                    accepted => {
                                        if (todo-input.text != "") {
                                            root.todo-add(todo-input.text);
                                            root.todo-draft = "";
                                        }
                                    }
                                }

                                if root.todo-draft == "" && !todo-input.has-focus: Text {
                                    x: 27px;
                                    width: parent.width - 84px;
                                    height: parent.height;
                                    text: "Add a task...";
                                    color: #6B7280;
                                    font-size: 10.5px;
                                    vertical-alignment: center;
                                }

                                // Clickable Add / Enter button on the right
                                Rectangle {
                                    x: parent.width - 52px;
                                    y: (parent.height - 20px) / 2;
                                    width: 47px;
                                    height: 20px;
                                    border-radius: 7px;
                                    background: root.todo-draft != "" ? (add-btn-touch.has-hover ? #38F6FF : #00F0FF) : #FFFFFF0C;

                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "Add ↵";
                                        color: root.todo-draft != "" ? #041014 : #6B7280;
                                        font-size: 8.5px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    add-btn-touch := TouchArea {
                                        mouse-cursor: root.todo-draft != "" ? pointer : default;
                                        clicked => {
                                            if (root.todo-draft != "") {
                                                root.todo-add(root.todo-draft);
                                                root.todo-draft = "";
                                            } else {
                                                todo-input.focus();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Segmented Pill Navigation Dock (26px) ---------------------
                Rectangle {
                    height: 26px;
                    background: transparent;

                    // Dock container centered horizontally
                    Rectangle {
                        width: 460px;
                        height: 26px;
                        x: (parent.width - self.width) / 2;
                        y: 0;
                        border-radius: 13px;
                        background: #0C0C11;
                        border-width: 1px;
                        border-color: #FFFFFF14;

                        // Scroll wheel over navigation dock cycles pages smoothly
                        TouchArea {
                            scroll-event(event) => {
                                if (event.delta-y < 0px || event.delta-x < 0px) {
                                    root.page-selected(min(root.active-page + 1, root.page-count - 1));
                                    return EventResult.accept;
                                }
                                if (event.delta-y > 0px || event.delta-x > 0px) {
                                    root.page-selected(max(root.active-page - 1, 0));
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                        }

                        // Sliding Active Pill Indicator
                        Rectangle {
                            width: 88px;
                            height: 22px;
                            x: 3px + root.active-page * 91px;
                            y: 2px;
                            border-radius: 11px;
                            background: @linear-gradient(135deg, #FFFFFF1C 0%, #00F0FF14 100%);
                            border-width: 1px;
                            border-color: #00F0FF66;
                            animate x {
                                duration: 210ms;
                                easing: cubic-bezier(0.22, 1, 0.36, 1);
                            }

                            // Glowing bottom cyan accent bar
                            Rectangle {
                                width: 18px;
                                height: 2px;
                                x: (parent.width - self.width) / 2;
                                y: parent.height - 2px;
                                border-radius: 1px;
                                background: #00F0FF;
                            }
                        }

                        // 5 Interactive Feature Tabs
                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 3px;
                            padding-right: 3px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 3px;

                            for label[page] in root.page-labels: Rectangle {
                                width: 88px;
                                height: 22px;
                                border-radius: 11px;
                                background: (tab-touch.has-hover && root.active-page != page) ? #FFFFFF0A : transparent;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;

                                    // Tab Icon
                                    Rectangle {
                                        width: 11px;
                                        height: 11px;
                                        y: (parent.height - self.height) / 2;
                                        background: transparent;

                                        // 0: Music note icon
                                        if page == 0: Path {
                                            width: 11px;
                                            height: 11px;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 12;
                                            viewbox-height: 12;
                                            fill: transparent;
                                            stroke: root.active-page == page ? #00F0FF : (tab-touch.has-hover ? #E5E7EB : #9CA3AF);
                                            stroke-width: 1.4px;
                                            stroke-line-cap: round;
                                            MoveTo { x: 4; y: 9.5; }
                                            LineTo { x: 4; y: 2.5; }
                                            LineTo { x: 10; y: 1.5; }
                                            LineTo { x: 10; y: 8.5; }
                                            MoveTo { x: 2.5; y: 9.5; }
                                            ArcTo { radius-x: 1.5; radius-y: 1.5; sweep: true; x: 4; y: 9.5; }
                                            MoveTo { x: 8.5; y: 8.5; }
                                            ArcTo { radius-x: 1.5; radius-y: 1.5; sweep: true; x: 10; y: 8.5; }
                                        }

                                        // 1: Focus timer icon
                                        if page == 1: Path {
                                            width: 11px;
                                            height: 11px;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 12;
                                            viewbox-height: 12;
                                            fill: transparent;
                                            stroke: root.active-page == page ? #00F0FF : (tab-touch.has-hover ? #E5E7EB : #9CA3AF);
                                            stroke-width: 1.4px;
                                            stroke-line-cap: round;
                                            MoveTo { x: 6; y: 1.5; }
                                            ArcTo { radius-x: 4.5; radius-y: 4.5; sweep: true; x: 6; y: 10.5; }
                                            ArcTo { radius-x: 4.5; radius-y: 4.5; sweep: true; x: 6; y: 1.5; }
                                            MoveTo { x: 6; y: 3.8; }
                                            LineTo { x: 6; y: 6.2; }
                                            LineTo { x: 7.8; y: 7.2; }
                                        }

                                        // 2: Water droplet icon
                                        if page == 2: Path {
                                            width: 11px;
                                            height: 11px;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 12;
                                            viewbox-height: 12;
                                            fill: transparent;
                                            stroke: root.active-page == page ? #00F0FF : (tab-touch.has-hover ? #E5E7EB : #9CA3AF);
                                            stroke-width: 1.4px;
                                            stroke-line-cap: round;
                                            MoveTo { x: 6; y: 1.5; }
                                            LineTo { x: 9.5; y: 6.8; }
                                            ArcTo { radius-x: 3.5; radius-y: 3.5; sweep: true; x: 2.5; y: 6.8; }
                                            Close {}
                                        }

                                        // 3: Shelf folder icon
                                        if page == 3: Path {
                                            width: 11px;
                                            height: 11px;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 12;
                                            viewbox-height: 12;
                                            fill: transparent;
                                            stroke: root.active-page == page ? #00F0FF : (tab-touch.has-hover ? #E5E7EB : #9CA3AF);
                                            stroke-width: 1.4px;
                                            stroke-line-cap: round;
                                            MoveTo { x: 1.5; y: 3; }
                                            LineTo { x: 4.8; y: 3; }
                                            LineTo { x: 6; y: 4.4; }
                                            LineTo { x: 10.5; y: 4.4; }
                                            LineTo { x: 10.5; y: 9.8; }
                                            LineTo { x: 1.5; y: 9.8; }
                                            Close {}
                                        }

                                        // 4: To-do check icon
                                        if page == 4: Path {
                                            width: 11px;
                                            height: 11px;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 12;
                                            viewbox-height: 12;
                                            fill: transparent;
                                            stroke: root.active-page == page ? #00F0FF : (tab-touch.has-hover ? #E5E7EB : #9CA3AF);
                                            stroke-width: 1.5px;
                                            stroke-line-cap: round;
                                            MoveTo { x: 2; y: 6.2; }
                                            LineTo { x: 4.8; y: 9; }
                                            LineTo { x: 10; y: 3; }
                                        }
                                    }

                                    Text {
                                        text: label;
                                        color: root.active-page == page ? #FFFFFF : (tab-touch.has-hover ? #E5E7EB : #9CA3AF);
                                        font-size: 9.5px;
                                        font-weight: root.active-page == page ? 700 : 600;
                                        vertical-alignment: center;
                                    }

                                    // Live status dot on active background features (music playing, focus running, water nudge, pending tasks)
                                    if (page == 0 && root.media-playing) || (page == 1 && root.focus-running) || (page == 2 && root.water-nudge) || (page == 4 && (root.todo-total - root.todo-done) > 0): Rectangle {
                                        width: 4px;
                                        height: 4px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 2px;
                                        background: page == 0 ? #10B981 : (page == 1 ? #00F0FF : (page == 2 ? #38BDF8 : #A78BFA));
                                    }
                                }

                                tab-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.page-selected(page);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Hardware HUD (Sprint 6) --------------------------------------
        if root.hud-visible: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            Rectangle {
                x: 18px;
                y: parent.height - 16px;
                width: parent.width - 36px;
                height: 16px;
                background: @radial-gradient(circle, #00F0FF55 0%, transparent 84%);
                opacity: root.hud-device ? 1.0 : 0.0;
            }
            Rectangle {
                x: 18px;
                y: parent.height - 16px;
                width: parent.width - 36px;
                height: 16px;
                background: @radial-gradient(circle, #34D39955 0%, transparent 84%);
                opacity: root.hud-device ? 0.0 : 1.0;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 11px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: root.hud-device ? #00F0FF14 : #34D39914;
                    border-width: 1px;
                    border-color: root.hud-device ? #00F0FF38 : #34D39938;

                    if root.hud-device: Rectangle {
                        width: 26px;
                        height: 26px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: transparent;

                        Path {
                            width: 26px;
                            height: 26px;
                            viewbox-width: 26;
                            viewbox-height: 26;
                            stroke: #00F0FF;
                            stroke-width: 2.2px;
                            fill: transparent;

                            MoveTo {
                                x: 4;
                                y: 15;
                            }
                            LineTo {
                                x: 4;
                                y: 12;
                            }
                            ArcTo {
                                radius-x: 9;
                                radius-y: 9;
                                sweep: true;
                                x: 22;
                                y: 12;
                            }
                            LineTo {
                                x: 22;
                                y: 15;
                            }
                        }

                        Rectangle {
                            x: 2px;
                            y: 14px;
                            width: 6px;
                            height: 9px;
                            border-radius: 3px;
                            background: #00F0FF;
                        }
                        Rectangle {
                            x: 18px;
                            y: 14px;
                            width: 6px;
                            height: 9px;
                            border-radius: 3px;
                            background: #00F0FF;
                        }
                    }

                    if !root.hud-device: Rectangle {
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: transparent;

                        Path {
                            width: 24px;
                            height: 24px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            fill: #FACC15;

                            MoveTo {
                                x: 13;
                                y: 1;
                            }
                            LineTo {
                                x: 4;
                                y: 14;
                            }
                            LineTo {
                                x: 10;
                                y: 14;
                            }
                            LineTo {
                                x: 8;
                                y: 23;
                            }
                            LineTo {
                                x: 20;
                                y: 9;
                            }
                            LineTo {
                                x: 13;
                                y: 9;
                            }
                            Close {}
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: root.hud-title;
                        color: #FFFFFF;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: TextOverflow.elide;
                    }

                    HorizontalLayout {
                        spacing: 5px;

                        Rectangle {
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: root.hud-device ? (root.hud-connected ? #34D399 : #F59E0B) : #34D399;
                        }

                        Text {
                            text: root.hud-status;
                            color: root.hud-device ? (root.hud-connected ? #34D399 : #F59E0B) : #34D399;
                            font-size: 9.5px;
                            font-weight: 600;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                if root.hud-device: HorizontalLayout {
                    spacing: 3px;
                    alignment: center;

                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-0 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-1 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-2 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-3 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-4 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                }

                if !root.hud-device: Text {
                    text: root.hud-percent-text;
                    color: #34D399;
                    font-size: 20px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }
        }
    }
}
