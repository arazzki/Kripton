// Kripton — Native Windows living notch
// UI shell for PRD v2.0. The Rust runtime drives the spring geometry, the
// plasma layers, the battery arc and the audio bars through these properties.

export struct ShelfView {
    name: string,
    size-text: string,
    is-directory: bool,
    has-thumbnail: bool,
    missing: bool,
    thumbnail: image,
    index: int,
}

export struct TodoView {
    id: int,
    text: string,
    completed: bool,
}

export component AppWindow inherits Window {
    title: "Kripton";
    width: 680px;
    height: 250px;
    background: transparent;
    no-frame: true;

    default-font-family: "Segoe UI Variable Display";
    default-font-size: 12px;

    // --- Driven by Rust -----------------------------------------------------
    in property <length> notch-width: 184px;
    in property <length> notch-height: 5px;
    in property <bool> expanded: false;
    in property <bool> closed: false;
    in property <bool> stealth: true;
    in property <int> active-page: 0;
    in property <string> page-title: "Music";
    in property <string> page-subtitle: "";
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> build-label: "v1.0.0";
    in property <bool> lyrics-enabled: false;

    // Lyrics mode (Sprint 3).

    in property <string> lyrics-line-prev: "";

    in property <string> lyrics-line-curr: "Play a track to see lyrics";

    in property <string> lyrics-line-next: "";

    in property <bool> lyrics-available: false;

    in property <bool> lyrics-loading: false;

    in property <color> lyrics-glow-color: #1E3A8A;

    // Living mascot (Sprint 1).
    in property <image> mascot: @image-url("../assets/plasma_core.png");
    in property <image> corona: @image-url("../assets/plasma_corona.png");
    in property <image> aura: @image-url("../assets/plasma_aura.png");
    in property <float> orb-scale: 1.0;
    in property <float> orb-glow: 0.48;
    in property <length> orb-offset-x: 0px;
    in property <length> orb-offset-y: 0px;
    in property <float> aura-scale: 1.0;
    in property <float> aura-opacity: 0.48;
    in property <angle> corona-angle: 0deg;

    // Closed compact mode (Sprint 1).
    in property <bool> battery-present: true;
    in property <bool> battery-on-ac: true;
    in property <float> battery-percent: 100.0;
    in property <bool> battery-charging: false;
    in property <float> battery-arc-x: 9.0;
    in property <float> battery-arc-y: 1.25;
    in property <bool> battery-arc-large: false;
    in property <bool> battery-arc-visible: false;
    in property <bool> battery-full: true;
    in property <float> wave-0: 0.0;
    in property <float> wave-1: 0.0;
    in property <float> wave-2: 0.0;
    in property <float> wave-3: 0.0;
    in property <float> wave-4: 0.0;

    // Music page (Sprint 2).
    in property <bool> media-available: false;
    in property <bool> media-playing: false;
    in property <string> track-title: "Nothing playing";
    in property <string> track-subtitle: "Start a track in any media app";
    in property <string> elapsed-text: "00:00";
    in property <string> remaining-text: "-00:00";
    in property <bool> has-album-art: false;
    in property <image> album-art: @image-url("../assets/plasma_core.png");
    in property <bool> seek-enabled: false;
    in property <bool> can-skip-previous: false;
    in property <bool> can-skip-next: false;
    in-out property <float> seek-fraction: 0.0;
    in-out property <bool> seek-dragging: false;

    // Shelf page (Sprint 4). The model only contains the visible carousel
    // window (max 5); `index` keeps the global shelf position.
    in property <[ShelfView]> shelf-items: [];
    in property <int> shelf-start: 0;
    in property <int> shelf-total: 0;
    in property <bool> shelf-can-prev: false;
    in property <bool> shelf-can-next: false;
    in property <bool> shelf-drag-active: false;
    in property <float> shelf-fade: 1.0;
    in property <string> shelf-summary: "Shelf is empty";

    // Focus page (Sprint 5).
    in property <int> focus-minutes: 25;
    in property <string> focus-remaining: "25:00";
    in property <float> focus-progress: 0.0;
    in property <bool> focus-running: false;
    in property <bool> focus-active: false;
    in property <bool> focus-celebrate: false;
    in property <string> focus-session: "Focus Session #1";
    in property <int> focus-completed: 0;

    // Water page (Sprint 5).
    in property <int> water-current: 0;
    in property <int> water-goal: 2000;
    in property <float> water-progress: 0.0;
    in property <float> water-phase: 0.0;
    in property <string> water-summary: "0 / 2,000 ml";
    in property <string> water-percent: "0%";
    in property <bool> water-can-undo: false;
    in property <bool> water-nudge: false;

    // To-do page (Sprint 5).
    in property <[TodoView]> todo-items: [];
    in property <int> todo-total: 0;
    in property <int> todo-done: 0;
    in property <string> todo-summary: "No tasks yet";
    in-out property <string> todo-draft: "";
    in-out property <bool> todo-edit-active: false;

    // Hardware HUDs (Sprint 6).
    in property <bool> hud-visible: false;
    in property <bool> hud-device: true;
    in property <string> hud-title: "";
    in property <string> hud-status: "Connected";
    in property <bool> hud-connected: true;
    in property <bool> hud-charging: false;
    in property <string> hud-percent-text: "100%";

    callback toggle-expand();
    callback page-selected(int);
    callback quit();
    callback media-play-pause();
    callback media-previous();
    callback media-next();
    callback media-open-source();
    callback media-seek-start();
    callback media-seek-preview(float);
    callback media-seek-commit(float);
    callback lyrics-toggle();
    callback shelf-nav(int);
    callback shelf-clear();
    callback shelf-open(int);
    callback shelf-remove(int);
    callback focus-toggle();
    callback focus-reset();
    callback focus-preset(int);
    callback focus-adjust(int);
    callback water-add(int);
    callback water-undo();
    callback todo-add(string);
    callback todo-toggle(int);
    callback todo-remove(int);
    callback todo-clear-done();
    callback todo-reorder(int, float);
    callback todo-edit(bool);

    // --- Design tokens ------------------------------------------------------
    private property <length> bottom-radius: root.stealth ? 2.5px : 18px;
    private property <int> page-count: 5;
    private property <[int]> focus-presets: [15, 25, 45, 60];
    private property <[int]> water-presets: [150, 250, 500];
    private property <length> ring-size: 18px;
    private property <length> wave-bar-width: 2.5px;

    // 1. Silhouette: clean top-attached notch with smooth bottom rounded corners.
    //    Coordinates follow the animated notch rect directly, eliminating the
    //    protruding "ears" (double curves) for a sleek, modern outline.
    Path {
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        fill: #000000;

        MoveTo {
            x: notch.x / 1px;
            y: 0;
        }
        LineTo {
            x: (notch.x + notch.width) / 1px;
            y: 0;
        }
        LineTo {
            x: (notch.x + notch.width) / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: true;
            x: (notch.x + notch.width - root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        LineTo {
            x: (notch.x + root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: true;
            x: notch.x / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        LineTo {
            x: notch.x / 1px;
            y: 0;
        }
        Close {}
    }

    // 2. Notch surface and content.
    notch := Rectangle {
        x: (root.width - self.width) / 2;
        y: 0;
        width: root.notch-width;
        height: root.notch-height;
        background: transparent;
        clip: true;

        if root.lyrics-enabled && root.active-page == 0 && root.expanded: Rectangle {

            x: 8px;

            y: parent.height - 35px;

            width: parent.width - 16px;

            height: 35px;

            background: @radial-gradient(circle, root.lyrics-glow-color.transparentize(50%) 0%, root.lyrics-glow-color.transparentize(85%) 55%, transparent 85%);

            opacity: 0.85;

        }

        // Bottom ambient ionized glow.
        Rectangle {
            x: 10px;
            y: parent.height - 30px;
            width: parent.width - 20px;
            height: 30px;
            background: @radial-gradient(circle, #4F46E5B8 0%, #7C3AED44 48%, transparent 82%);
            opacity: root.stealth ? 0.0 : (root.expanded ? 0.55 : root.orb-glow);
            animate opacity {
                duration: 200ms;
                easing: ease-out;
            }
        }
        Rectangle {
            x: parent.width * 0.28;
            y: parent.height - 20px;
            width: parent.width * 0.44;
            height: 18px;
            background: @radial-gradient(circle, #00F0FF44 0%, transparent 84%);
            opacity: root.expanded ? 0.6 : root.orb-glow * 0.9;
        }

        // Whole-notch interaction layer. It sits below the content so the
        // pagination dots and future feature controls receive clicks first.
        TouchArea {
            clicked => {
                root.toggle-expand();
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    root.quit();
                }
            }
        }

        // --- Collapsed Notch Content (Stealth & Compact Pill) ---------------
        if !root.expanded && !root.hud-visible: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            // 1. Morphing Plasma Streak Line:
            // In Stealth: centered 120px line.
            // On Wake to Compact: gracefully glides to left (x: 10px), condenses and blossoms into enlarged 30px mascot orb!
            Rectangle {
                width: root.stealth ? 120px : 30px;
                height: root.stealth ? 2.5px : 30px;
                x: root.stealth ? (parent.width - self.width) / 2 : 10px;
                y: root.stealth ? (parent.height - self.height) / 2 : (parent.height - 30px) / 2;
                border-radius: root.stealth ? 1.25px : 15px;
                opacity: root.stealth ? 1.0 : 0.0;
                background: @linear-gradient(90deg, transparent 0%, #7C3AED 18%, #00F0FF 50%, #10B981 82%, transparent 100%);
                animate x {
                    duration: 380ms;
                    easing: ease-in-out;
                }
                animate width {
                    duration: 380ms;
                    easing: ease-in-out;
                }
                animate height {
                    duration: 350ms;
                    easing: ease-in-out;
                }
                animate border-radius {
                    duration: 350ms;
                    easing: ease-in-out;
                }
                animate opacity {
                    duration: 320ms;
                    easing: ease-in-out;
                }

                // Bright center bead that concentrates energy into the core
                Rectangle {
                    width: root.stealth ? 36px : 9px;
                    height: root.stealth ? 1.5px : 9px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: root.stealth ? 0.75px : 4.5px;
                    background: #FFFFFF;
                    opacity: root.stealth ? 0.95 : 0.0;
                    animate width {
                        duration: 340ms;
                        easing: ease-in-out;
                    }
                    animate height {
                        duration: 320ms;
                        easing: ease-in-out;
                    }
                    animate opacity {
                        duration: 300ms;
                        easing: ease-in-out;
                    }
                }
            }

            // 2. Compact Pill: Left Mascot (reconstituted from the streak line, bold 30px size)
            Rectangle {
                x: 10px;
                y: (parent.height - self.height) / 2;
                width: root.stealth ? 10px : 30px;
                height: self.width;
                background: transparent;
                opacity: root.stealth ? 0.0 : 1.0;
                animate width {
                    duration: 380ms;
                    easing: ease-out;
                }
                animate opacity {
                    duration: 350ms;
                    easing: ease-in-out;
                }

                // Ambient glow around the mascot
                Rectangle {
                    width: 44px;
                    height: 44px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 22px;
                    background: @radial-gradient(circle, #00F0FF55 0%, #7C3AED2B 52%, transparent 80%);
                    opacity: root.aura-opacity;
                }

                // Hydration nudge: the mascot glows water-blue after 90 idle minutes.
                Rectangle {
                    width: 44px;
                    height: 44px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 22px;
                    background: @radial-gradient(circle, #38BDF8AA 0%, #0EA5E940 52%, transparent 80%);
                    opacity: root.water-nudge ? 0.9 : 0.0;
                    animate opacity {
                        duration: 600ms;
                        easing: ease-in-out;
                    }
                }

                // Rotating plasma corona core
                Image {
                    source: root.corona;
                    width: parent.width;
                    height: parent.height;
                    x: 0;
                    y: 0;
                    transform-rotation: root.corona-angle;
                    opacity: 0.92;
                    image-fit: contain;
                }

                // Mascot face avatar with gentle cursor ferrofluid pull
                Image {
                    source: root.mascot;
                    width: parent.width * 0.86;
                    height: self.width;
                    x: (parent.width - self.width) / 2 + root.orb-offset-x * 0.25;
                    y: (parent.height - self.height) / 2 + root.orb-offset-y * 0.25;
                    opacity: 1.0;
                    image-fit: contain;
                }
            }

            // 2b. Compact Pill: remaining focus time while a session is active.
            Rectangle {
                x: 46px;
                y: (parent.height - self.height) / 2;
                width: 66px;
                height: 20px;
                border-radius: 10px;
                background: #00F0FF1A;
                border-width: 1px;
                border-color: #00F0FF33;
                opacity: (root.focus-active && !root.stealth) ? 1.0 : 0.0;
                animate opacity {
                    duration: 220ms;
                    easing: ease-out;
                }

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.focus-remaining;
                    color: #00F0FF;
                    font-size: 10.5px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 3. Compact Pill: Centre 24-hour digital clock
            Text {
                width: parent.width;
                height: parent.height;
                text: root.clock-text;
                color: #FFFFFF;
                font-size: 15px;
                font-weight: 700;
                letter-spacing: 0.3px;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: root.stealth ? 0.0 : 1.0;
                animate opacity {
                    duration: 350ms;
                    easing: ease-in-out;
                }
            }

            // 4. Compact Pill: Right 5 pill bars driven by live audio spectrum
            Rectangle {
                x: parent.width - 40px;
                y: 0;
                width: 24px;
                height: parent.height;
                background: transparent;
                opacity: root.stealth ? 0.0 : 1.0;
                animate opacity {
                    duration: 350ms;
                    easing: ease-in-out;
                }

                Rectangle {
                    x: 0px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-0 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 5px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-1 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 10px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-2 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 15px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-3 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
                Rectangle {
                    x: 20px;
                    width: root.wave-bar-width;
                    height: 3px + root.wave-4 * 13px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.25px;
                    background: #FFFFFF;
                }
            }
        }

        // --- Expanded shell ------------------------------------------------
        // Fixed 460 px (or 560 px in lyrics mode) layout clipped by the springing notch.
        if root.expanded: Rectangle {
            width: 580px;
            height: 192px;
            x: (parent.width - self.width) / 2;
            y: 0;
            background: transparent;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 4px;
                spacing: 3px;

                // --- Status header: mascot, page, battery, clock, live wave ---
                HorizontalLayout {
                    height: 26px;
                    spacing: 8px;

                    Image {
                        width: 26px;
                        height: 26px;
                        source: root.mascot;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;

                        Text {
                            text: root.page-title;
                            color: #FFFFFF;
                            font-size: 13.5px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.page-subtitle;
                            color: #9CA3AF;
                            font-size: 8.5px;
                            font-weight: 400;
                            overflow: TextOverflow.elide;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    // 16 px battery ring, vertically centred in the header.
                    Rectangle {
                        width: 16px;
                        height: 26px;
                        background: transparent;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;

                        Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: transparent;
                            stroke: #064E3B;
                            stroke-width: 2.6px;
                            stroke-line-cap: round;
                            MoveTo { x: 9; y: 1.25; }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: false;
                                sweep: true;
                                x: 9;
                                y: 16.75;
                            }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: false;
                                sweep: true;
                                x: 9;
                                y: 1.25;
                            }
                        }

                        if root.battery-full: Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: transparent;
                            stroke: root.battery-charging ? #34D399 : #22C55E;
                            stroke-width: 2.6px;
                            stroke-line-cap: round;
                            MoveTo { x: 9; y: 1.25; }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: false;
                                sweep: true;
                                x: 9;
                                y: 16.75;
                            }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: false;
                                sweep: true;
                                x: 9;
                                y: 1.25;
                            }
                        }

                        if root.battery-arc-visible && !root.battery-full: Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: transparent;
                            stroke: root.battery-charging ? #34D399 : #22C55E;
                            stroke-width: 2.6px;
                            stroke-line-cap: round;
                            MoveTo { x: 9; y: 1.25; }
                            ArcTo {
                                radius-x: 7.75;
                                radius-y: 7.75;
                                large-arc: root.battery-arc-large;
                                sweep: true;
                                x: root.battery-arc-x;
                                y: root.battery-arc-y;
                            }
                        }

                        if root.battery-charging || (!root.battery-present && root.battery-on-ac): Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            fill: root.battery-present ? #34D399 : #00F0FF;
                            stroke: transparent;
                            MoveTo { x: 10.1; y: 4.4; }
                            LineTo { x: 6.7; y: 9.7; }
                            LineTo { x: 8.9; y: 9.7; }
                            LineTo { x: 7.9; y: 13.6; }
                            LineTo { x: 11.4; y: 8.2; }
                            LineTo { x: 9.2; y: 8.2; }
                            Close {}
                        }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;

                        Text {
                            text: root.date-text;
                            color: #9CA3AF;
                            font-size: 8.5px;
                            horizontal-alignment: right;
                        }
                        Text {
                            text: root.clock-text;
                            color: #FFFFFF;
                            font-size: 14.5px;
                            font-weight: 700;
                            horizontal-alignment: right;
                        }
                    }

                    // Live 5-band wave, top right.
                    Rectangle {
                        width: 23px;
                        height: 26px;
                        background: transparent;

                        Rectangle {
                            x: 0px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-0 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                        Rectangle {
                            x: 5px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-1 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                        Rectangle {
                            x: 10px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-2 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                        Rectangle {
                            x: 15px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-3 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                        Rectangle {
                            x: 20px;
                            width: root.wave-bar-width;
                            height: 3px + root.wave-4 * 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.25px;
                            background: #FFFFFF;
                        }
                    }
                }

                // --- Page card -------------------------------------------------
                Rectangle {
                    vertical-stretch: 1;
                    background: @linear-gradient(145deg, #101014 0%, #08080B 100%);
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #FFFFFF12;
                    clip: true;

                    Image {
                        width: 132px;
                        height: 132px;
                        x: parent.width - 96px;
                        y: -40px;
                        source: root.mascot;
                        image-fit: contain;
                        opacity: root.active-page == 0 ? 0.10 : 0.22;
                    }

                    // --- Music page (Standard View) ---------------------------
                    if root.active-page == 0 && !root.lyrics-enabled: VerticalLayout {
                        alignment: center;
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 5px;
                        padding-bottom: 4px;
                        spacing: 3px;

                        // Album art, track identity and open-source button.
                        HorizontalLayout {
                            height: 64px;
                            spacing: 10px;

                            Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: 14px;
                                clip: true;
                                background: @linear-gradient(135deg, #1F2937 0%, #0B0B0E 100%);

                                if root.has-album-art: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.album-art;
                                    image-fit: cover;
                                }
                                if !root.has-album-art: Image {
                                    width: 38px;
                                    height: 38px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: root.mascot;
                                    image-fit: contain;
                                    opacity: 0.35;
                                }
                            }

                            VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 1px;

                                Text {
                                    text: root.track-title;
                                    color: #FFFFFF;
                                    font-size: 16px;
                                    font-weight: 700;
                                    overflow: TextOverflow.elide;
                                }
                                Text {
                                    text: root.track-subtitle;
                                    color: #9CA3AF;
                                    font-size: 12px;
                                    font-weight: 400;
                                    overflow: TextOverflow.elide;
                                }
                            }

                            Rectangle {
                                width: 26px;
                                height: 64px;
                                background: transparent;

                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 13px;
                                    background: root.media-available ? #262626 : #1A1A1E;

                                    Path {
                                        width: 8px;
                                        height: 12px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 8;
                                        viewbox-height: 12;
                                        fill: transparent;
                                        stroke: root.media-available ? #E5E7EB : #4B5563;
                                        stroke-width: 1.6px;
                                        stroke-line-cap: round;
                                        MoveTo { x: 2; y: 1; }
                                        LineTo { x: 6; y: 6; }
                                        LineTo { x: 2; y: 11; }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.media-open-source();
                                        }
                                    }
                                }
                            }
                        }

                        // Timeline: elapsed, seek bar, remaining.
                        HorizontalLayout {
                            height: 14px;
                            spacing: 7px;

                            Text {
                                text: root.elapsed-text;
                                color: #E5E7EB;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                Rectangle {
                                    x: 0;
                                    y: (parent.height - 4px) / 2;
                                    width: parent.width;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: #374151;

                                    Rectangle {
                                        width: parent.width * root.seek-fraction;
                                        height: 4px;
                                        border-radius: 2px;
                                        background: #FFFFFF;
                                    }

                                    if root.seek-enabled: Rectangle {
                                        x: parent.width * root.seek-fraction - 5px;
                                        y: -3px;
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: #FFFFFF;
                                        border-width: 2px;
                                        border-color: #0B0B0E;
                                    }
                                }

                                seek-touch := TouchArea {
                                    pointer-event(e) => {
                                        if (root.seek-enabled) {
                                            if (e.kind == PointerEventKind.down) {
                                                root.seek-dragging = true;
                                                root.media-seek-start();
                                                root.media-seek-preview((seek-touch.mouse-x / 1px) / (seek-touch.width / 1px));
                                            }
                                            if (e.kind == PointerEventKind.move && root.seek-dragging) {
                                                root.media-seek-preview((seek-touch.mouse-x / 1px) / (seek-touch.width / 1px));
                                            }
                                            if (e.kind == PointerEventKind.up && root.seek-dragging) {
                                                root.seek-dragging = false;
                                                root.media-seek-commit((seek-touch.mouse-x / 1px) / (seek-touch.width / 1px));
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.remaining-text;
                                color: #E5E7EB;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }

                        // Controls: lyrics toggle, previous, play/pause, next.
                        HorizontalLayout {
                            height: 26px;
                            spacing: 0px;

                            Rectangle {
                                width: 32px;
                                background: transparent;

                                Rectangle {
                                    x: 0;
                                    y: (parent.height - 18px) / 2;
                                    width: 22px;
                                    height: 18px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.lyrics-enabled ? transparent : #4B5563;
                                    background: root.lyrics-enabled ? #FFFFFF : #161619;

                                    for dot in 3: Rectangle {
                                        width: 2px;
                                        height: 2px;
                                        border-radius: 1px;
                                        x: 5px + dot * 4px;
                                        y: 8px;
                                        background: root.lyrics-enabled ? #0B0B0E : #D1D5DB;
                                    }

                                    Path {
                                        x: 4px;
                                        y: 15px;
                                        width: 5px;
                                        height: 4px;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 5;
                                        viewbox-height: 4;
                                        fill: root.lyrics-enabled ? #FFFFFF : #161619;
                                        stroke: root.lyrics-enabled ? #FFFFFF : #4B5563;
                                        stroke-width: 1px;
                                        MoveTo { x: 0; y: 0; }
                                        LineTo { x: 5; y: 0; }
                                        LineTo { x: 0; y: 4; }
                                        Close {}
                                    }
                                }

                                TouchArea {
                                    clicked => {
                                        root.lyrics-toggle();
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                HorizontalLayout {
                                    width: parent.width;
                                    height: 18px;
                                    y: (parent.height - 18px) / 2;
                                    spacing: 18px;
                                    alignment: center;

                                    // Previous.
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: transparent;

                                        Path {
                                            width: parent.width;
                                            height: parent.height;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 18;
                                            viewbox-height: 18;
                                            fill: root.can-skip-previous ? #FFFFFF : #4B5563;
                                            stroke: transparent;
                                            MoveTo { x: 4; y: 3; }
                                            LineTo { x: 6.2; y: 3; }
                                            LineTo { x: 6.2; y: 15; }
                                            LineTo { x: 4; y: 15; }
                                            Close {}
                                            MoveTo { x: 14.5; y: 3.5; }
                                            LineTo { x: 7.2; y: 9; }
                                            LineTo { x: 14.5; y: 14.5; }
                                            Close {}
                                        }

                                        TouchArea {
                                            clicked => {
                                                if (root.can-skip-previous) {
                                                    root.media-previous();
                                                }
                                            }
                                        }
                                    }

                                    // Play / pause.
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: transparent;

                                        if root.media-playing: Rectangle {
                                            x: 3px;
                                            y: 2px;
                                            width: 4px;
                                            height: 14px;
                                            border-radius: 1.5px;
                                            background: #FFFFFF;
                                        }
                                        if root.media-playing: Rectangle {
                                            x: 11px;
                                            y: 2px;
                                            width: 4px;
                                            height: 14px;
                                            border-radius: 1.5px;
                                            background: #FFFFFF;
                                        }

                                        if !root.media-playing: Path {
                                            width: 18px;
                                            height: 18px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 18;
                                            viewbox-height: 18;
                                            fill: #FFFFFF;
                                            stroke: transparent;
                                            MoveTo { x: 5; y: 2.5; }
                                            LineTo { x: 15; y: 9; }
                                            LineTo { x: 5; y: 15.5; }
                                            Close {}
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.media-play-pause();
                                            }
                                        }
                                    }

                                    // Next.
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: transparent;

                                        Path {
                                            width: parent.width;
                                            height: parent.height;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 18;
                                            viewbox-height: 18;
                                            fill: root.can-skip-next ? #FFFFFF : #4B5563;
                                            stroke: transparent;
                                            MoveTo { x: 11.8; y: 3; }
                                            LineTo { x: 14; y: 3; }
                                            LineTo { x: 14; y: 15; }
                                            LineTo { x: 11.8; y: 15; }
                                            Close {}
                                            MoveTo { x: 3.5; y: 3.5; }
                                            LineTo { x: 10.8; y: 9; }
                                            LineTo { x: 3.5; y: 14.5; }
                                            Close {}
                                        }

                                        TouchArea {
                                            clicked => {
                                                if (root.can-skip-next) {
                                                    root.media-next();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                width: 32px;
                                background: transparent;
                            }
                        }
                    }

                    // --- Music page (Widened Synced Lyrics View: 580 x 192) ----

                    if root.active-page == 0 && root.lyrics-enabled: HorizontalLayout {

                        padding-left: 8px;

                        padding-right: 8px;

                        padding-top: 5px;

                        padding-bottom: 4px;

                        spacing: 12px;

                        // Left Column: Compact Player (220px)

                        VerticalLayout {

                            width: 220px;

                            alignment: center;

                            spacing: 5px;

                            // Mini track info (56px)

                            HorizontalLayout {

                                height: 56px;

                                spacing: 8px;

                                Rectangle {

                                    width: 56px;

                                    height: 56px;

                                    border-radius: 12px;

                                    clip: true;

                                    background: @linear-gradient(135deg, #1F2937 0%, #0B0B0E 100%);

                                    if root.has-album-art: Image {

                                        width: parent.width;

                                        height: parent.height;

                                        source: root.album-art;

                                        image-fit: cover;

                                    }

                                    if !root.has-album-art: Image {

                                        width: 32px;

                                        height: 32px;

                                        x: (parent.width - self.width) / 2;

                                        y: (parent.height - self.height) / 2;

                                        source: root.mascot;

                                        image-fit: contain;

                                        opacity: 0.35;

                                    }

                                }

                                VerticalLayout {

                                    vertical-stretch: 1;

                                    alignment: center;

                                    spacing: 1px;

                                    Text {

                                        text: root.track-title;

                                        color: #FFFFFF;

                                        font-size: 14px;

                                        font-weight: 700;

                                        overflow: TextOverflow.elide;

                                    }

                                    Text {

                                        text: root.track-subtitle;

                                        color: #9CA3AF;

                                        font-size: 11px;

                                        font-weight: 400;

                                        overflow: TextOverflow.elide;

                                    }

                                }

                            }

                            // Compact timeline

                            HorizontalLayout {

                                height: 12px;

                                spacing: 6px;

                                Text {

                                    text: root.elapsed-text;

                                    color: #E5E7EB;

                                    font-size: 10px;

                                    vertical-alignment: center;

                                }

                                Rectangle {

                                    horizontal-stretch: 1;

                                    background: transparent;

                                    Rectangle {

                                        x: 0;

                                        y: (parent.height - 3px) / 2;

                                        width: parent.width;

                                        height: 3px;

                                        border-radius: 1.5px;

                                        background: #374151;

                                        Rectangle {

                                            width: parent.width * root.seek-fraction;

                                            height: 3px;

                                            border-radius: 1.5px;

                                            background: #FFFFFF;

                                        }

                                    }

                                }

                                Text {

                                    text: root.remaining-text;

                                    color: #E5E7EB;

                                    font-size: 10px;

                                    vertical-alignment: center;

                                    horizontal-alignment: right;

                                }

                            }

                            // Compact controls: lyrics toggle (active), prev, play/pause, next

                            HorizontalLayout {

                                height: 24px;

                                alignment: space-between;

                                // Lyrics toggle (active)

                                Rectangle {

                                    width: 24px;

                                    height: 24px;

                                    background: transparent;

                                    Rectangle {

                                        width: 22px;

                                        height: 18px;

                                        y: (parent.height - 18px) / 2;

                                        border-radius: 6px;

                                        background: #FFFFFF;

                                        for dot in 3: Rectangle {

                                            width: 2px;

                                            height: 2px;

                                            border-radius: 1px;

                                            x: 5px + dot * 4px;

                                            y: 8px;

                                            background: #0B0B0E;

                                        }

                                        Path {

                                            x: 4px;

                                            y: 15px;

                                            width: 5px;

                                            height: 4px;

                                            viewbox-x: 0;

                                            viewbox-y: 0;

                                            viewbox-width: 5;

                                            viewbox-height: 4;

                                            fill: #FFFFFF;

                                            stroke: #FFFFFF;

                                            stroke-width: 1px;

                                            MoveTo { x: 0; y: 0; }

                                            LineTo { x: 5; y: 0; }

                                            LineTo { x: 0; y: 4; }

                                            Close {}

                                        }

                                    }

                                    TouchArea {

                                        clicked => {

                                            root.lyrics-toggle();

                                        }

                                    }

                                }

                                // Playback controls

                                HorizontalLayout {

                                    spacing: 12px;

                                    alignment: center;

                                    // Prev

                                    Rectangle {

                                        width: 16px;

                                        height: 16px;

                                        background: transparent;

                                        y: (parent.height - self.height) / 2;

                                        Path {

                                            width: parent.width;

                                            height: parent.height;

                                            viewbox-x: 0;

                                            viewbox-y: 0;

                                            viewbox-width: 18;

                                            viewbox-height: 18;

                                            fill: root.can-skip-previous ? #FFFFFF : #4B5563;

                                            MoveTo { x: 3; y: 3; }

                                            LineTo { x: 5; y: 3; }

                                            LineTo { x: 5; y: 15; }

                                            LineTo { x: 3; y: 15; }

                                            Close {}

                                            MoveTo { x: 15; y: 3; }

                                            LineTo { x: 6; y: 9; }

                                            LineTo { x: 15; y: 15; }

                                            Close {}

                                        }

                                        TouchArea {

                                            clicked => {

                                                if (root.can-skip-previous) {

                                                    root.media-previous();

                                                }

                                            }

                                        }

                                    }

                                    // Play/Pause

                                    Rectangle {

                                        width: 24px;

                                        height: 24px;

                                        border-radius: 12px;

                                        background: root.media-available ? #FFFFFF : #374151;

                                        if root.media-playing: Path {

                                            width: 10px;

                                            height: 10px;

                                            x: 7px;

                                            y: 7px;

                                            viewbox-x: 0;

                                            viewbox-y: 0;

                                            viewbox-width: 10;

                                            viewbox-height: 10;

                                            fill: #0B0B0E;

                                            MoveTo { x: 1; y: 0; }

                                            LineTo { x: 4; y: 0; }

                                            LineTo { x: 4; y: 10; }

                                            LineTo { x: 1; y: 10; }

                                            Close {}

                                            MoveTo { x: 6; y: 0; }

                                            LineTo { x: 9; y: 0; }

                                            LineTo { x: 9; y: 10; }

                                            LineTo { x: 6; y: 10; }

                                            Close {}

                                        }

                                        if !root.media-playing: Path {

                                            width: 10px;

                                            height: 10px;

                                            x: 8px;

                                            y: 7px;

                                            viewbox-x: 0;

                                            viewbox-y: 0;

                                            viewbox-width: 10;

                                            viewbox-height: 10;

                                            fill: #0B0B0E;

                                            MoveTo { x: 1; y: 0; }

                                            LineTo { x: 9; y: 5; }

                                            LineTo { x: 1; y: 10; }

                                            Close {}

                                        }

                                        TouchArea {

                                            clicked => {

                                                if (root.media-available) {

                                                    root.media-play-pause();

                                                }

                                            }

                                        }

                                    }

                                    // Next

                                    Rectangle {

                                        width: 16px;

                                        height: 16px;

                                        background: transparent;

                                        y: (parent.height - self.height) / 2;

                                        Path {

                                            width: parent.width;

                                            height: parent.height;

                                            viewbox-x: 0;

                                            viewbox-y: 0;

                                            viewbox-width: 18;

                                            viewbox-height: 18;

                                            fill: root.can-skip-next ? #FFFFFF : #4B5563;

                                            MoveTo { x: 3; y: 3; }

                                            LineTo { x: 12; y: 9; }

                                            LineTo { x: 3; y: 15; }

                                            Close {}

                                            MoveTo { x: 13; y: 3; }

                                            LineTo { x: 15; y: 3; }

                                            LineTo { x: 15; y: 15; }

                                            LineTo { x: 13; y: 15; }

                                            Close {}

                                        }

                                        TouchArea {

                                            clicked => {

                                                if (root.can-skip-next) {

                                                    root.media-next();

                                                }

                                            }

                                        }

                                    }

                                }

                            }

                        }

                        // Divider (1px vertical line)

                        Rectangle {

                            width: 1px;

                            height: parent.height - 8px;

                            y: 4px;

                            background: #FFFFFF1F;

                        }

                        // Right Column: Live Synced Lyrics Viewport (~290px)

                        lyrics-viewport := Rectangle {

                            horizontal-stretch: 1;

                            background: transparent;

                            clip: true;

                            VerticalLayout {

                                width: parent.width;

                                height: parent.height;

                                alignment: center;

                                spacing: 4px;

                                padding-left: 8px;

                                padding-right: 8px;

                                if root.lyrics-available: VerticalLayout {

                                    spacing: 3px;

                                    alignment: center;

                                    // Previous line: 13px, #64748B, font-weight 600

                                    Text {

                                        text: root.lyrics-line-prev;

                                        color: #64748B;

                                        font-size: 13px;

                                        font-weight: 600;

                                        overflow: TextOverflow.elide;

                                        horizontal-alignment: left;

                                    }

                                    // Active line: 15px, #FFFFFF, font-weight 700

                                    HorizontalLayout {

                                        spacing: 6px;

                                        alignment: start;

                                        Rectangle {

                                            width: 3px;

                                            height: 14px;

                                            y: (parent.height - self.height) / 2;

                                            border-radius: 1.5px;

                                            background: #FFFFFF;

                                        }

                                        Text {

                                            text: root.lyrics-line-curr;

                                            color: #FFFFFF;

                                            font-size: 15px;

                                            font-weight: 700;

                                            overflow: TextOverflow.elide;

                                            horizontal-alignment: left;

                                        }

                                    }

                                    // Next line: 13px, #64748B, font-weight 600

                                    Text {

                                        text: root.lyrics-line-next;

                                        color: #64748B;

                                        font-size: 13px;

                                        font-weight: 600;

                                        overflow: TextOverflow.elide;

                                        horizontal-alignment: left;

                                    }

                                }

                                if !root.lyrics-available: VerticalLayout {

                                    alignment: center;

                                    spacing: 4px;

                                    Text {

                                        text: root.lyrics-line-curr;

                                        color: #64748B;

                                        font-size: 13px;

                                        font-weight: 600;

                                        horizontal-alignment: center;

                                    }

                                }

                            }

                        }

                    }

                    // --- Focus page (Sprint 5) --------------------------------
                    if root.active-page == 1: VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        // Session label + completed counter.
                        HorizontalLayout {
                            height: 18px;
                            spacing: 8px;

                            Text {
                                text: root.focus-session;
                                color: root.focus-celebrate ? #00F0FF : #E5E7EB;
                                font-size: 9.5px;
                                font-weight: 700;
                                letter-spacing: 0.6px;
                                vertical-alignment: center;
                                animate color {
                                    duration: 220ms;
                                    easing: ease-out;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }

                            Text {
                                text: "\{root.focus-completed} done today";
                                color: #6B7280;
                                font-size: 8.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            height: 88px;
                            spacing: 12px;

                            // Countdown ring.
                            Rectangle {
                                width: 88px;
                                height: 88px;
                                background: transparent;

                                Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 88;
                                    viewbox-height: 88;
                                    fill: transparent;
                                    stroke: #1F2937;
                                    stroke-width: 6px;
                                    MoveTo { x: 44; y: 7; }
                                    ArcTo {
                                        radius-x: 37;
                                        radius-y: 37;
                                        large-arc: false;
                                        sweep: true;
                                        x: 44;
                                        y: 81;
                                    }
                                    ArcTo {
                                        radius-x: 37;
                                        radius-y: 37;
                                        large-arc: false;
                                        sweep: true;
                                        x: 44;
                                        y: 7;
                                    }
                                }

                                if root.focus-progress > 0.002 && root.focus-progress < 0.999: progress-arc := Path {
                                    private property <float> arc-deg: root.focus-progress * 360;
                                    private property <angle> arc-angle: (self.arc-deg - 90) * 1deg;
                                    private property <float> arc-x: 44 + 37 * Math.cos(self.arc-angle);
                                    private property <float> arc-y: 44 + 37 * Math.sin(self.arc-angle);
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 88;
                                    viewbox-height: 88;
                                    fill: transparent;
                                    stroke: root.focus-celebrate ? #10B981 : #00F0FF;
                                    stroke-width: 6px;
                                    stroke-line-cap: round;
                                    MoveTo { x: 44; y: 7; }
                                    ArcTo {
                                        radius-x: 37;
                                        radius-y: 37;
                                        large-arc: progress-arc.arc-deg > 180;
                                        sweep: true;
                                        x: progress-arc.arc-x;
                                        y: progress-arc.arc-y;
                                    }
                                }

                                if root.focus-progress >= 0.999: Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 88;
                                    viewbox-height: 88;
                                    fill: transparent;
                                    stroke: #00F0FF;
                                    stroke-width: 6px;
                                    MoveTo { x: 44; y: 7; }
                                    ArcTo {
                                        radius-x: 37;
                                        radius-y: 37;
                                        large-arc: false;
                                        sweep: true;
                                        x: 44;
                                        y: 81;
                                    }
                                    ArcTo {
                                        radius-x: 37;
                                        radius-y: 37;
                                        large-arc: false;
                                        sweep: true;
                                        x: 44;
                                        y: 7;
                                    }
                                }

                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.focus-remaining;
                                    color: #FFFFFF;
                                    font-size: 21px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 7px;

                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 6px;

                                    Rectangle {
                                        width: 92px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: root.focus-running ? #1F2937 : #00F0FF;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: root.focus-running ? "Pause" : "Start";
                                            color: root.focus-running ? #E5E7EB : #041014;
                                            font-size: 10px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.focus-toggle();
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 62px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: #1F2937;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "Reset";
                                            color: #9CA3AF;
                                            font-size: 10px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.focus-reset();
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: #16161A;
                                        border-width: 1px;
                                        border-color: #FFFFFF12;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "-5";
                                            color: #9CA3AF;
                                            font-size: 8px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.focus-adjust(-5);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: #16161A;
                                        border-width: 1px;
                                        border-color: #FFFFFF12;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "+5";
                                            color: #9CA3AF;
                                            font-size: 8px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.focus-adjust(5);
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 4px;

                                    for preset in root.focus-presets: Rectangle {
                                        width: 44px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: root.focus-minutes == preset ? #00F0FF1F : #FFFFFF08;
                                        border-width: 1px;
                                        border-color: root.focus-minutes == preset ? #00F0FF66 : #FFFFFF12;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "\{preset}m";
                                            color: root.focus-minutes == preset ? #00F0FF : #9CA3AF;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.focus-preset(preset);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // --- Water page (Sprint 5) --------------------------------
                    if root.active-page == 2: VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 6px;
                        spacing: 5px;

                        HorizontalLayout {
                            height: 18px;
                            spacing: 8px;

                            Text {
                                text: root.water-summary;
                                color: #E5E7EB;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }

                            Text {
                                text: root.water-percent;
                                color: #00F0FF;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            height: 88px;
                            spacing: 12px;

                            // Liquid tank with an animated surface.
                            Rectangle {
                                width: 188px;
                                height: 88px;
                                border-radius: 12px;
                                clip: true;
                                background: @linear-gradient(180deg, #0B1220 0%, #060B12 100%);
                                border-width: 1px;
                                border-color: #00F0FF22;

                                Rectangle {
                                    width: parent.width;
                                    height: root.water-progress * parent.height;
                                    y: parent.height - self.height;
                                    background: @linear-gradient(180deg, #00F0FF44 0%, #0284C766 55%, #0E7490AA 100%);
                                    animate height {
                                        duration: 320ms;
                                        easing: ease-out;
                                    }
                                }

                                // Two crests slide horizontally to fake a moving surface.
                                Rectangle {
                                    width: parent.width;
                                    height: root.water-progress * parent.height;
                                    y: parent.height - self.height;
                                    clip: true;
                                    background: transparent;

                                    Path {
                                        x: -root.water-phase * 94px;
                                        y: 0px;
                                        width: parent.width + 94px;
                                        height: 14px;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 188;
                                        viewbox-height: 14;
                                        fill: #00F0FF66;
                                        MoveTo { x: 0; y: 7; }
                                        CubicTo {
                                            control-1-x: 12;
                                            control-1-y: 0;
                                            control-2-x: 35;
                                            control-2-y: 14;
                                            x: 47;
                                            y: 7;
                                        }
                                        CubicTo {
                                            control-1-x: 59;
                                            control-1-y: 0;
                                            control-2-x: 82;
                                            control-2-y: 14;
                                            x: 94;
                                            y: 7;
                                        }
                                        CubicTo {
                                            control-1-x: 106;
                                            control-1-y: 0;
                                            control-2-x: 129;
                                            control-2-y: 14;
                                            x: 141;
                                            y: 7;
                                        }
                                        CubicTo {
                                            control-1-x: 153;
                                            control-1-y: 0;
                                            control-2-x: 176;
                                            control-2-y: 14;
                                            x: 188;
                                            y: 7;
                                        }
                                        LineTo { x: 188; y: 14; }
                                        LineTo { x: 0; y: 14; }
                                        Close {}
                                    }
                                }

                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.water-percent;
                                    color: #E0F7FF;
                                    font-size: 22px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 7px;

                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 6px;

                                    for amount in root.water-presets: Rectangle {
                                        width: 58px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: #0EA5E91F;
                                        border-width: 1px;
                                        border-color: #00F0FF33;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "+\{amount} ml";
                                            color: #7DD3FC;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.water-add(amount);
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 188px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: #FFFFFF08;
                                    border-width: 1px;
                                    border-color: #FFFFFF12;
                                    opacity: root.water-can-undo ? 1.0 : 0.35;

                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "Undo last glass";
                                        color: #9CA3AF;
                                        font-size: 9px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            if (root.water-can-undo) {
                                                root.water-undo();
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.water-nudge ? "Time for a glass of water" : "Goal \{root.water-goal} ml per day";
                                    color: root.water-nudge ? #38BDF8 : #4B5563;
                                    font-size: 8px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }


                    if root.active-page == 3: VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 6px;
                        spacing: 5px;

                        // Toolbar: item count + Clear capsule.
                        HorizontalLayout {
                            height: 20px;
                            spacing: 8px;

                            Text {
                                text: root.shelf-summary;
                                color: #6B7280;
                                font-size: 8.5px;
                                font-weight: 700;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                                overflow: TextOverflow.elide;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }

                            Rectangle {
                                width: 46px;
                                height: 20px;
                                border-radius: 10px;
                                background: #1F2937;
                                opacity: root.shelf-total > 0 ? 1.0 : 0.35;

                                Text {
                                    text: "Clear";
                                    color: #9CA3AF;
                                    font-size: 9px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => {
                                        if (root.shelf-total > 0) {
                                            root.shelf-clear();
                                        }
                                    }
                                }
                            }
                        }

                        // Carousel: < [items] >.
                        HorizontalLayout {
                            height: 96px;
                            spacing: 6px;

                            // Previous page.
                            Rectangle {
                                width: 28px;
                                height: parent.height;
                                background: transparent;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 14px;
                                    background: #262626;
                                    opacity: root.shelf-can-prev ? 1.0 : 0.35;

                                    Path {
                                        width: 7px;
                                        height: 11px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 7;
                                        viewbox-height: 11;
                                        fill: transparent;
                                        stroke: root.shelf-can-prev ? #E5E7EB : #4B5563;
                                        stroke-width: 1.6px;
                                        stroke-line-cap: round;
                                        MoveTo { x: 5.5; y: 1; }
                                        LineTo { x: 1.5; y: 5.5; }
                                        LineTo { x: 5.5; y: 10; }
                                    }

                                    TouchArea {
                                        clicked => {
                                            if (root.shelf-can-prev) {
                                                root.shelf-nav(-1);
                                            }
                                        }
                                    }
                                }
                            }

                            // Viewport: empty state or the visible carousel slice.
                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                background: transparent;

                                if root.shelf-total == 0: Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 10px;
                                    background: root.shelf-drag-active ? #00F0FF14 : #FFFFFF08;
                                    border-width: 1px;
                                    border-color: root.shelf-drag-active ? #00F0FF88 : #FFFFFF14;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Rectangle {
                                            height: 27px;
                                            background: transparent;

                                            Path {
                                                width: 34px;
                                                height: 27px;
                                                x: (parent.width - self.width) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 34;
                                                viewbox-height: 27;
                                                fill: transparent;
                                                stroke: root.shelf-drag-active ? #00F0FF : #4B5563;
                                                stroke-width: 1.6px;
                                                stroke-line-cap: round;
                                                MoveTo { x: 2; y: 6; }
                                                LineTo { x: 11; y: 6; }
                                                LineTo { x: 14; y: 9; }
                                                LineTo { x: 32; y: 9; }
                                                LineTo { x: 32; y: 25; }
                                                LineTo { x: 2; y: 25; }
                                                Close {}
                                            }
                                        }

                                        Text {
                                            text: root.shelf-drag-active ? "Release to add to Shelf" : "Drag files or folders here";
                                            color: root.shelf-drag-active ? #00F0FF : #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                        }

                                        Text {
                                            text: "Drop from Explorer · double-click to open";
                                            color: #4B5563;
                                            font-size: 8.5px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                if root.shelf-total > 0: HorizontalLayout {
                                    width: parent.width;
                                    height: 84px;
                                    y: (parent.height - self.height) / 2;
                                    alignment: center;
                                    spacing: 5px;

                                    for item in root.shelf-items: Rectangle {
                                        width: 88px;
                                        height: 84px;
                                        background: transparent;
                                        opacity: (item.missing ? 0.45 : 1.0) * root.shelf-fade;
                                        animate opacity {
                                            duration: 160ms;
                                            easing: ease-out;
                                        }

                                        // 54 px preview: real thumbnail, folder or file icon.
                                        Rectangle {
                                            width: 54px;
                                            height: 54px;
                                            x: (parent.width - self.width) / 2;
                                            y: 0px;
                                            border-radius: 11px;
                                            clip: true;
                                            background: @linear-gradient(135deg, #1F2937 0%, #0B0B0E 100%);

                                            if item.has-thumbnail: Image {
                                                width: parent.width;
                                                height: parent.height;
                                                source: item.thumbnail;
                                                image-fit: cover;
                                            }

                                            if !item.has-thumbnail && item.is-directory: Path {
                                                width: 32px;
                                                height: 26px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 32;
                                                viewbox-height: 26;
                                                fill: #FBBF24;
                                                stroke: transparent;
                                                MoveTo { x: 1; y: 5; }
                                                LineTo { x: 11; y: 5; }
                                                LineTo { x: 14; y: 8; }
                                                LineTo { x: 31; y: 8; }
                                                LineTo { x: 31; y: 25; }
                                                LineTo { x: 1; y: 25; }
                                                Close {}
                                            }

                                            if !item.has-thumbnail && !item.is-directory: Path {
                                                width: 24px;
                                                height: 30px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 24;
                                                viewbox-height: 30;
                                                fill: #60A5FA;
                                                stroke: transparent;
                                                MoveTo { x: 2; y: 1; }
                                                LineTo { x: 15; y: 1; }
                                                LineTo { x: 22; y: 8; }
                                                LineTo { x: 22; y: 29; }
                                                LineTo { x: 2; y: 29; }
                                                Close {}
                                            }

                                            if !item.has-thumbnail && !item.is-directory: Path {
                                                width: 7px;
                                                height: 7px;
                                                x: (parent.width + 4px) / 2;
                                                y: (parent.height - 24px) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 7;
                                                viewbox-height: 7;
                                                fill: #93C5FD;
                                                stroke: transparent;
                                                MoveTo { x: 0; y: 0; }
                                                LineTo { x: 7; y: 7; }
                                                LineTo { x: 0; y: 7; }
                                                Close {}
                                            }
                                        }

                                        Text {
                                            y: 58px;
                                            height: 12px;
                                            width: parent.width;
                                            text: item.name;
                                            color: #F9FAFB;
                                            font-size: 9.5px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            overflow: TextOverflow.elide;
                                        }

                                        Text {
                                            y: 70px;
                                            height: 12px;
                                            width: parent.width;
                                            text: item.size-text;
                                            color: item.missing ? #F87171 : #9CA3AF;
                                            font-size: 8px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        item-touch := TouchArea {
                                            double-clicked => {
                                                root.shelf-open(item.index);
                                            }
                                        }

                                        // Remove badge.
                                        Rectangle {
                                            x: 58px;
                                            y: 0px;
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 7px;
                                            background: #0B0B0EE6;
                                            border-width: 1px;
                                            border-color: #FFFFFF2E;
                                            opacity: item-touch.has-hover ? 1.0 : 0.55;
                                            animate opacity {
                                                duration: 120ms;
                                                easing: ease-out;
                                            }

                                            Text {
                                                text: "×";
                                                color: #E5E7EB;
                                                font-size: 10px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.shelf-remove(item.index);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Next page.
                            Rectangle {
                                width: 28px;
                                height: parent.height;
                                background: transparent;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 14px;
                                    background: #262626;
                                    opacity: root.shelf-can-next ? 1.0 : 0.35;

                                    Path {
                                        width: 7px;
                                        height: 11px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: 7;
                                        viewbox-height: 11;
                                        fill: transparent;
                                        stroke: root.shelf-can-next ? #E5E7EB : #4B5563;
                                        stroke-width: 1.6px;
                                        stroke-line-cap: round;
                                        MoveTo { x: 1.5; y: 1; }
                                        LineTo { x: 5.5; y: 5.5; }
                                        LineTo { x: 1.5; y: 10; }
                                    }

                                    TouchArea {
                                        clicked => {
                                            if (root.shelf-can-next) {
                                                root.shelf-nav(1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // --- To-do page (Sprint 5) --------------------------------
                    if root.active-page == 4: VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        // Counter + clear completed.
                        HorizontalLayout {
                            height: 18px;
                            spacing: 8px;

                            Text {
                                text: root.todo-summary;
                                color: #E5E7EB;
                                font-size: 9.5px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }

                            Rectangle {
                                width: 64px;
                                height: 18px;
                                border-radius: 9px;
                                background: #1F2937;
                                opacity: root.todo-done > 0 ? 1.0 : 0.35;

                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "Clear done";
                                    color: #9CA3AF;
                                    font-size: 8px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => {
                                        if (root.todo-done > 0) {
                                            root.todo-clear-done();
                                        }
                                    }
                                }
                            }
                        }

                        // Scrollable checklist.
                        Rectangle {
                            width: parent.width;
                            height: 88px;
                            clip: true;
                            background: transparent;

                            if root.todo-total == 0: Rectangle {
                                width: parent.width;
                                height: parent.height;
                                border-radius: 10px;
                                background: #FFFFFF05;
                                border-width: 1px;
                                border-color: #FFFFFF0F;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    Rectangle {
                                        height: 20px;
                                        background: transparent;

                                        Path {
                                            width: 18px;
                                            height: 18px;
                                            x: (parent.width - self.width) / 2;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 18;
                                            viewbox-height: 18;
                                            fill: transparent;
                                            stroke: #4B5563;
                                            stroke-width: 1.5px;
                                            stroke-line-cap: round;
                                            MoveTo { x: 9; y: 1.5; }
                                            ArcTo {
                                                radius-x: 7.5;
                                                radius-y: 7.5;
                                                large-arc: false;
                                                sweep: true;
                                                x: 9;
                                                y: 16.5;
                                            }
                                            ArcTo {
                                                radius-x: 7.5;
                                                radius-y: 7.5;
                                                large-arc: false;
                                                sweep: true;
                                                x: 9;
                                                y: 1.5;
                                            }
                                        }
                                    }

                                    Text {
                                        text: "No tasks yet";
                                        color: #9CA3AF;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "Type below and press Enter";
                                        color: #4B5563;
                                        font-size: 8px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if root.todo-total > 0: Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: parent.width;
                                content-height: root.todo-total * 24px;
                                interactive: false;

                                VerticalLayout {
                                    width: parent.width;
                                    height: root.todo-total * 24px;
                                    spacing: 0px;

                                    for item[i] in root.todo-items: Rectangle {
                                        width: parent.width;
                                        height: 24px;
                                        background: drag.pressed ? #FFFFFF0C : transparent;

                                        // Drag anywhere on the row to reorder.
                                        drag := TouchArea {
                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.up) {
                                                    root.todo-reorder(i, (self.mouse-y - self.pressed-y) / 1px);
                                                    return EventResult.accept;
                                                }
                                                return EventResult.reject;
                                            }
                                        }

                                        // Circular checkbox.
                                        Rectangle {
                                            x: 0px;
                                            y: (parent.height - self.height) / 2;
                                            width: 15px;
                                            height: 15px;
                                            border-radius: 7.5px;
                                            border-width: 1.5px;
                                            border-color: item.completed ? #10B981 : #4B5563;
                                            background: item.completed ? #10B981 : transparent;

                                            if item.completed: Path {
                                                width: 8px;
                                                height: 6px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 8;
                                                viewbox-height: 6;
                                                fill: transparent;
                                                stroke: #041014;
                                                stroke-width: 1.6px;
                                                stroke-line-cap: round;
                                                MoveTo { x: 1; y: 3; }
                                                LineTo { x: 3; y: 5; }
                                                LineTo { x: 7; y: 1; }
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.todo-toggle(item.id);
                                                }
                                            }
                                        }

                                        name := Text {
                                            x: 24px;
                                            width: parent.width - 54px;
                                            height: parent.height;
                                            text: item.text;
                                            color: item.completed ? #6B7280 : #E5E7EB;
                                            font-size: 10px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                            overflow: TextOverflow.elide;

                                            animate color {
                                                duration: 180ms;
                                                easing: ease-out;
                                            }
                                        }

                                        if item.completed: Rectangle {
                                            x: 24px;
                                            y: (parent.height - self.height) / 2;
                                            width: min(name.preferred-width, name.width);
                                            height: 1px;
                                            background: #6B7280;
                                        }

                                        // Delete task.
                                        Rectangle {
                                            x: parent.width - 20px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: #FFFFFF08;
                                            opacity: 0.6;

                                            Text {
                                                width: parent.width;
                                                height: parent.height;
                                                text: "×";
                                                color: #9CA3AF;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.todo-remove(item.id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Inline quick add.
                        Rectangle {
                            width: parent.width;
                            height: 26px;
                            border-radius: 13px;
                            background: root.todo-edit-active ? #00F0FF12 : #FFFFFF08;
                            border-width: 1px;
                            border-color: root.todo-edit-active ? #00F0FF55 : #FFFFFF12;

                            animate border-color {
                                duration: 160ms;
                                easing: ease-out;
                            }

                            Text {
                                x: 12px;
                                width: 12px;
                                height: parent.height;
                                text: "+";
                                color: #00F0FF;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            todo-input := TextInput {
                                x: 28px;
                                width: parent.width - 72px;
                                height: parent.height;
                                text <=> root.todo-draft;
                                single-line: true;
                                font-size: 10px;
                                color: #E5E7EB;
                                vertical-alignment: center;
                                changed has-focus => {
                                    root.todo-edit(todo-input.has-focus);
                                }
                                accepted => {
                                    if (todo-input.text != "") {
                                        root.todo-add(todo-input.text);
                                        root.todo-draft = "";
                                    }
                                }
                            }

                            if root.todo-draft == "" && !todo-input.has-focus: Text {
                                x: 28px;
                                width: parent.width - 72px;
                                height: parent.height;
                                text: "Add a task...";
                                color: #6B7280;
                                font-size: 10px;
                                vertical-alignment: center;
                            }

                            Text {
                                x: parent.width - 40px;
                                width: 28px;
                                height: parent.height;
                                text: "Enter";
                                color: #4B5563;
                                font-size: 8px;
                                font-weight: 600;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Pagination: active capsule + four dim dots.
                HorizontalLayout {
                    height: 10px;
                    alignment: center;
                    spacing: 2px;

                    for page in root.page-count: Rectangle {
                        width: 20px;
                        height: 10px;
                        background: transparent;

                        Rectangle {
                            width: root.active-page == page ? 22px : 4px;
                            height: 4px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - 4px) / 2;
                            border-radius: 2px;
                            background: root.active-page == page ? #FFFFFF : #4B5563;
                            animate width {
                                duration: 180ms;
                                easing: ease-out;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.page-selected(page);
                            }
                        }
                    }
                }
            }
        }

        // --- Hardware HUD (Sprint 6) --------------------------------------
        if root.hud-visible: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            Rectangle {
                x: 18px;
                y: parent.height - 16px;
                width: parent.width - 36px;
                height: 16px;
                background: @radial-gradient(circle, #00F0FF55 0%, transparent 84%);
                opacity: root.hud-device ? 1.0 : 0.0;
            }
            Rectangle {
                x: 18px;
                y: parent.height - 16px;
                width: parent.width - 36px;
                height: 16px;
                background: @radial-gradient(circle, #34D39955 0%, transparent 84%);
                opacity: root.hud-device ? 0.0 : 1.0;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 11px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: root.hud-device ? #00F0FF14 : #34D39914;
                    border-width: 1px;
                    border-color: root.hud-device ? #00F0FF38 : #34D39938;

                    if root.hud-device: Rectangle {
                        width: 26px;
                        height: 26px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: transparent;

                        Path {
                            width: 26px;
                            height: 26px;
                            viewbox-width: 26;
                            viewbox-height: 26;
                            stroke: #00F0FF;
                            stroke-width: 2.2px;
                            fill: transparent;

                            MoveTo {
                                x: 4;
                                y: 15;
                            }
                            LineTo {
                                x: 4;
                                y: 12;
                            }
                            ArcTo {
                                radius-x: 9;
                                radius-y: 9;
                                sweep: true;
                                x: 22;
                                y: 12;
                            }
                            LineTo {
                                x: 22;
                                y: 15;
                            }
                        }

                        Rectangle {
                            x: 2px;
                            y: 14px;
                            width: 6px;
                            height: 9px;
                            border-radius: 3px;
                            background: #00F0FF;
                        }
                        Rectangle {
                            x: 18px;
                            y: 14px;
                            width: 6px;
                            height: 9px;
                            border-radius: 3px;
                            background: #00F0FF;
                        }
                    }

                    if !root.hud-device: Rectangle {
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: transparent;

                        Path {
                            width: 24px;
                            height: 24px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            fill: #FACC15;

                            MoveTo {
                                x: 13;
                                y: 1;
                            }
                            LineTo {
                                x: 4;
                                y: 14;
                            }
                            LineTo {
                                x: 10;
                                y: 14;
                            }
                            LineTo {
                                x: 8;
                                y: 23;
                            }
                            LineTo {
                                x: 20;
                                y: 9;
                            }
                            LineTo {
                                x: 13;
                                y: 9;
                            }
                            Close {}
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: root.hud-title;
                        color: #FFFFFF;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: TextOverflow.elide;
                    }

                    HorizontalLayout {
                        spacing: 5px;

                        Rectangle {
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: root.hud-device ? (root.hud-connected ? #34D399 : #F59E0B) : #34D399;
                        }

                        Text {
                            text: root.hud-status;
                            color: root.hud-device ? (root.hud-connected ? #34D399 : #F59E0B) : #34D399;
                            font-size: 9.5px;
                            font-weight: 600;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                if root.hud-device: HorizontalLayout {
                    spacing: 3px;
                    alignment: center;

                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-0 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-1 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-2 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-3 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                    Rectangle {
                        width: 3px;
                        height: 26px;
                        background: transparent;
                        Rectangle {
                            width: 3px;
                            height: 5px + root.wave-4 * 19px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: #00F0FF;
                        }
                    }
                }

                if !root.hud-device: Text {
                    text: root.hud-percent-text;
                    color: #34D399;
                    font-size: 20px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }
        }
    }
}
