// Kripton — Native Windows living notch
// UI shell for PRD v2.0. Sprint 0 establishes geometry, page navigation and
// the top-attached silhouette; feature pages land in later sprints.

export component AppWindow inherits Window {
    title: "Kripton";
    width: 600px;
    height: 220px;
    background: transparent;
    no-frame: true;

    default-font-family: "Segoe UI Variable Display";
    default-font-size: 12px;

    // --- Driven by Rust -----------------------------------------------------
    in property <length> notch-width: 190px;
    in property <length> notch-height: 38px;
    in property <bool> expanded: false;
    in property <int> active-page: 0;
    in property <string> page-title: "Music";
    in property <string> page-subtitle: "";
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> build-label: "v1.0.0";
    in property <bool> lyrics-enabled: false;
    in property <image> mascot: @image-url("../assets/plasma_core.png");

    callback toggle-expand();
    callback page-selected(int);
    callback quit();

    // --- Design tokens ------------------------------------------------------
    private property <length> ear-radius: 12px;
    private property <length> bottom-radius: 18px;
    private property <duration> morph-duration: 340ms;
    private property <duration> breath-duration: 2000ms;
    private property <length> idle-orb-size: 44px;
    private property <bool> breathing: false;
    private property <int> page-count: 5;

    Timer {
        interval: root.breath-duration;
        running: true;
        triggered => {
            root.breathing = !root.breathing;
        }
    }

    // 1. Silhouette: top-attached notch with inverse concave ear fillets and
    //    G1-smooth bottom corners. Coordinates follow the animated notch rect,
    //    so the outline never lags behind the content during a morph.
    Path {
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        fill: #000000;

        MoveTo {
            x: (notch.x - root.ear-radius) / 1px;
            y: 0;
        }
        LineTo {
            x: (notch.x + notch.width + root.ear-radius) / 1px;
            y: 0;
        }
        ArcTo {
            radius-x: root.ear-radius / 1px;
            radius-y: root.ear-radius / 1px;
            sweep: true;
            x: (notch.x + notch.width) / 1px;
            y: root.ear-radius / 1px;
        }
        LineTo {
            x: (notch.x + notch.width) / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: true;
            x: (notch.x + notch.width - root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        LineTo {
            x: (notch.x + root.bottom-radius) / 1px;
            y: notch.height / 1px;
        }
        ArcTo {
            radius-x: root.bottom-radius / 1px;
            radius-y: root.bottom-radius / 1px;
            sweep: true;
            x: notch.x / 1px;
            y: (notch.height - root.bottom-radius) / 1px;
        }
        LineTo {
            x: notch.x / 1px;
            y: root.ear-radius / 1px;
        }
        ArcTo {
            radius-x: root.ear-radius / 1px;
            radius-y: root.ear-radius / 1px;
            sweep: true;
            x: (notch.x - root.ear-radius) / 1px;
            y: 0;
        }
        Close {}
    }

    // 2. Notch surface and content.
    notch := Rectangle {
        x: (root.width - self.width) / 2;
        y: 0;
        width: root.notch-width;
        height: root.notch-height;
        background: transparent;
        clip: true;

        // Slight underdamped spring: cubic-bezier(ζ≈0.72) overshoot.
        animate width {
            duration: root.morph-duration;
            easing: cubic-bezier(0.34, 1.22, 0.64, 1);
        }
        animate height {
            duration: root.morph-duration;
            easing: cubic-bezier(0.34, 1.22, 0.64, 1);
        }

        // Bottom ambient ionized glow shared by idle and expanded modes. It stays
        // inset from the rounded bottom corners so it never bleeds outside the
        // silhouette (Slint clipping is rectangular).
        Rectangle {
            x: 26px;
            y: parent.height - 20px;
            width: parent.width - 52px;
            height: 18px;
            background: @radial-gradient(circle, #4F46E5AA 0%, #7C3AED55 42%, transparent 82%);
            opacity: 0.45;
        }

        // Whole-notch interaction layer. It sits below the expanded view so the
        // pagination dots (and later feature controls) receive clicks first.
        TouchArea {
            clicked => {
                root.toggle-expand();
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    root.quit();
                }
            }
        }

        // --- Idle: the Ionized Plasma Core ---------------------------------
        if !root.expanded: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            Rectangle {
                width: 84px;
                height: 34px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + 3px;
                background: @radial-gradient(circle, #00F0FF33 0%, #7C3AED1F 55%, transparent 100%);
            }

            Image {
                source: root.mascot;
                width: root.idle-orb-size + (root.breathing ? 4px : 0px);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + 1px;
                image-fit: contain;
                animate width {
                    duration: root.breath-duration;
                    easing: ease-in-out;
                }
            }
        }

        // --- Expanded shell ------------------------------------------------
        if root.expanded: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 9px;
            padding-bottom: 8px;
            spacing: 6px;

            // Header: mascot, page identity, date & clock.
            HorizontalLayout {
                height: 32px;
                spacing: 9px;

                Image {
                    width: 32px;
                    height: 32px;
                    source: root.mascot;
                    image-fit: contain;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 0px;

                    Text {
                        text: root.page-title;
                        color: #FFFFFF;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.page-subtitle;
                        color: #9CA3AF;
                        font-size: 10px;
                        font-weight: 400;
                        overflow: TextOverflow.elide;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 0px;

                    Text {
                        text: root.date-text;
                        color: #9CA3AF;
                        font-size: 9.5px;
                        horizontal-alignment: right;
                    }
                    Text {
                        text: root.clock-text;
                        color: #FFFFFF;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: right;
                    }
                }
            }

            // Page placeholder card.
            Rectangle {
                vertical-stretch: 1;
                background: @linear-gradient(145deg, #101014 0%, #08080B 100%);
                border-radius: 12px;
                border-width: 1px;
                border-color: #FFFFFF12;
                clip: true;

                Image {
                    width: 132px;
                    height: 132px;
                    x: parent.width - 96px;
                    y: -40px;
                    source: root.mascot;
                    image-fit: contain;
                    opacity: 0.22;
                }

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 3px;
                    alignment: center;

                    Text {
                        text: "SPRINT 0 · FOUNDATION";
                        color: #6B7280;
                        font-size: 8.5px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                    }
                    Text {
                        text: root.page-subtitle;
                        color: #F9FAFB;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: TextOverflow.elide;
                        max-width: parent.width;
                    }
                    Text {
                        text: root.build-label;
                        color: #4B5563;
                        font-size: 9px;
                        overflow: TextOverflow.elide;
                        max-width: parent.width;
                    }
                }
            }

            // Pagination: active capsule + four dim dots.
            HorizontalLayout {
                height: 12px;
                alignment: center;
                spacing: 2px;

                for page in root.page-count: Rectangle {
                    width: 20px;
                    height: 12px;
                    background: transparent;

                    Rectangle {
                        width: root.active-page == page ? 18px : 4px;
                        height: 4px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - 4px) / 2;
                        border-radius: 2px;
                        background: root.active-page == page ? #FFFFFF : #4B5563;
                        animate width {
                            duration: 180ms;
                            easing: ease-out;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.page-selected(page);
                        }
                    }
                }
            }
        }
    }
}
