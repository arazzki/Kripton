// Kripton — Uniform vector Path icons for the glassmorphism UI.

import { Theme } from "./theme.slint";

export component IconMusic inherits Rectangle {
    in property <color> tint: Theme.ink;
    background: transparent;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 18;
        viewbox-height: 18;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        animate stroke { duration: 160ms; easing: ease-out; }

        MoveTo { x: 6; y: 14; }
        LineTo { x: 6; y: 4; }
        LineTo { x: 13; y: 2.5; }
        LineTo { x: 13; y: 12; }
        MoveTo { x: 4; y: 14; }
        ArcTo { radius-x: 2; radius-y: 2; sweep: true; x: 8; y: 14; }
        ArcTo { radius-x: 2; radius-y: 2; sweep: true; x: 4; y: 14; }
        MoveTo { x: 11; y: 12; }
        ArcTo { radius-x: 2; radius-y: 2; sweep: true; x: 15; y: 12; }
        ArcTo { radius-x: 2; radius-y: 2; sweep: true; x: 11; y: 12; }
    }
}

