export component IconHeadphones inherits Rectangle {
    in property <color> tint: Theme.ink;
    background: transparent;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2.0px;
        stroke-line-cap: round;
        stroke-line-join: round;
        animate stroke { duration: 160ms; easing: ease-out; }

        MoveTo { x: 4.2; y: 14.0; }
        LineTo { x: 4.2; y: 11.8; }
        ArcTo { radius-x: 7.8; radius-y: 7.8; sweep: true; x: 19.8; y: 11.8; }
        LineTo { x: 19.8; y: 14.0; }
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        stroke: transparent;
        animate fill { duration: 160ms; easing: ease-out; }

        // Left earcup
        MoveTo { x: 4.0; y: 12.6; }
        LineTo { x: 4.4; y: 12.6; }
        ArcTo { radius-x: 1.8; radius-y: 1.8; sweep: true; x: 6.2; y: 14.4; }
        LineTo { x: 6.2; y: 18.2; }
        ArcTo { radius-x: 1.8; radius-y: 1.8; sweep: true; x: 4.4; y: 20.0; }
        LineTo { x: 4.0; y: 20.0; }
        ArcTo { radius-x: 1.8; radius-y: 1.8; sweep: true; x: 2.2; y: 18.2; }
        LineTo { x: 2.2; y: 14.4; }
        ArcTo { radius-x: 1.8; radius-y: 1.8; sweep: true; x: 4.0; y: 12.6; }
        Close {}

        // Right earcup
        MoveTo { x: 19.6; y: 12.6; }
        LineTo { x: 20.0; y: 12.6; }
        ArcTo { radius-x: 1.8; radius-y: 1.8; sweep: true; x: 21.8; y: 14.4; }
        LineTo { x: 21.8; y: 18.2; }
        ArcTo { radius-x: 1.8; radius-y: 1.8; sweep: true; x: 20.0; y: 20.0; }
        LineTo { x: 19.6; y: 20.0; }
        ArcTo { radius-x: 1.8; radius-y: 1.8; sweep: true; x: 17.8; y: 18.2; }
        LineTo { x: 17.8; y: 14.4; }
        ArcTo { radius-x: 1.8; radius-y: 1.8; sweep: true; x: 19.6; y: 12.6; }
        Close {}
    }
}

